<%- include('../layouts/header', { title: 'Sign In' }) %>

<div class="min-h-screen grid grid-cols-1 lg:grid-cols-12 bg-[#0a0b0c]">
  <!-- Left Form Panel -->
  <div class="lg:col-span-5 flex flex-col justify-between p-8 sm:p-12 lg:p-16 z-20">
    <div>
      <a href="/" class="inline-flex items-center gap-3 mb-12 group">
        <img src="/images/logo.svg" alt="KineticGP Logo" class="h-8 w-auto transition-transform group-hover:scale-105">
        <span class="text-xl font-bold text-white tracking-tight">Kinetic<span class="text-[#1873d3]">GP</span></span>
      </a>

      <div class="mb-8">
        <h1 class="text-3xl font-bold text-white tracking-tight">Sign in</h1>
        <p class="text-sm text-neutral-400 mt-2">Enter your credentials to access your Minecraft server panel</p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-6 px-4 py-3 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 text-sm font-medium">
          <% if (error === 'missing_fields') { %>Please provide both username/email and password.
          <% } else if (error === 'invalid_credentials') { %>Invalid username, email, or password.
          <% } else if (error === 'unauthorized') { %>Please sign in to access the dashboard.
          <% } else { %>An authentication error occurred. Please try again.<% } %>
        </div>
      <% } %>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="mb-6 px-4 py-3 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-sm font-medium">
          <% if (success === 'logged_out') { %>You have been successfully logged out.<% } %>
        </div>
      <% } %>

      <form action="/login" method="POST" class="space-y-5">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div>
          <label for="identifier" class="block text-xs font-semibold uppercase tracking-wider text-neutral-300 mb-2">Username or Email</label>
          <input id="identifier" name="identifier" type="text" required placeholder="admin or you@example.com" class="w-full px-4 py-3 rounded-xl bg-[#1a1c1e] border border-white/10 text-white placeholder-neutral-500 text-sm focus:border-[#1873d3] focus:ring-1 focus:ring-[#1873d3] transition">
        </div>

        <div>
          <div class="flex items-center justify-between mb-2">
            <label for="password" class="block text-xs font-semibold uppercase tracking-wider text-neutral-300">Password</label>
          </div>
          <div class="relative">
            <input id="password" name="password" type="password" required placeholder="••••••••" class="w-full px-4 py-3 pr-11 rounded-xl bg-[#1a1c1e] border border-white/10 text-white placeholder-neutral-500 text-sm focus:border-[#1873d3] focus:ring-1 focus:ring-[#1873d3] transition">
            <button type="button" id="pwToggle" class="absolute right-3 top-1/2 -translate-y-1/2 text-neutral-400 hover:text-white p-1" aria-label="Toggle password visibility">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
            </button>
          </div>
        </div>

        <div class="flex items-center justify-between pt-1">
          <label class="flex items-center gap-2 cursor-pointer select-none">
            <input type="checkbox" name="remember" class="w-4 h-4 rounded bg-[#1a1c1e] border-white/10 text-[#1873d3] focus:ring-[#1873d3]">
            <span class="text-sm text-neutral-400">Remember me</span>
          </label>
        </div>

        <button type="submit" class="w-full btn-kinetic py-3 text-base justify-center mt-4">
          <span>Sign In</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/></svg>
        </button>
      </form>

      <p class="text-sm text-center text-neutral-400 mt-8">
        Don't have an account? 
        <a href="/register" class="text-[#1873d3] font-semibold hover:underline">Register account</a>
      </p>
    </div>

    <div class="pt-8 text-xs text-neutral-500">
      &copy; 2026 KineticGP Panel. All rights reserved.
    </div>
  </div>

  <!-- Right Split Image Panel -->
  <div class="hidden lg:block lg:col-span-7 relative overflow-hidden" style="background: url('/images/bgs/auth-bg.png') center/cover no-repeat;">
    <div class="absolute inset-0 bg-gradient-to-t from-[#101213] via-[#101213]/40 to-transparent"></div>
    <div class="absolute bottom-16 left-16 right-16 z-10 space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1873d3]/30 border border-[#1873d3]/50 text-white text-xs font-semibold uppercase">
        <span>High Performance Infrastructure</span>
      </div>
      <h2 class="text-3xl font-extrabold text-white">Full Minecraft Server Control</h2>
      <p class="text-neutral-300 text-sm max-w-lg leading-relaxed">
        Monitor real-time RAM, CPU, and disk metrics, initiate instant restarts, and manage your world backups effortlessly.
      </p>
    </div>
  </div>
</div>

<%- include('../layouts/footer', { script: 'auth' }) %>
