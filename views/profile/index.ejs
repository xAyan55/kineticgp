<%- include('../layouts/header', { title: 'Profile Settings' }) %>

<div class="min-h-screen bg-[#0D1117] flex flex-col lg:flex-row">
  <!-- Sidebar Component -->
  <%- include('../components/sidebar') %>

  <!-- Main Content Area -->
  <main class="flex-1 lg:pl-60 pt-14 lg:pt-0 pb-20 lg:pb-10 min-h-screen flex flex-col">
    <!-- Top Bar Header -->
    <header class="h-14 px-6 lg:px-8 border-b border-[#30363D] flex items-center justify-between bg-[#0D1117]/90 sticky top-0 z-20">
      <div class="flex items-center gap-2 text-xs sm:text-sm text-[#8B949E]">
        <a href="/dashboard" class="hover:text-white transition">Panel</a>
        <span>/</span>
        <span class="text-[#2F81F7] font-medium">Profile Settings</span>
      </div>

      <a href="/dashboard" class="btn-secondary text-xs py-1.5 px-3">
        Back to Dashboard
      </a>
    </header>

    <div class="p-6 lg:p-10 max-w-[1400px] w-full mx-auto space-y-8 flex-1">

      <!-- PROFILE HEADER BANNER -->
      <div class="kgp-card overflow-hidden p-0 relative">
        <div class="h-44 sm:h-56 w-full bg-cover bg-center relative" style="background-image: url('<%= user.banner %>');">
          <div class="absolute inset-0 bg-gradient-to-t from-[#161B22] via-transparent to-black/30"></div>
        </div>

        <div class="px-6 sm:px-10 pb-8 pt-0 relative flex flex-col sm:flex-row items-start sm:items-end justify-between gap-6 -mt-16 sm:-mt-20">
          <div class="flex flex-col sm:flex-row items-start sm:items-end gap-6">
            <img id="currentAvatarPreview" src="<%= user.avatar %>" alt="User avatar" class="w-24 h-24 sm:w-32 sm:h-32 rounded-3xl border-4 border-[#161B22] object-cover shadow-soft-2xl bg-[#21262D]">
            <div class="mb-2">
              <h1 class="text-2xl sm:text-3xl font-extrabold text-white"><%= user.username %></h1>
              <p class="text-[#8B949E] text-sm"><%= user.email %></p>
            </div>
          </div>

          <div class="mb-2 flex items-center gap-2">
            <span class="px-3 py-1 rounded-full bg-[#2F81F7]/20 border border-[#2F81F7]/40 text-[#2F81F7] text-xs font-semibold uppercase">
              Administrator
            </span>
          </div>
        </div>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="px-4 py-3 rounded-xl bg-[#F85149]/10 border border-[#F85149]/30 text-[#F85149] text-sm font-medium">
          <% if (error === 'invalid_username') { %>Username must be at least 3 characters.
          <% } else if (error === 'username_taken') { %>That username is already taken.
          <% } else if (error === 'wrong_current_password') { %>Incorrect current password.
          <% } else if (error === 'short_password') { %>New password must be at least 6 characters.
          <% } else if (error === 'password_mismatch') { %>New passwords do not match.
          <% } else { %>Update failed. Please check your inputs.<% } %>
        </div>
      <% } %>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="px-4 py-3 rounded-xl bg-[#3FB950]/10 border border-[#3FB950]/30 text-[#3FB950] text-sm font-medium">
          <% if (success === 'username_updated') { %>Username updated successfully!
          <% } else if (success === 'password_updated') { %>Password changed successfully!
          <% } else if (success === 'avatar_updated') { %>Profile avatar updated successfully!<% } %>
        </div>
      <% } %>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <!-- LEFT COLUMN: AVATAR & ACCOUNT INFORMATION -->
        <div class="lg:col-span-5 space-y-8">
          
          <!-- AVATAR SELECTION CARD -->
          <div class="kgp-card p-6 space-y-6">
            <div>
              <h2 class="text-lg font-bold text-white">Avatar Selection</h2>
              <p class="text-xs text-[#8B949E] mt-1">Choose between Minecraft Steve, Alex, or a custom avatar URL.</p>
            </div>

            <form action="/dashboard/profile/update-avatar" method="POST" class="space-y-6">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" id="selectedAvatarInput" name="avatar" value="<%= user.avatar %>">

              <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-[#8B949E] mb-3">Default Minecraft Avatars</label>
                <div class="grid grid-cols-2 gap-4">
                  <!-- Steve Avatar Button -->
                  <button type="button" class="avatar-option-btn flex flex-col items-center gap-2 p-4 rounded-xl bg-[#21262D] border border-[#30363D] hover:border-[#2F81F7] transition text-center group <%= user.avatar === '/images/banners/big-steve-face.png' ? 'border-[#2F81F7] ring-2 ring-[#2F81F7]' : '' %>" data-avatar-url="/images/banners/big-steve-face.png">
                    <img src="/images/banners/big-steve-face.png" alt="Steve Face" class="w-14 h-14 rounded-xl object-cover group-hover:scale-105 transition">
                    <span class="text-xs font-semibold text-white">Steve</span>
                  </button>

                  <!-- Alex Avatar Button -->
                  <button type="button" class="avatar-option-btn flex flex-col items-center gap-2 p-4 rounded-xl bg-[#21262D] border border-[#30363D] hover:border-[#2F81F7] transition text-center group <%= user.avatar === '/images/banners/big-alex-face.png' ? 'border-[#2F81F7] ring-2 ring-[#2F81F7]' : '' %>" data-avatar-url="/images/banners/big-alex-face.png">
                    <img src="/images/banners/big-alex-face.png" alt="Alex Face" class="w-14 h-14 rounded-xl object-cover group-hover:scale-105 transition">
                    <span class="text-xs font-semibold text-white">Alex</span>
                  </button>
                </div>
              </div>

              <button type="submit" class="w-full btn-kinetic py-2.5 text-sm justify-center">
                Save Avatar
              </button>
            </form>
          </div>

          <!-- ACCOUNT INFO CARD -->
          <div class="kgp-card p-6 space-y-4">
            <h2 class="text-lg font-bold text-white border-b border-[#30363D] pb-3">Account Details</h2>
            <div class="space-y-3 text-xs">
              <div class="flex justify-between py-1 border-b border-[#30363D]">
                <span class="text-[#8B949E]">Account ID:</span>
                <span class="font-mono text-white font-semibold">#<%= user.id %></span>
              </div>
              <div class="flex justify-between py-1 border-b border-[#30363D]">
                <span class="text-[#8B949E]">Email Address:</span>
                <span class="text-[#8B949E] font-medium"><%= user.email %></span>
              </div>
              <div class="flex justify-between py-1 border-b border-[#30363D]">
                <span class="text-[#8B949E]">Role & Privileges:</span>
                <span class="text-[#3FB950] font-semibold uppercase">Administrator</span>
              </div>
              <div class="flex justify-between py-1">
                <span class="text-[#8B949E]">Account Created:</span>
                <span class="text-[#8B949E] font-medium"><%= user.created_at %></span>
              </div>
            </div>
          </div>

        </div>

        <!-- RIGHT COLUMN: USERNAME & PASSWORD EDIT FORMS -->
        <div class="lg:col-span-7 space-y-8">
          
          <!-- EDIT USERNAME -->
          <div class="kgp-card p-6 sm:p-8 space-y-6">
            <div>
              <h2 class="text-xl font-bold text-white">Edit Username</h2>
              <p class="text-xs text-[#8B949E] mt-1">Update your display username used across the panel and activity logs.</p>
            </div>

            <form action="/dashboard/profile/update-username" method="POST" class="space-y-4">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">

              <div>
                <label for="username" class="block text-xs font-semibold uppercase tracking-wider text-[#8B949E] mb-1.5">New Username</label>
                <input id="username" name="username" type="text" value="<%= user.username %>" required class="w-full px-4 py-2.5 rounded-xl bg-[#21262D] border border-[#30363D] text-white text-sm focus:border-[#2F81F7] focus:ring-1 focus:ring-[#2F81F7] transition">
              </div>

              <div class="pt-2 flex justify-end">
                <button type="submit" class="btn-kinetic text-sm py-2.5 px-6">
                  Update Username
                </button>
              </div>
            </form>
          </div>

          <!-- CHANGE PASSWORD -->
          <div class="kgp-card p-6 sm:p-8 space-y-6">
            <div>
              <h2 class="text-xl font-bold text-white">Security & Password</h2>
              <p class="text-xs text-[#8B949E] mt-1">Ensure your account uses a strong, unique password.</p>
            </div>

            <form action="/dashboard/profile/update-password" method="POST" class="space-y-4">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">

              <div>
                <label for="current_password" class="block text-xs font-semibold uppercase tracking-wider text-[#8B949E] mb-1.5">Current Password</label>
                <input id="current_password" name="current_password" type="password" required placeholder="••••••••" class="w-full px-4 py-2.5 rounded-xl bg-[#21262D] border border-[#30363D] text-white text-sm focus:border-[#2F81F7] focus:ring-1 focus:ring-[#2F81F7] transition">
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="new_password" class="block text-xs font-semibold uppercase tracking-wider text-[#8B949E] mb-1.5">New Password</label>
                  <input id="new_password" name="new_password" type="password" required placeholder="••••••••" class="w-full px-4 py-2.5 rounded-xl bg-[#21262D] border border-[#30363D] text-white text-sm focus:border-[#2F81F7] focus:ring-1 focus:ring-[#2F81F7] transition">
                </div>

                <div>
                  <label for="confirm_password" class="block text-xs font-semibold uppercase tracking-wider text-[#8B949E] mb-1.5">Confirm New Password</label>
                  <input id="confirm_password" name="confirm_password" type="password" required placeholder="••••••••" class="w-full px-4 py-2.5 rounded-xl bg-[#21262D] border border-[#30363D] text-white text-sm focus:border-[#2F81F7] focus:ring-1 focus:ring-[#2F81F7] transition">
                </div>
              </div>

              <div class="pt-2 flex justify-end">
                <button type="submit" class="btn-kinetic text-sm py-2.5 px-6">
                  Change Password
                </button>
              </div>
            </form>
          </div>

        </div>

      </div>

    </div>
  </main>
</div>

<%- include('../layouts/footer', { script: 'profile' }) %>
