<%- include('../layouts/header', { title: 'Audit Logs' }) %>

<div class="min-h-screen bg-[#101213] flex flex-col lg:flex-row">
  <%- include('../components/sidebar') %>

  <main class="flex-1 lg:pl-56 pt-16 lg:pt-0 pb-20 lg:pb-10 min-h-screen flex flex-col">
    <!-- Top Bar / Breadcrumb Navigation -->
    <header class="h-16 px-6 lg:px-10 border-b border-white/5 flex items-center justify-between bg-[#101213]/80 backdrop-blur-xl sticky top-0 z-20">
      <div class="flex items-center gap-2 text-sm text-neutral-400">
        <span class="text-white font-medium">Administration</span>
        <span>/</span>
        <span class="text-[#1873d3] font-medium">Audit Logs</span>
      </div>
      <div class="flex items-center gap-3">
        <span class="px-3 py-1 rounded-full bg-neutral-800 text-neutral-400 text-xs font-mono font-semibold border border-neutral-700">
          Immutable System Log
        </span>
      </div>
    </header>

    <div class="p-6 lg:p-10 max-w-[1400px] w-full mx-auto space-y-8 flex-1">
      <!-- HEADER TITLE -->
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white">Security & System Audit Logs</h1>
        <p class="text-neutral-400 text-sm mt-1">Full immutable ledger recording logins, administrative actions, settings changes, user creations, and server commands.</p>
      </div>

      <!-- SEARCH & FILTERS TOOLBAR -->
      <form method="GET" action="/admin/logs" class="kgp-card p-4 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="relative flex-1 w-full">
          <svg class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input type="text" name="search" value="<%= search %>" placeholder="Search by user, action, details, or IP address..." class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-[#101213] border border-white/5 text-sm text-white focus:outline-none focus:border-[#1873d3] transition">
        </div>

        <div class="flex items-center gap-3 w-full sm:w-auto">
          <select name="action" onchange="this.form.submit()" class="px-3.5 py-2.5 rounded-xl bg-[#101213] border border-white/5 text-xs text-white focus:outline-none focus:border-[#1873d3]">
            <option value="">All Action Types</option>
            <% distinctActions.forEach(function(act) { %>
              <option value="<%= act %>" <%= actionFilter === act ? 'selected' : '' %>><%= act %></option>
            <% }); %>
          </select>

          <button type="submit" class="btn-secondary text-xs px-4 py-2.5">Filter</button>
        </div>
      </form>

      <!-- AUDIT LOGS TABLE -->
      <div class="kgp-card overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm text-neutral-300">
            <thead class="bg-[#101213] border-b border-white/5 text-xs uppercase tracking-wider text-neutral-400 font-semibold">
              <tr>
                <th class="px-6 py-4">Timestamp</th>
                <th class="px-6 py-4">User</th>
                <th class="px-6 py-4">Action</th>
                <th class="px-6 py-4">IP Address</th>
                <th class="px-6 py-4">Details</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              <% if (logs.length === 0) { %>
                <tr>
                  <td colspan="5" class="px-6 py-8 text-center text-neutral-500 text-sm">No audit logs matching your filter criteria.</td>
                </tr>
              <% } else { %>
                <% logs.forEach(function(log) { %>
                  <tr class="hover:bg-white/[0.02] transition">
                    <td class="px-6 py-4 text-xs font-mono text-neutral-400 flex-shrink-0 whitespace-nowrap">
                      <%= log.created_at %>
                    </td>
                    <td class="px-6 py-4 font-bold text-white whitespace-nowrap">
                      <%= log.username %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <span class="px-2.5 py-1 rounded-md text-[11px] font-bold uppercase tracking-wider bg-[#1873d3]/10 text-[#1873d3] border border-[#1873d3]/30">
                        <%= log.action %>
                      </span>
                    </td>
                    <td class="px-6 py-4 text-xs font-mono text-neutral-400 whitespace-nowrap">
                      <%= log.ip_address %>
                    </td>
                    <td class="px-6 py-4 text-xs text-neutral-300">
                      <%= log.details %>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- PAGINATION -->
        <% if (totalPages > 1) { %>
          <div class="px-6 py-4 border-t border-white/5 flex items-center justify-between text-xs text-neutral-400 bg-[#101213]">
            <span>Page <%= page %> of <%= totalPages %> (<%= totalCount %> total log entries)</span>
            <div class="flex items-center gap-2">
              <% if (page > 1) { %>
                <a href="/admin/logs?page=<%= page - 1 %>&search=<%= search %>&action=<%= actionFilter %>" class="btn-secondary py-1.5 px-3">Previous</a>
              <% } %>
              <% if (page < totalPages) { %>
                <a href="/admin/logs?page=<%= page + 1 %>&search=<%= search %>&action=<%= actionFilter %>" class="btn-secondary py-1.5 px-3">Next</a>
              <% } %>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </main>
</div>

<%- include('../layouts/footer', { script: null }) %>
