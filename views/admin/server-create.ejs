<%- include('../layouts/header', { title: 'Create Minecraft Server' }) %>

<div class="min-h-screen bg-[#0a0b0c] flex flex-col lg:flex-row">
  <%- include('../components/sidebar') %>

  <main class="flex-1 lg:pl-60 pt-14 lg:pt-0 pb-20 lg:pb-10 min-h-screen flex flex-col">
    <!-- Top Bar / Breadcrumb Navigation -->
    <header class="h-14 px-6 lg:px-8 border-b border-white/5 flex items-center justify-between bg-[#0a0b0c]/90 sticky top-0 z-20">
      <div class="flex items-center gap-2 text-xs sm:text-sm text-neutral-400">
        <span class="text-white font-medium">Administration</span>
        <span>/</span>
        <a href="/admin/servers" class="text-neutral-400 hover:text-white">Servers</a>
        <span>/</span>
        <span class="text-[#1873d3] font-medium">Create Instance</span>
      </div>

      <div class="flex items-center gap-3">
        <a href="/admin/servers" class="btn-secondary text-xs">Back to Servers</a>
      </div>
    </header>

    <div class="p-6 lg:p-10 max-w-[1400px] w-full mx-auto space-y-8 flex-1">
      <!-- ALERT MESSAGES -->
      <% if (typeof err !== 'undefined' && err) { %>
        <div class="p-4 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 text-sm flex items-center justify-between">
          <span><%= err %></span>
          <button onclick="this.parentElement.remove()" class="text-red-400 hover:text-white">&times;</button>
        </div>
      <% } %>

      <!-- PAGE TITLE -->
      <div class="flex items-center justify-between border-b border-white/5 pb-6">
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-white">Provision Minecraft Server</h1>
          <p class="text-neutral-400 text-sm mt-1">Configure quotas, Java runtime, and software engine for a new high-performance instance.</p>
        </div>
      </div>

      <!-- MAIN CREATION FORM -->
      <form method="POST" action="/admin/servers/create" onsubmit="const btn = document.getElementById('createSubmitBtn'); btn.innerText = 'Creating Server...'; btn.disabled = true;" class="space-y-8">
        <input type="hidden" name="_csrf" value="<%= _csrf %>">

        <!-- CARD 1: GENERAL INFORMATION -->
        <div class="kgp-card p-6 sm:p-8 space-y-6">
          <div class="flex items-center justify-between border-b border-white/5 pb-4">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-xl bg-[#1873d3]/10 border border-[#1873d3]/30 text-[#1873d3] flex items-center justify-center font-bold">1</div>
              <div>
                <h3 class="text-lg font-bold text-white">General Information</h3>
                <p class="text-xs text-neutral-400">Basic server identification and ownership credentials.</p>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs">
            <div>
              <label class="block font-semibold text-neutral-300 mb-1.5">Server Name <span class="text-red-400">*</span></label>
              <input type="text" name="name" required placeholder="e.g. Survival SMP Cluster" class="w-full px-4 py-3 rounded-xl bg-[#101213] border border-white/5 text-sm text-white focus:outline-none focus:border-[#1873d3] transition">
              <p class="text-[11px] text-neutral-500 mt-1">Descriptive name displayed in the panel and server listings.</p>
            </div>

            <div>
              <label class="block font-semibold text-neutral-300 mb-1.5">Owner Account <span class="text-red-400">*</span></label>
              <select name="owner_id" required class="w-full px-4 py-3 rounded-xl bg-[#101213] border border-white/5 text-sm text-white focus:outline-none focus:border-[#1873d3] transition">
                <% allUsers.forEach(function(u) { %>
                  <option value="<%= u.id %>" <%= u.id === user.id ? 'selected' : '' %>><%= u.username %> (<%= u.email %>)</option>
                <% }); %>
              </select>
              <p class="text-[11px] text-neutral-500 mt-1">User account granted full ownership and console access.</p>
            </div>

            <div class="md:col-span-2">
              <label class="block font-semibold text-neutral-300 mb-1.5">Server Description</label>
              <input type="text" name="description" placeholder="Short description of this server instance..." class="w-full px-4 py-3 rounded-xl bg-[#101213] border border-white/5 text-sm text-white focus:outline-none focus:border-[#1873d3] transition">
            </div>
          </div>
        </div>

        <!-- CARD 2: MINECRAFT CONFIGURATION -->
        <div class="kgp-card p-6 sm:p-8 space-y-6">
          <div class="flex items-center justify-between border-b border-white/5 pb-4">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-xl bg-purple-500/10 border border-purple-500/30 text-purple-400 flex items-center justify-center font-bold">2</div>
              <div>
                <h3 class="text-lg font-bold text-white">Engine & Minecraft Software</h3>
                <p class="text-xs text-neutral-400">Select server software type, Minecraft version, and Java environment.</p>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs">
            <div>
              <label class="block font-semibold text-neutral-300 mb-1.5">Software Engine</label>
              <select id="softwareSelect" name="software" class="w-full px-4 py-3 rounded-xl bg-[#101213] border border-white/5 text-sm text-white focus:outline-none focus:border-[#1873d3] transition">
                <optgroup label="Server Software">
                  <option value="Paper" selected>Paper (High Performance & Plugins)</option>
                  <option value="Purpur">Purpur (Optimized Paper Fork)</option>
                  <option value="Spigot">Spigot (Classic Bukkit Fork)</option>
                  <option value="Folia">Folia (Multithreaded Paper Fork)</option>
                  <option value="Vanilla">Vanilla (Official Mojang Server)</option>
                  <option value="Pufferfish">Pufferfish (Performance Fork)</option>
                  <option value="Leaves">Leaves (Vanilla-Faithful Paper)</option>
                  <option value="Canvas">Canvas (Performance Folia Fork)</option>
                </optgroup>
                <optgroup label="Modded Software">
                  <option value="Fabric">Fabric (Lightweight Mod Loader)</option>
                  <option value="Forge">Forge (Classic Mod Platform)</option>
                  <option value="NeoForge">NeoForge (Modern Forge Successor)</option>
                  <option value="Quilt">Quilt (Community Mod Toolchain)</option>
                  <option value="Mohist">Mohist (Forge + Spigot Plugins)</option>
                  <option value="Arclight">Arclight (Bukkit + Mixin Modding)</option>
                  <option value="Sponge">Sponge (Modding Platform)</option>
                </optgroup>
                <optgroup label="Proxy Software">
                  <option value="Velocity">Velocity (Modern Proxy)</option>
                  <option value="BungeeCord">BungeeCord (Classic Proxy)</option>
                  <option value="Waterfall">Waterfall (Deprecated Proxy)</option>
                </optgroup>
              </select>
            </div>

            <div>
              <label class="block font-semibold text-neutral-300 mb-1.5">Minecraft Version</label>
              <input type="text" id="versionInput" name="version" list="versionSuggestions" autocomplete="off" placeholder="Loading versions..." required
                class="w-full px-4 py-3 rounded-xl bg-[#101213] border border-white/5 text-sm text-white focus:outline-none focus:border-[#1873d3] transition">
              <datalist id="versionSuggestions"></datalist>
              <p id="versionHint" class="text-[11px] text-neutral-500 mt-1">Type or select a Minecraft version (e.g. 1.21.4)</p>
            </div>

            <div>
              <label class="block font-semibold text-neutral-300 mb-1.5">Java Runtime Environment</label>
              <select id="javaSelect" name="java_version" class="w-full px-4 py-3 rounded-xl bg-[#101213] border border-white/5 text-sm text-white focus:outline-none focus:border-[#1873d3] transition">
                <option value="21" selected>OpenJDK 21 (LTS - Recommended)</option>
                <option value="17">OpenJDK 17 (LTS)</option>
                <option value="16">OpenJDK 16</option>
                <option value="8">OpenJDK 8 (Legacy)</option>
              </select>
            </div>
          </div>
        </div>

        <!-- CARD 3: RESOURCE ALLOCATION -->
        <div class="kgp-card p-6 sm:p-8 space-y-6">
          <div class="flex items-center justify-between border-b border-white/5 pb-4">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 flex items-center justify-center font-bold">3</div>
              <div>
                <h3 class="text-lg font-bold text-white">Resource Allocation</h3>
                <p class="text-xs text-neutral-400">Set maximum RAM, CPU core percentages, and disk quotas.</p>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs">
            <div>
              <label class="block font-semibold text-neutral-300 mb-1.5">RAM Memory Limit (MB)</label>
              <input type="number" name="ram_limit" value="2048" required step="512" min="512" class="w-full px-4 py-3 rounded-xl bg-[#101213] border border-white/5 text-sm text-white focus:outline-none focus:border-[#1873d3] transition">
              <p class="text-[11px] text-neutral-500 mt-1">2048 MB = 2 GB. Max JVM heap size (`-Xmx`).</p>
            </div>

            <div>
              <label class="block font-semibold text-neutral-300 mb-1.5">CPU Limit (%)</label>
              <input type="number" name="cpu_limit" value="100" required step="50" min="50" class="w-full px-4 py-3 rounded-xl bg-[#101213] border border-white/5 text-sm text-white focus:outline-none focus:border-[#1873d3] transition">
              <p class="text-[11px] text-neutral-500 mt-1">100% = 1 full CPU core thread limit.</p>
            </div>

            <div>
              <label class="block font-semibold text-neutral-300 mb-1.5">Disk Space Limit (GB)</label>
              <input type="number" name="disk_limit" value="10" required step="1" min="1" class="w-full px-4 py-3 rounded-xl bg-[#101213] border border-white/5 text-sm text-white focus:outline-none focus:border-[#1873d3] transition">
              <p class="text-[11px] text-neutral-500 mt-1">Storage quota for worlds, logs, and plugins.</p>
            </div>
          </div>
        </div>

        <!-- CARD 4: NODE INFORMATION -->
        <div class="kgp-card p-6 sm:p-8 space-y-4">
          <div class="flex items-center justify-between border-b border-white/5 pb-4">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-xl bg-blue-500/10 border border-blue-500/30 text-blue-400 flex items-center justify-center font-bold">4</div>
              <div>
                <h3 class="text-lg font-bold text-white">Target Node Location</h3>
                <p class="text-xs text-neutral-400">Primary server execution host.</p>
              </div>
            </div>
            <span class="px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-semibold flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              Local Node Active
            </span>
          </div>

          <div class="p-4 rounded-xl bg-[#101213] border border-white/5 flex items-center justify-between text-xs">
            <div class="space-y-1">
              <p class="font-bold text-white text-sm">Local Node (Primary Engine)</p>
              <p class="text-neutral-400 font-mono text-[11px]">IP: 127.0.0.1 &bull; System Process Direct Execution</p>
            </div>
            <span class="text-neutral-400 font-mono">Port Allocation: Auto-assigned (25565+)</span>
          </div>
        </div>

        <!-- CARD 5: ADVANCED OPTIONS & STARTUP SCRIPT -->
        <div class="kgp-card p-6 sm:p-8 space-y-4">
          <div class="flex items-center justify-between border-b border-white/5 pb-4">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-400 flex items-center justify-center font-bold">5</div>
              <div>
                <h3 class="text-lg font-bold text-white">Startup Command Preview</h3>
                <p class="text-xs text-neutral-400">Automated Java execution line with heap limits.</p>
              </div>
            </div>
          </div>

          <div class="p-4 rounded-xl bg-[#0a0b0c] border border-white/5 font-mono text-xs text-emerald-400">
            java -Xms128M -Xmx{ram}M -Dfile.encoding=UTF-8 -jar server.jar --nogui
          </div>
        </div>

        <!-- SUBMIT ACTION BAR -->
        <div class="flex items-center justify-between pt-4 border-t border-white/5">
          <a href="/admin/servers" class="btn-secondary text-xs">Cancel</a>
          <button type="submit" id="createSubmitBtn" class="btn-primary text-sm px-8 py-3.5 flex items-center gap-2 shadow-soft-md">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            Create Server & Begin Provisioning
          </button>
        </div>
      </form>
    </div>
  </main>
</div>

<%- include('../layouts/footer', { script: null }) %>

<script>
(function() {
  const softwareSelect = document.getElementById('softwareSelect');
  const versionInput = document.getElementById('versionInput');
  const versionSuggestions = document.getElementById('versionSuggestions');
  const versionHint = document.getElementById('versionHint');
  const javaSelect = document.getElementById('javaSelect');

  let cachedVersions = {};
  let currentVersions = [];

  async function loadVersions(software) {
    versionInput.placeholder = 'Loading versions...';
    versionInput.value = '';
    versionSuggestions.innerHTML = '';

    if (cachedVersions[software]) {
      applyVersions(cachedVersions[software]);
      return;
    }

    try {
      const res = await fetch('/admin/servers/api/versions/' + encodeURIComponent(software));
      const data = await res.json();
      if (data.success && data.versions.length > 0) {
        cachedVersions[software] = data.versions;
        applyVersions(data.versions);
      } else {
        versionInput.placeholder = 'Type a version (e.g. 1.21.4)';
        versionHint.textContent = 'No versions found from MCJars. You can still type any version.';
        currentVersions = [];
      }
    } catch (e) {
      versionInput.placeholder = 'Type a version (e.g. 1.21.4)';
      versionHint.textContent = 'Could not reach MCJars API. Type any valid version.';
      currentVersions = [];
    }
  }

  function applyVersions(versions) {
    currentVersions = versions;
    versionSuggestions.innerHTML = '';

    versions.forEach(function(v) {
      const opt = document.createElement('option');
      const label = v.supported ? ' (Supported)' : '';
      opt.value = v.id;
      opt.textContent = v.id + label + ' — Java ' + v.java;
      versionSuggestions.appendChild(opt);
    });

    // Auto-fill with the latest supported release
    const latestSupported = versions.find(function(v) { return v.supported; }) || versions[0];
    if (latestSupported) {
      versionInput.value = latestSupported.id;
      versionInput.placeholder = 'Type a version (e.g. ' + latestSupported.id + ')';
      updateJava(latestSupported.java);
      versionHint.textContent = versions.length + ' versions available. Latest supported: ' + latestSupported.id;
    }
  }

  function updateJava(javaVersion) {
    if (!javaVersion) return;
    const val = String(javaVersion);
    for (let i = 0; i < javaSelect.options.length; i++) {
      if (javaSelect.options[i].value === val) {
        javaSelect.value = val;
        return;
      }
    }
    // If not in list, select the highest available
    javaSelect.value = '21';
  }

  // When user types or selects a version, update Java recommendation
  versionInput.addEventListener('input', function() {
    const typed = versionInput.value.trim();
    const match = currentVersions.find(function(v) { return v.id === typed; });
    if (match) {
      updateJava(match.java);
      versionHint.textContent = match.id + ' — ' + (match.supported ? 'Supported' : 'Unsupported') + ' — Requires Java ' + match.java;
    }
  });

  versionInput.addEventListener('change', function() {
    const typed = versionInput.value.trim();
    const match = currentVersions.find(function(v) { return v.id === typed; });
    if (match) {
      updateJava(match.java);
      versionHint.textContent = match.id + ' — ' + (match.supported ? 'Supported' : 'Unsupported') + ' — Requires Java ' + match.java;
    }
  });

  softwareSelect.addEventListener('change', function() {
    loadVersions(softwareSelect.value);
  });

  // Initial load
  loadVersions(softwareSelect.value);
})();
</script>
