<%- include('../layouts/header', { title: 'Local Node Management' }) %>

<div class="min-h-screen bg-[#101213] flex flex-col lg:flex-row">
  <%- include('../components/sidebar') %>

  <main class="flex-1 lg:pl-56 pt-16 lg:pt-0 pb-20 lg:pb-10 min-h-screen flex flex-col">
    <!-- Top Bar / Breadcrumb Navigation -->
    <header class="h-16 px-6 lg:px-10 border-b border-white/5 flex items-center justify-between bg-[#101213]/80 backdrop-blur-xl sticky top-0 z-20">
      <div class="flex items-center gap-2 text-sm text-neutral-400">
        <span class="text-white font-medium">Administration</span>
        <span>/</span>
        <span class="text-[#1873d3] font-medium">Nodes</span>
      </div>
      <div class="flex items-center gap-3">
        <span class="px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Local Node Active</span>
        </span>
      </div>
    </header>

    <div class="p-6 lg:p-10 max-w-[1400px] w-full mx-auto space-y-8 flex-1">
      <!-- HEADER TITLE -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-white">Local Node Management</h1>
          <p class="text-neutral-400 text-sm mt-1">Real-time hardware telemetry and environment detection for the local machine running KineticGP.</p>
        </div>
        <div class="px-4 py-2 rounded-xl bg-[#1a1c1e] border border-white/5 text-xs text-neutral-400">
          Single Node Architecture (Local Engine)
        </div>
      </div>

      <!-- MAIN LOCAL NODE TELEMETRY CARD -->
      <div class="kgp-card p-6 sm:p-8 space-y-8">
        <div class="flex items-center justify-between border-b border-white/5 pb-6">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-[#1873d3]/10 border border-[#1873d3]/30 flex items-center justify-center text-[#1873d3]">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2"/></svg>
            </div>
            <div>
              <h2 class="text-xl font-extrabold text-white flex items-center gap-3">
                <%= node.name %>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">ONLINE</span>
              </h2>
              <p class="text-xs text-neutral-400 mt-0.5 font-mono">Hostname: <%= node.hostname %> &bull; IP: <%= node.ip_address %></p>
            </div>
          </div>
          <div class="text-right">
            <span class="text-xs text-neutral-500 block">Machine Uptime</span>
            <span class="text-sm font-bold text-white font-mono"><%= node.uptime %></span>
          </div>
        </div>

        <!-- LIVE TELEMETRY GAUGES -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- CPU Gauge -->
          <div class="p-5 rounded-2xl bg-[#101213] border border-white/5 space-y-3">
            <div class="flex items-center justify-between text-xs">
              <span class="text-neutral-400 font-semibold uppercase tracking-wider">CPU Processor Load</span>
              <span class="text-white font-bold text-sm"><%= node.cpu_usage %>%</span>
            </div>
            <div class="w-full h-3 rounded-full bg-neutral-800 overflow-hidden">
              <div class="h-full bg-[#1873d3] rounded-full transition-all duration-500" style="width: <%= node.cpu_usage %>%"></div>
            </div>
            <p class="text-[11px] text-neutral-500 font-mono truncate"><%= node.cpu_model %> (<%= node.cpu_cores %> Cores)</p>
          </div>

          <!-- Memory Gauge -->
          <div class="p-5 rounded-2xl bg-[#101213] border border-white/5 space-y-3">
            <div class="flex items-center justify-between text-xs">
              <span class="text-neutral-400 font-semibold uppercase tracking-wider">Memory (RAM) Usage</span>
              <span class="text-white font-bold text-sm"><%= (node.memory_usage / 1024).toFixed(1) %> / <%= (node.memory_total / 1024).toFixed(1) %> GB</span>
            </div>
            <div class="w-full h-3 rounded-full bg-neutral-800 overflow-hidden">
              <div class="h-full bg-emerald-400 rounded-full transition-all duration-500" style="width: <%= Math.round((node.memory_usage / node.memory_total) * 100) %>%"></div>
            </div>
            <p class="text-[11px] text-neutral-500 font-mono">Free Memory: <%= ((node.memory_total - node.memory_usage) / 1024).toFixed(1) %> GB</p>
          </div>

          <!-- Disk Gauge -->
          <div class="p-5 rounded-2xl bg-[#101213] border border-white/5 space-y-3">
            <div class="flex items-center justify-between text-xs">
              <span class="text-neutral-400 font-semibold uppercase tracking-wider">Disk Storage</span>
              <span class="text-white font-bold text-sm"><%= node.disk_usage.toFixed(1) %> / <%= node.disk_total.toFixed(0) %> GB</span>
            </div>
            <div class="w-full h-3 rounded-full bg-neutral-800 overflow-hidden">
              <div class="h-full bg-purple-400 rounded-full transition-all duration-500" style="width: <%= Math.round((node.disk_usage / node.disk_total) * 100) %>%"></div>
            </div>
            <p class="text-[11px] text-neutral-500 font-mono">Free Disk: <%= (node.disk_total - node.disk_usage).toFixed(1) %> GB</p>
          </div>
        </div>

        <!-- DETAILED ENVIRONMENT TABLE -->
        <div class="space-y-4">
          <h3 class="text-base font-bold text-white tracking-tight">System & Runtime Environment</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
            <div class="p-4 rounded-xl bg-[#101213] border border-white/5 space-y-1">
              <span class="text-neutral-500 uppercase tracking-wider font-semibold block text-[10px]">Operating System</span>
              <span class="text-white font-medium block truncate"><%= node.os_type %></span>
            </div>

            <div class="p-4 rounded-xl bg-[#101213] border border-white/5 space-y-1">
              <span class="text-neutral-500 uppercase tracking-wider font-semibold block text-[10px]">Kernel Release</span>
              <span class="text-white font-medium block font-mono truncate"><%= node.kernel %></span>
            </div>

            <div class="p-4 rounded-xl bg-[#101213] border border-white/5 space-y-1">
              <span class="text-neutral-500 uppercase tracking-wider font-semibold block text-[10px]">System Architecture</span>
              <span class="text-white font-medium block font-mono uppercase"><%= node.arch %></span>
            </div>

            <div class="p-4 rounded-xl bg-[#101213] border border-white/5 space-y-1">
              <span class="text-neutral-500 uppercase tracking-wider font-semibold block text-[10px]">Java Runtime Engine</span>
              <span class="text-emerald-400 font-medium block font-mono truncate"><%= node.java_version %></span>
            </div>

            <div class="p-4 rounded-xl bg-[#101213] border border-white/5 space-y-1">
              <span class="text-neutral-500 uppercase tracking-wider font-semibold block text-[10px]">PM2 Process Manager</span>
              <span class="text-[#1873d3] font-medium block font-mono truncate"><%= node.pm2_status %></span>
            </div>

            <div class="p-4 rounded-xl bg-[#101213] border border-white/5 space-y-1">
              <span class="text-neutral-500 uppercase tracking-wider font-semibold block text-[10px]">Panel Daemon Status</span>
              <span class="text-emerald-400 font-medium block uppercase tracking-wider font-bold">ONLINE &bull; READY</span>
            </div>

            <div class="p-4 rounded-xl bg-[#101213] border border-white/5 space-y-1">
              <span class="text-neutral-500 uppercase tracking-wider font-semibold block text-[10px]">Node Mode</span>
              <span class="text-purple-400 font-medium block font-mono">Local Primary Engine</span>
            </div>

            <div class="p-4 rounded-xl bg-[#101213] border border-white/5 space-y-1">
              <span class="text-neutral-500 uppercase tracking-wider font-semibold block text-[10px]">Remote Expansion</span>
              <span class="text-neutral-400 font-medium block">Future Ready (Modular)</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>

<%- include('../layouts/footer', { script: null }) %>
