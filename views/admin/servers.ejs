<%- include('../layouts/header', { title: 'Server Management' }) %>

<div class="min-h-screen bg-[#101213] flex flex-col lg:flex-row">
  <%- include('../components/sidebar') %>

  <main class="flex-1 lg:pl-56 pt-16 lg:pt-0 pb-20 lg:pb-10 min-h-screen flex flex-col">
    <!-- Top Bar / Breadcrumb Navigation -->
    <header class="h-16 px-6 lg:px-10 border-b border-white/5 flex items-center justify-between bg-[#101213]/80 backdrop-blur-xl sticky top-0 z-20">
      <div class="flex items-center gap-2 text-sm text-neutral-400">
        <span class="text-white font-medium">Administration</span>
        <span>/</span>
        <span class="text-[#1873d3] font-medium">Servers</span>
      </div>
      <div class="flex items-center gap-3">
        <button onclick="openModal('createServerModal')" class="btn-primary text-xs flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          Create Server
        </button>
      </div>
    </header>

    <div class="p-6 lg:p-10 max-w-[1400px] w-full mx-auto space-y-8 flex-1">
      <!-- ALERT MESSAGES -->
      <% if (typeof msg !== 'undefined' && msg) { %>
        <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-sm flex items-center justify-between">
          <span>Action completed successfully! Server initialized.</span>
          <button onclick="this.parentElement.remove()" class="text-emerald-400 hover:text-white">&times;</button>
        </div>
      <% } %>

      <% if (typeof err !== 'undefined' && err) { %>
        <div class="p-4 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 text-sm flex items-center justify-between">
          <span><%= err %></span>
          <button onclick="this.parentElement.remove()" class="text-red-400 hover:text-white">&times;</button>
        </div>
      <% } %>

      <!-- HEADER TITLE -->
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-white">Registered Minecraft Servers</h1>
          <p class="text-neutral-400 text-sm mt-1">Manage every server instance across all users on the primary local node engine.</p>
        </div>
      </div>

      <!-- SEARCH & FILTERS TOOLBAR -->
      <form method="GET" action="/admin/servers" class="kgp-card p-4 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="relative flex-1 w-full">
          <svg class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input type="text" name="search" value="<%= search %>" placeholder="Search servers by name, UUID, or owner..." class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-[#101213] border border-white/5 text-sm text-white focus:outline-none focus:border-[#1873d3] transition">
        </div>

        <div class="flex items-center gap-3 w-full sm:w-auto">
          <select name="software" onchange="this.form.submit()" class="px-3.5 py-2.5 rounded-xl bg-[#101213] border border-white/5 text-xs text-white focus:outline-none focus:border-[#1873d3]">
            <option value="">All Software</option>
            <option value="Paper" <%= softwareFilter === 'Paper' ? 'selected' : '' %>>Paper</option>
            <option value="Purpur" <%= softwareFilter === 'Purpur' ? 'selected' : '' %>>Purpur</option>
            <option value="Vanilla" <%= softwareFilter === 'Vanilla' ? 'selected' : '' %>>Vanilla</option>
            <option value="Fabric" <%= softwareFilter === 'Fabric' ? 'selected' : '' %>>Fabric</option>
            <option value="Forge" <%= softwareFilter === 'Forge' ? 'selected' : '' %>>Forge</option>
          </select>

          <select name="status" onchange="this.form.submit()" class="px-3.5 py-2.5 rounded-xl bg-[#101213] border border-white/5 text-xs text-white focus:outline-none focus:border-[#1873d3]">
            <option value="">All Statuses</option>
            <option value="online" <%= statusFilter === 'online' ? 'selected' : '' %>>Online</option>
            <option value="offline" <%= statusFilter === 'offline' ? 'selected' : '' %>>Offline</option>
          </select>

          <select name="sort" onchange="this.form.submit()" class="px-3.5 py-2.5 rounded-xl bg-[#101213] border border-white/5 text-xs text-white focus:outline-none focus:border-[#1873d3]">
            <option value="">Sort By ID</option>
            <option value="owner" <%= sort === 'owner' ? 'selected' : '' %>>Sort by Owner</option>
            <option value="status" <%= sort === 'status' ? 'selected' : '' %>>Sort by Status</option>
            <option value="version" <%= sort === 'version' ? 'selected' : '' %>>Sort by Version</option>
          </select>

          <button type="submit" class="btn-secondary text-xs px-4 py-2.5">Filter</button>
        </div>
      </form>

      <!-- SERVERS TABLE -->
      <div class="kgp-card overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm text-neutral-300">
            <thead class="bg-[#101213] border-b border-white/5 text-xs uppercase tracking-wider text-neutral-400 font-semibold">
              <tr>
                <th class="px-6 py-4">Server</th>
                <th class="px-6 py-4">Owner</th>
                <th class="px-6 py-4">Engine / Version</th>
                <th class="px-6 py-4">Resources</th>
                <th class="px-6 py-4">Status</th>
                <th class="px-6 py-4 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              <% if (servers.length === 0) { %>
                <tr>
                  <td colspan="6" class="px-6 py-8 text-center text-neutral-500 text-sm">No Minecraft servers registered yet. Click "Create Server" above to provision one.</td>
                </tr>
              <% } else { %>
                <% servers.forEach(function(s) { %>
                  <tr class="hover:bg-white/[0.02] transition">
                    <td class="px-6 py-4">
                      <div>
                        <a href="/dashboard/server/<%= s.uuid %>/console" class="font-bold text-white hover:text-[#1873d3] leading-tight flex items-center gap-2">
                          <%= s.name %>
                          <% if (s.suspended === 1) { %>
                            <span class="text-[10px] px-2 py-0.5 rounded-full bg-red-500/10 text-red-400 border border-red-500/30 font-semibold">SUSPENDED</span>
                          <% } %>
                        </a>
                        <p class="text-xs text-neutral-400 font-mono mt-0.5">UUID: <%= s.uuid %> &bull; Port: <%= s.port %></p>
                      </div>
                    </td>
                    <td class="px-6 py-4 font-semibold text-white">
                      <%= s.owner_name || 'Unknown' %>
                    </td>
                    <td class="px-6 py-4">
                      <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-[#1873d3]/10 text-[#1873d3] border border-[#1873d3]/30">
                        <%= s.software %> <%= s.version %>
                      </span>
                    </td>
                    <td class="px-6 py-4 text-xs font-mono">
                      <span><%= (s.ram_limit / 1024).toFixed(1) %> GB RAM</span>
                      <span class="text-neutral-500 mx-1">&bull;</span>
                      <span><%= s.disk_limit %> GB Disk</span>
                    </td>
                    <td class="px-6 py-4">
                      <span class="px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider <%= s.status === 'online' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/30' : 'bg-neutral-800 text-neutral-400 border border-neutral-700' %>">
                        <%= s.status %>
                      </span>
                    </td>
                    <td class="px-6 py-4 text-right">
                      <div class="flex items-center justify-end gap-2">
                        <!-- Manage Button -->
                        <a href="/dashboard/server/<%= s.uuid %>/console" title="Open Console" class="p-2 rounded-lg bg-[#1873d3]/10 hover:bg-[#1873d3]/20 text-[#1873d3] transition">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                        </a>

                        <!-- Reown Modal Button -->
                        <button onclick="openReownModal('<%= s.id %>', '<%= s.name %>', '<%= s.user_id %>')" title="Change Owner" class="p-2 rounded-lg bg-purple-500/10 hover:bg-purple-500/20 text-purple-400 transition">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                        </button>

                        <!-- Suspend Form -->
                        <form method="POST" action="/admin/servers/<%= s.id %>/suspend" class="inline">
                          <input type="hidden" name="_csrf" value="<%= _csrf %>">
                          <button type="submit" title="<%= s.suspended === 1 ? 'Unsuspend Server' : 'Suspend Server' %>" class="p-2 rounded-lg <%= s.suspended === 1 ? 'bg-emerald-500/10 text-emerald-400' : 'bg-amber-500/10 text-amber-400' %> transition">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
                          </button>
                        </form>

                        <!-- Delete Form -->
                        <form method="POST" action="/admin/servers/<%= s.id %>/delete" onsubmit="return confirm('Delete this server permanently?')" class="inline">
                          <input type="hidden" name="_csrf" value="<%= _csrf %>">
                          <button type="submit" title="Delete Server" class="p-2 rounded-lg bg-red-500/10 hover:bg-red-500/20 text-red-400 transition">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- PAGINATION -->
        <% if (totalPages > 1) { %>
          <div class="px-6 py-4 border-t border-white/5 flex items-center justify-between text-xs text-neutral-400 bg-[#101213]">
            <span>Page <%= page %> of <%= totalPages %> (<%= totalCount %> total servers)</span>
            <div class="flex items-center gap-2">
              <% if (page > 1) { %>
                <a href="/admin/servers?page=<%= page - 1 %>&search=<%= search %>&software=<%= softwareFilter %>&status=<%= statusFilter %>&sort=<%= sort %>" class="btn-secondary py-1.5 px-3">Previous</a>
              <% } %>
              <% if (page < totalPages) { %>
                <a href="/admin/servers?page=<%= page + 1 %>&search=<%= search %>&software=<%= softwareFilter %>&status=<%= statusFilter %>&sort=<%= sort %>" class="btn-secondary py-1.5 px-3">Next</a>
              <% } %>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </main>
</div>

<!-- CREATE SERVER WIZARD MODAL -->
<div id="createServerModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
  <div class="kgp-card max-w-xl w-full p-6 space-y-6 relative border-white/10 max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between border-b border-white/5 pb-4">
      <h3 class="text-lg font-bold text-white">Create Minecraft Server</h3>
      <button onclick="closeModal('createServerModal')" class="text-neutral-400 hover:text-white">&times;</button>
    </div>
    <form method="POST" action="/admin/servers/create" onsubmit="const btn = this.querySelector('button[type=submit]'); btn.innerText = 'Creating Server...'; btn.disabled = true;" class="space-y-5 text-xs">
      <input type="hidden" name="_csrf" value="<%= _csrf %>">

      <!-- GENERAL SECTION -->
      <div class="space-y-3">
        <h4 class="font-bold text-white uppercase text-[10px] tracking-wider text-[#1873d3]">1. General Configuration</h4>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block font-semibold text-neutral-400 mb-1">Server Name</label>
            <input type="text" name="name" required placeholder="e.g. Survival SMP" class="w-full px-3.5 py-2.5 rounded-xl bg-[#101213] border border-white/5 text-sm text-white focus:outline-none focus:border-[#1873d3]">
          </div>
          <div>
            <label class="block font-semibold text-neutral-400 mb-1">Owner Account</label>
            <select name="owner_id" required class="w-full px-3.5 py-2.5 rounded-xl bg-[#101213] border border-white/5 text-sm text-white focus:outline-none focus:border-[#1873d3]">
              <% allUsers.forEach(function(u) { %>
                <option value="<%= u.id %>" <%= u.id === user.id ? 'selected' : '' %>><%= u.username %> (<%= u.email %>)</option>
              <% }); %>
            </select>
          </div>
        </div>

        <div>
          <label class="block font-semibold text-neutral-400 mb-1">Description</label>
          <input type="text" name="description" placeholder="Short description..." class="w-full px-3.5 py-2 rounded-xl bg-[#101213] border border-white/5 text-sm text-white focus:outline-none focus:border-[#1873d3]">
        </div>
      </div>

      <!-- SOFTWARE & VERSION SECTION -->
      <div class="space-y-3 pt-3 border-t border-white/5">
        <h4 class="font-bold text-white uppercase text-[10px] tracking-wider text-purple-400">2. Engine & Version</h4>
        <div class="grid grid-cols-3 gap-3">
          <div>
            <label class="block font-semibold text-neutral-400 mb-1">Software</label>
            <select name="software" class="w-full px-3 py-2 rounded-xl bg-[#101213] border border-white/5 text-sm text-white focus:outline-none focus:border-[#1873d3]">
              <option value="Paper">Paper (Recommended)</option>
              <option value="Purpur">Purpur</option>
              <option value="Vanilla">Vanilla</option>
              <option value="Fabric">Fabric</option>
            </select>
          </div>
          <div>
            <label class="block font-semibold text-neutral-400 mb-1">Minecraft Version</label>
            <select name="version" class="w-full px-3 py-2 rounded-xl bg-[#101213] border border-white/5 text-sm text-white focus:outline-none focus:border-[#1873d3]">
              <option value="1.20.4">1.20.4</option>
              <option value="1.20.2">1.20.2</option>
              <option value="1.20.1">1.20.1</option>
              <option value="1.21">1.21</option>
              <option value="1.26.2">1.26.2 (Latest)</option>
              <option value="1.19.4">1.19.4</option>
            </select>
          </div>
          <div>
            <label class="block font-semibold text-neutral-400 mb-1">Java Runtime</label>
            <select name="java_version" class="w-full px-3 py-2 rounded-xl bg-[#101213] border border-white/5 text-sm text-white focus:outline-none focus:border-[#1873d3]">
              <option value="21">Java 21 (LTS)</option>
              <option value="17">Java 17 (LTS)</option>
            </select>
          </div>
        </div>
      </div>

      <!-- RESOURCE ALLOCATION SECTION -->
      <div class="space-y-3 pt-3 border-t border-white/5">
        <h4 class="font-bold text-white uppercase text-[10px] tracking-wider text-emerald-400">3. Resource Quotas</h4>
        <div class="grid grid-cols-3 gap-3">
          <div>
            <label class="block font-semibold text-neutral-400 mb-1">RAM (MB)</label>
            <input type="number" name="ram_limit" value="2048" required class="w-full px-3 py-2 rounded-xl bg-[#101213] border border-white/5 text-sm text-white focus:outline-none focus:border-[#1873d3]">
          </div>
          <div>
            <label class="block font-semibold text-neutral-400 mb-1">CPU Limit (%)</label>
            <input type="number" name="cpu_limit" value="100" required class="w-full px-3 py-2 rounded-xl bg-[#101213] border border-white/5 text-sm text-white focus:outline-none focus:border-[#1873d3]">
          </div>
          <div>
            <label class="block font-semibold text-neutral-400 mb-1">Disk Limit (GB)</label>
            <input type="number" name="disk_limit" value="10" required class="w-full px-3 py-2 rounded-xl bg-[#101213] border border-white/5 text-sm text-white focus:outline-none focus:border-[#1873d3]">
          </div>
        </div>
      </div>

      <!-- LOCATION SECTION -->
      <div class="p-3 rounded-xl bg-[#101213] border border-white/5 flex items-center justify-between text-xs">
        <span class="text-neutral-400">Target Node:</span>
        <span class="font-bold text-white">Local Node (Primary Engine)</span>
      </div>

      <div class="pt-4 flex justify-end gap-3 border-t border-white/5">
        <button type="button" onclick="closeModal('createServerModal')" class="btn-secondary text-xs">Cancel</button>
        <button type="submit" class="btn-primary text-xs">Initialize & Download Jar</button>
      </div>
    </form>
  </div>
</div>

<!-- CHANGE OWNER MODAL -->
<div id="reownModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
  <div class="kgp-card max-w-md w-full p-6 space-y-6 relative border-white/10">
    <div class="flex items-center justify-between border-b border-white/5 pb-4">
      <h3 class="text-lg font-bold text-white">Reassign Server Owner</h3>
      <button onclick="closeModal('reownModal')" class="text-neutral-400 hover:text-white">&times;</button>
    </div>
    <form id="reownForm" method="POST" action="" class="space-y-4 text-xs">
      <input type="hidden" name="_csrf" value="<%= _csrf %>">
      <p class="text-xs text-neutral-400">Reassigning owner for <span id="reownServerName" class="font-bold text-white"></span>.</p>
      <div>
        <label class="block font-semibold text-neutral-400 mb-1">Select New Owner</label>
        <select id="reownSelect" name="new_owner_id" class="w-full px-3.5 py-2.5 rounded-xl bg-[#101213] border border-white/5 text-sm text-white focus:outline-none focus:border-[#1873d3]">
          <% allUsers.forEach(function(u) { %>
            <option value="<%= u.id %>"><%= u.username %> (<%= u.email %>)</option>
          <% }); %>
        </select>
      </div>
      <div class="pt-4 flex justify-end gap-3 border-t border-white/5">
        <button type="button" onclick="closeModal('reownModal')" class="btn-secondary text-xs">Cancel</button>
        <button type="submit" class="btn-primary text-xs">Save Owner</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openModal(id) {
    document.getElementById(id).classList.remove('hidden');
  }
  function closeModal(id) {
    document.getElementById(id).classList.add('hidden');
  }
  function openReownModal(id, name, ownerId) {
    document.getElementById('reownForm').action = '/admin/servers/' + id + '/owner';
    document.getElementById('reownServerName').innerText = name;
    document.getElementById('reownSelect').value = ownerId;
    openModal('reownModal');
  }
</script>

<%- include('../layouts/footer', { script: null }) %>
