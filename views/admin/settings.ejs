<%- include('../layouts/header', { title: 'Panel Branding & Settings' }) %>

<div class="min-h-screen bg-[#0D1117] flex flex-col lg:flex-row">
  <%- include('../components/sidebar') %>

  <main class="flex-1 lg:pl-60 pt-14 lg:pt-0 pb-20 lg:pb-10 min-h-screen flex flex-col">
    <!-- Top Bar / Breadcrumb Navigation -->
    <header class="h-14 px-6 lg:px-8 border-b border-[#30363D] flex items-center justify-between bg-[#0D1117]/90 sticky top-0 z-20">
      <div class="flex items-center gap-2 text-xs sm:text-sm text-[#8B949E]">
        <span class="text-white font-medium">Administration</span>
        <span>/</span>
        <span class="text-[#2F81F7] font-medium">Settings</span>
      </div>
      <div class="flex items-center gap-3">
        <button form="settingsForm" type="submit" class="btn-kinetic text-xs flex items-center gap-2 py-1.5 px-3">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          Save All Changes
        </button>
      </div>
    </header>

    <div class="p-6 lg:p-10 max-w-[1400px] w-full mx-auto space-y-8 flex-1">
      <!-- ALERT MESSAGES -->
      <% if (typeof msg !== 'undefined' && msg) { %>
        <div class="p-4 rounded-xl bg-[#3FB950]/10 border border-[#3FB950]/30 text-[#3FB950] text-sm flex items-center justify-between">
          <span>Settings & branding saved successfully!</span>
          <button onclick="this.parentElement.remove()" class="text-[#3FB950] hover:text-white">&times;</button>
        </div>
      <% } %>

      <!-- HEADER TITLE -->
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white">Panel Branding & Configuration</h1>
        <p class="text-[#8B949E] text-sm mt-1">Customize logos, colors, background artwork, social channels, and SEO metadata saved directly in SQLite.</p>
      </div>

      <form id="settingsForm" method="POST" action="/admin/settings/update" enctype="multipart/form-data" class="space-y-8">
        <input type="hidden" name="_csrf" value="<%= _csrf %>">

        <!-- BRANDING & IDENTITY SECTION -->
        <div class="kgp-card p-6 sm:p-8 space-y-6">
          <h2 class="text-lg font-bold text-white border-b border-[#30363D] pb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-[#2F81F7]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>
            Branding & Identity
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs">
            <div>
              <label class="block font-semibold text-[#8B949E] mb-1">Panel Name</label>
              <input type="text" name="panel_name" value="<%= settings.panel_name || 'KineticGP' %>" required class="w-full px-3.5 py-2.5 rounded-xl bg-[#21262D] border border-[#30363D] text-sm text-white focus:outline-none focus:border-[#2F81F7]">
            </div>

            <div>
              <label class="block font-semibold text-[#8B949E] mb-1">Company / Host Name</label>
              <input type="text" name="company_name" value="<%= settings.company_name || 'KineticHost' %>" required class="w-full px-3.5 py-2.5 rounded-xl bg-[#21262D] border border-[#30363D] text-sm text-white focus:outline-none focus:border-[#2F81F7]">
            </div>

            <div>
              <label class="block font-semibold text-[#8B949E] mb-1">Primary Color (Hex)</label>
              <div class="flex items-center gap-3">
                <input type="color" value="<%= settings.primary_color || '#2F81F7' %>" onchange="document.getElementById('primaryHex').value = this.value" class="w-10 h-10 rounded-lg bg-transparent border-0 cursor-pointer">
                <input type="text" id="primaryHex" name="primary_color" value="<%= settings.primary_color || '#2F81F7' %>" class="flex-1 px-3.5 py-2.5 rounded-xl bg-[#21262D] border border-[#30363D] text-sm text-white font-mono focus:outline-none focus:border-[#2F81F7]">
              </div>
            </div>

            <div>
              <label class="block font-semibold text-[#8B949E] mb-1">Accent Color (Hex)</label>
              <div class="flex items-center gap-3">
                <input type="color" value="<%= settings.accent_color || '#3FB950' %>" onchange="document.getElementById('accentHex').value = this.value" class="w-10 h-10 rounded-lg bg-transparent border-0 cursor-pointer">
                <input type="text" id="accentHex" name="accent_color" value="<%= settings.accent_color || '#3FB950' %>" class="flex-1 px-3.5 py-2.5 rounded-xl bg-[#21262D] border border-[#30363D] text-sm text-white font-mono focus:outline-none focus:border-[#2F81F7]">
              </div>
            </div>
          </div>
        </div>

        <!-- MEDIA & BACKGROUND ASSETS -->
        <div class="kgp-card p-6 sm:p-8 space-y-6">
          <h2 class="text-lg font-bold text-white border-b border-[#30363D] pb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            Media & Background Artwork
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs">
            <!-- Logo -->
            <div class="p-4 rounded-xl bg-[#21262D] border border-[#30363D] space-y-2">
              <label class="block font-semibold text-white">Panel Logo (SVG / PNG)</label>
              <div class="flex items-center gap-3">
                <img src="<%= settings.site_logo || '/images/logo.svg' %>" alt="Current Logo" class="h-8 w-auto">
                <input type="file" name="site_logo" accept="image/*" class="text-xs text-[#8B949E] file:mr-3 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-[#2F81F7] file:text-white hover:file:bg-[#58A6FF]">
              </div>
            </div>

            <!-- Favicon -->
            <div class="p-4 rounded-xl bg-[#21262D] border border-[#30363D] space-y-2">
              <label class="block font-semibold text-white">Favicon Icon</label>
              <div class="flex items-center gap-3">
                <img src="<%= settings.site_favicon || '/images/favicon.png' %>" alt="Favicon" class="w-6 h-6">
                <input type="file" name="site_favicon" accept="image/*" class="text-xs text-[#8B949E] file:mr-3 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-[#2F81F7] file:text-white hover:file:bg-[#58A6FF]">
              </div>
            </div>

            <!-- Hero Video / Background -->
            <div class="p-4 rounded-xl bg-[#21262D] border border-[#30363D] space-y-2">
              <label class="block font-semibold text-white">Hero Video URL / Path</label>
              <input type="text" name="hero_bg_video" value="<%= settings.hero_bg_video || '/bg.mp4' %>" class="w-full px-3 py-2 rounded-xl bg-[#0D1117] border border-[#30363D] text-xs text-white">
              <input type="file" name="hero_bg_video" accept="video/*,image/*" class="text-xs text-[#8B949E] mt-1 file:mr-3 file:py-1 file:px-3 file:rounded-xl file:border-0 file:text-xs file:bg-white/5 file:text-neutral-300">
            </div>

            <!-- Hero Artwork -->
            <div class="p-4 rounded-xl bg-[#21262D] border border-[#30363D] space-y-2">
              <label class="block font-semibold text-white">Hero Minecraft Artwork PNG</label>
              <input type="text" name="hero_art" value="<%= settings.hero_art || '/mc-art.png' %>" class="w-full px-3 py-2 rounded-xl bg-[#0D1117] border border-[#30363D] text-xs text-white">
              <input type="file" name="hero_art" accept="image/*" class="text-xs text-[#8B949E] mt-1 file:mr-3 file:py-1 file:px-3 file:rounded-xl file:border-0 file:text-xs file:bg-white/5 file:text-neutral-300">
            </div>

            <!-- Overview Banner -->
            <div class="p-4 rounded-xl bg-[#21262D] border border-[#30363D] space-y-2">
              <label class="block font-semibold text-white">Admin Overview Banner</label>
              <input type="text" name="overview_banner" value="<%= settings.overview_banner || '/images/banners/overview.jpg' %>" class="w-full px-3 py-2 rounded-xl bg-[#0D1117] border border-[#30363D] text-xs text-white">
              <input type="file" name="overview_banner" accept="image/*" class="text-xs text-[#8B949E] mt-1 file:mr-3 file:py-1 file:px-3 file:rounded-xl file:border-0 file:text-xs file:bg-white/5 file:text-neutral-300">
            </div>

            <!-- Profile Banner -->
            <div class="p-4 rounded-xl bg-[#21262D] border border-[#30363D] space-y-2">
              <label class="block font-semibold text-white">Default Account Banner</label>
              <input type="text" name="profile_banner" value="<%= settings.profile_banner || '/images/banners/account-banner.png' %>" class="w-full px-3 py-2 rounded-xl bg-[#0D1117] border border-[#30363D] text-xs text-white">
              <input type="file" name="profile_banner" accept="image/*" class="text-xs text-[#8B949E] mt-1 file:mr-3 file:py-1 file:px-3 file:rounded-xl file:border-0 file:text-xs file:bg-white/5 file:text-neutral-300">
            </div>
          </div>
        </div>

        <!-- FOOTER & SOCIAL LINKS -->
        <div class="kgp-card p-6 sm:p-8 space-y-6">
          <h2 class="text-lg font-bold text-white border-b border-[#30363D] pb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-[#3FB950]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
            Footer & Social Links
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs">
            <div class="md:col-span-2">
              <label class="block font-semibold text-[#8B949E] mb-1">Footer Copyright Text</label>
              <input type="text" name="footer_text" value="<%= settings.footer_text || '© 2026 KineticHost. All rights reserved.' %>" class="w-full px-3.5 py-2.5 rounded-xl bg-[#21262D] border border-[#30363D] text-sm text-white focus:outline-none focus:border-[#2F81F7]">
            </div>

            <div>
              <label class="block font-semibold text-[#8B949E] mb-1">Discord Community Link</label>
              <input type="url" name="discord_link" value="<%= settings.discord_link || 'https://discord.gg/kinetichost' %>" class="w-full px-3.5 py-2.5 rounded-xl bg-[#21262D] border border-[#30363D] text-sm text-white focus:outline-none focus:border-[#2F81F7]">
            </div>

            <div>
              <label class="block font-semibold text-[#8B949E] mb-1">GitHub Repository Link</label>
              <input type="url" name="github_link" value="<%= settings.github_link || 'https://github.com/xAyan55/kineticgp' %>" class="w-full px-3.5 py-2.5 rounded-xl bg-[#21262D] border border-[#30363D] text-sm text-white focus:outline-none focus:border-[#2F81F7]">
            </div>
          </div>
        </div>

        <!-- SEO METADATA -->
        <div class="kgp-card p-6 sm:p-8 space-y-6">
          <h2 class="text-lg font-bold text-white border-b border-[#30363D] pb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            SEO & Search Engine Metadata
          </h2>

          <div class="space-y-4 text-xs">
            <div>
              <label class="block font-semibold text-[#8B949E] mb-1">SEO Title Tag</label>
              <input type="text" name="site_title" value="<%= settings.site_title || 'KineticGP — Self-Hosted Minecraft Server Panel' %>" class="w-full px-3.5 py-2.5 rounded-xl bg-[#21262D] border border-[#30363D] text-sm text-white focus:outline-none focus:border-[#2F81F7]">
            </div>

            <div>
              <label class="block font-semibold text-[#8B949E] mb-1">SEO Meta Description</label>
              <textarea name="site_description" rows="3" class="w-full px-3.5 py-2.5 rounded-xl bg-[#21262D] border border-[#30363D] text-sm text-white focus:outline-none focus:border-[#2F81F7]"><%= settings.site_description || 'High-performance self-hosted Minecraft server management panel.' %></textarea>
            </div>
          </div>
        </div>

        <div class="flex justify-end pt-4">
          <button type="submit" class="btn-primary text-sm px-8 py-3 flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Save All Changes
          </button>
        </div>
      </form>
    </div>
  </main>
</div>

<%- include('../layouts/footer', { script: null }) %>
