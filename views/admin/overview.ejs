<%- include('../layouts/header', { title: 'Admin Overview' }) %>

<div class="min-h-screen bg-[#0a0b0c] flex flex-col lg:flex-row">
  <%- include('../components/sidebar') %>

  <main class="flex-1 lg:pl-60 pt-14 lg:pt-0 pb-20 lg:pb-10 min-h-screen flex flex-col">
    <!-- Top Bar / Breadcrumbs -->
    <header class="h-14 px-6 lg:px-8 border-b border-white/5 flex items-center justify-between bg-[#0a0b0c]/90 sticky top-0 z-20">
      <div class="flex items-center gap-2 text-xs sm:text-sm text-neutral-400">
        <span class="text-white font-medium">Administration</span>
        <span>/</span>
        <span class="text-[#1873d3] font-medium">Overview</span>
      </div>
      <div class="flex items-center gap-3">
        <% if (stats.nodeStatus === 'online') { %>
          <span class="px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>System Healthy</span>
          </span>
        <% } else { %>
          <span class="px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs font-semibold flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
            <span>Node Degraded</span>
          </span>
        <% } %>
      </div>
    </header>

    <div class="p-6 lg:p-8 max-w-[1400px] w-full mx-auto space-y-6 flex-1">
      <!-- HERO BANNER (NO GRADIENTS - SOLID DARK OVERLAY BACKDROP) -->
      <div class="kgp-card relative overflow-hidden p-6 sm:p-8 bg-[#121416]" style="background-image: url('/images/banners/overview.jpg'); background-position: center; background-size: cover;">
        <!-- Solid Dark Overlay for Crisp Contrast -->
        <div class="absolute inset-0 bg-[#121416]/90 z-0"></div>

        <div class="relative z-10 space-y-3">
          <div class="flex items-center gap-3">
            <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[#1873d3]/20 border border-[#1873d3]/40 text-[#1873d3] uppercase tracking-wider">System Control Center</span>
            <span class="text-xs font-mono text-neutral-400">Uptime: <%= stats.uptime %></span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Administration Overview</h1>
          <p class="text-xs sm:text-sm text-neutral-300 max-w-2xl leading-relaxed">
            Monitor system performance, user accounts, node infrastructure, and security audit activity in real time.
          </p>
        </div>
      </div>

      <!-- ANALYTICS CARDS GRID (4 Primary Infrastructure Stats) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Card 1: Users -->
        <div class="kgp-card p-5">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-medium text-neutral-400 uppercase tracking-wider">Total Users</span>
            <div class="w-8 h-8 rounded-lg bg-blue-500/10 border border-blue-500/20 text-blue-400 flex items-center justify-center">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
            </div>
          </div>
          <div class="text-3xl font-extrabold text-white mb-2"><%= stats.totalUsers %></div>
          <div class="flex items-center justify-between text-xs text-neutral-400 border-t border-white/5 pt-2">
            <span class="text-emerald-400 font-medium"><%= stats.activeUsers %> Active</span>
            <span class="text-amber-400 font-medium"><%= stats.suspendedUsers %> Suspended</span>
          </div>
        </div>

        <!-- Card 2: Servers -->
        <div class="kgp-card p-5">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-medium text-neutral-400 uppercase tracking-wider">Total Servers</span>
            <div class="w-8 h-8 rounded-lg bg-purple-500/10 border border-purple-500/20 text-purple-400 flex items-center justify-center">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2"/></svg>
            </div>
          </div>
          <div class="text-3xl font-extrabold text-white mb-2"><%= stats.totalServers %></div>
          <div class="flex items-center justify-between text-xs text-neutral-400 border-t border-white/5 pt-2">
            <span class="text-emerald-400 font-medium"><%= stats.onlineServers %> Online</span>
            <span class="text-neutral-500 font-medium"><%= stats.offlineServers %> Offline</span>
          </div>
        </div>

        <!-- Card 3: RAM Allocated -->
        <div class="kgp-card p-5">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-medium text-neutral-400 uppercase tracking-wider">RAM Allocated</span>
            <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/></svg>
            </div>
          </div>
          <div class="text-3xl font-extrabold text-white mb-2"><%= stats.nodeRamUsed %> <span class="text-sm text-neutral-400 font-normal">/ <%= stats.nodeRamTotal %> GB</span></div>
          <div class="w-full h-2 rounded-full bg-[#0d0e0f] border border-white/5 overflow-hidden">
            <div class="h-full bg-emerald-500 rounded-full" style="width: <%= Math.round((parseFloat(stats.nodeRamUsed) / (parseFloat(stats.nodeRamTotal) || 1)) * 100) %>%"></div>
          </div>
        </div>

        <!-- Card 4: Host CPU Load -->
        <div class="kgp-card p-5">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-medium text-neutral-400 uppercase tracking-wider">Host CPU Load</span>
            <div class="w-8 h-8 rounded-lg bg-[#1873d3]/10 border border-[#1873d3]/20 text-[#1873d3] flex items-center justify-center">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
          </div>
          <div class="text-3xl font-extrabold text-white mb-2"><%= stats.nodeCpu %>%</div>
          <div class="w-full h-2 rounded-full bg-[#0d0e0f] border border-white/5 overflow-hidden">
            <div class="h-full bg-[#1873d3] rounded-full" style="width: <%= stats.nodeCpu %>%"></div>
          </div>
        </div>
      </div>

      <!-- RESOURCE USAGE & STATUS BREAKDOWN (2-Column Grid) -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <!-- Resource Utilization Rows -->
        <div class="kgp-card p-6 space-y-4">
          <div class="flex items-center justify-between border-b border-white/5 pb-3">
            <h2 class="text-base font-bold text-white">Node Resource Usage</h2>
            <span class="text-xs text-emerald-400 font-medium">Realtime Metrics</span>
          </div>
          <div class="space-y-4">
            <div>
              <div class="flex justify-between text-xs text-neutral-400 mb-1.5">
                <span>CPU Load Utilization</span>
                <span class="text-white font-semibold font-mono"><%= stats.nodeCpu %>%</span>
              </div>
              <div class="w-full h-2.5 rounded-full bg-[#0d0e0f] border border-white/5 overflow-hidden">
                <div class="h-full bg-[#1873d3] rounded-full transition-all duration-300" style="width: <%= stats.nodeCpu %>%"></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-xs text-neutral-400 mb-1.5">
                <span>Memory Allocation (<%= stats.nodeRamUsed %> GB used)</span>
                <span class="text-white font-semibold font-mono"><%= Math.round((parseFloat(stats.nodeRamUsed) / (parseFloat(stats.nodeRamTotal) || 1)) * 100) %>%</span>
              </div>
              <div class="w-full h-2.5 rounded-full bg-[#0d0e0f] border border-white/5 overflow-hidden">
                <div class="h-full bg-emerald-500 rounded-full transition-all duration-300" style="width: <%= Math.round((parseFloat(stats.nodeRamUsed) / (parseFloat(stats.nodeRamTotal) || 1)) * 100) %>%"></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-xs text-neutral-400 mb-1.5">
                <span>Disk Space Storage (<%= stats.nodeDiskUsed %> GB used)</span>
                <span class="text-white font-semibold font-mono"><%= Math.round((parseFloat(stats.nodeDiskUsed) / (parseFloat(stats.nodeDiskTotal) || 1)) * 100) %>%</span>
              </div>
              <div class="w-full h-2.5 rounded-full bg-[#0d0e0f] border border-white/5 overflow-hidden">
                <div class="h-full bg-purple-500 rounded-full transition-all duration-300" style="width: <%= Math.round((parseFloat(stats.nodeDiskUsed) / (parseFloat(stats.nodeDiskTotal) || 1)) * 100) %>%"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- System Status 2x2 Grid -->
        <div class="kgp-card p-6 space-y-4">
          <div class="flex items-center justify-between border-b border-white/5 pb-3">
            <h2 class="text-base font-bold text-white">System Status Breakdown</h2>
            <span class="text-xs text-neutral-400">Live Database State</span>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-3.5 rounded-lg bg-[#0d0e0f] border border-white/5 text-center">
              <span class="text-xs text-neutral-400">Active Accounts</span>
              <p class="text-2xl font-bold text-emerald-400 mt-1"><%= stats.activeUsers %></p>
            </div>
            <div class="p-3.5 rounded-lg bg-[#0d0e0f] border border-white/5 text-center">
              <span class="text-xs text-neutral-400">Suspended Accounts</span>
              <p class="text-2xl font-bold text-amber-400 mt-1"><%= stats.suspendedUsers %></p>
            </div>
            <div class="p-3.5 rounded-lg bg-[#0d0e0f] border border-white/5 text-center">
              <span class="text-xs text-neutral-400">Online Minecraft Nodes</span>
              <p class="text-2xl font-bold text-[#1873d3] mt-1"><%= stats.onlineServers %></p>
            </div>
            <div class="p-3.5 rounded-lg bg-[#0d0e0f] border border-white/5 text-center">
              <span class="text-xs text-neutral-400">Offline Nodes</span>
              <p class="text-2xl font-bold text-neutral-500 mt-1"><%= stats.offlineServers %></p>
            </div>
          </div>
        </div>
      </div>

      <!-- SYSTEM AUDIT STREAM -->
      <div class="kgp-card p-5 sm:p-6 space-y-4">
        <div class="flex items-center justify-between border-b border-white/5 pb-3">
          <h2 class="text-base font-bold text-white tracking-tight">System Audit Stream</h2>
          <a href="/admin/logs" class="text-xs text-[#1873d3] hover:underline font-medium">View All Logs &rarr;</a>
        </div>

        <div class="space-y-2">
          <% if (recentLogs.length === 0) { %>
            <p class="text-xs text-neutral-500 py-4 text-center">No system events recorded yet.</p>
          <% } else { %>
            <% recentLogs.forEach(function(log) { %>
              <div class="flex items-center justify-between gap-4 p-3 rounded-lg bg-[#0d0e0f] border border-white/5 text-xs">
                <div class="flex items-center gap-3 min-w-0">
                  <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold uppercase tracking-wider bg-[#1873d3]/10 text-[#1873d3] border border-[#1873d3]/30 flex-shrink-0">
                    [<%= log.action %>]
                  </span>
                  <div class="truncate">
                    <span class="font-semibold text-white"><%= log.username %></span>
                    <span class="text-neutral-400 ml-2 truncate"><%= log.details %></span>
                  </div>
                </div>
                <div class="text-right flex-shrink-0">
                  <span class="text-[11px] font-mono text-neutral-400 block"><%= log.ip_address %></span>
                  <span class="text-[10px] text-neutral-500 block"><%= log.created_at %></span>
                </div>
              </div>
            <% }); %>
          <% } %>
        </div>
      </div>

    </div>
  </main>
</div>

<%- include('../layouts/footer', { script: null }) %>
