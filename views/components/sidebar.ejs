<!-- Desktop Sidebar (240px width) -->
<aside class="hidden lg:flex flex-col fixed top-0 left-0 bottom-0 w-60 bg-[#0a0b0c] border-r border-white/5 z-30">
  <!-- Brand Header -->
  <div class="h-14 px-5 flex items-center gap-3 border-b border-white/5 flex-shrink-0">
    <img src="/images/logo.svg" alt="KineticGP Logo" class="h-7 w-auto">
    <span class="text-base font-bold text-white tracking-tight">Kinetic<span class="text-[#1873d3]">GP</span></span>
  </div>

  <!-- Navigation Items -->
  <nav class="flex-1 px-3 py-4 space-y-5 overflow-y-auto custom-scrollbar">
    <!-- User Navigation -->
    <div class="space-y-1">
      <div class="px-3 text-[10px] font-bold text-neutral-500 uppercase tracking-wider">User Area</div>
      <a href="/dashboard" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-xs font-medium transition-all <%= path === '/dashboard' ? 'bg-[#1873d3] text-white shadow-subtle' : 'text-neutral-400 hover:text-white hover:bg-white/5' %>">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
        Dashboard
      </a>

      <a href="/dashboard/profile" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-xs font-medium transition-all <%= path === '/dashboard/profile' ? 'bg-[#1873d3] text-white shadow-subtle' : 'text-neutral-400 hover:text-white hover:bg-white/5' %>">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        Profile Settings
      </a>

      <a href="/" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-xs font-medium text-neutral-400 hover:text-white hover:bg-white/5 transition-all">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
        Landing Page
      </a>
    </div>

    <!-- Active Server Controls (If inside /dashboard/server/:uuid) -->
    <% if (typeof server !== 'undefined' && server && server.uuid) { %>
      <div class="space-y-1 pt-3 border-t border-white/5">
        <div class="px-3 text-[10px] font-bold text-emerald-400 uppercase tracking-wider flex items-center justify-between">
          <span>Server Controls</span>
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        </div>

        <a href="/dashboard/server/<%= server.uuid %>/console" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-xs font-medium transition-all <%= path.endsWith('/console') ? 'bg-[#1873d3] text-white shadow-subtle' : 'text-neutral-400 hover:text-white hover:bg-white/5' %>">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          Console
        </a>

        <a href="/dashboard/server/<%= server.uuid %>/files" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-xs font-medium transition-all <%= path.includes('/files') ? 'bg-[#1873d3] text-white shadow-subtle' : 'text-neutral-400 hover:text-white hover:bg-white/5' %>">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
          File Manager
        </a>

        <a href="/dashboard/server/<%= server.uuid %>/settings" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-xs font-medium transition-all <%= path.endsWith('/settings') ? 'bg-[#1873d3] text-white shadow-subtle' : 'text-neutral-400 hover:text-white hover:bg-white/5' %>">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          Server Settings
        </a>
      </div>
    <% } %>

    <!-- Admin Section (Only for Admin & Super Admin) -->
    <% if (user && (user.role === 'admin' || user.role === 'superadmin')) { %>
      <div class="space-y-1 pt-3 border-t border-white/5">
        <div class="px-3 text-[10px] font-bold text-[#1873d3] uppercase tracking-wider flex items-center justify-between">
          <span>Administration</span>
          <span class="w-1.5 h-1.5 rounded-full bg-[#1873d3] animate-pulse"></span>
        </div>

        <a href="/admin" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-xs font-medium transition-all <%= path === '/admin' ? 'bg-[#1873d3] text-white shadow-subtle' : 'text-neutral-400 hover:text-white hover:bg-white/5' %>">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
          Overview
        </a>

        <a href="/admin/servers" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-xs font-medium transition-all <%= path.startsWith('/admin/servers') ? 'bg-[#1873d3] text-white shadow-subtle' : 'text-neutral-400 hover:text-white hover:bg-white/5' %>">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2"/></svg>
          Servers
        </a>

        <a href="/admin/nodes" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-xs font-medium transition-all <%= path === '/admin/nodes' ? 'bg-[#1873d3] text-white shadow-subtle' : 'text-neutral-400 hover:text-white hover:bg-white/5' %>">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
          Nodes
        </a>

        <a href="/admin/users" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-xs font-medium transition-all <%= path === '/admin/users' ? 'bg-[#1873d3] text-white shadow-subtle' : 'text-neutral-400 hover:text-white hover:bg-white/5' %>">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          Users
        </a>

        <a href="/admin/plans" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-xs font-medium transition-all <%= path === '/admin/plans' ? 'bg-[#1873d3] text-white shadow-subtle' : 'text-neutral-400 hover:text-white hover:bg-white/5' %>">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l4-2 4 2 4-2 4 2z"/></svg>
          Plans
        </a>

        <a href="/admin/settings" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-xs font-medium transition-all <%= path === '/admin/settings' ? 'bg-[#1873d3] text-white shadow-subtle' : 'text-neutral-400 hover:text-white hover:bg-white/5' %>">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          Settings
        </a>

        <a href="/admin/logs" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-xs font-medium transition-all <%= path === '/admin/logs' ? 'bg-[#1873d3] text-white shadow-subtle' : 'text-neutral-400 hover:text-white hover:bg-white/5' %>">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          Audit Logs
        </a>
      </div>
    <% } %>
  </nav>

  <!-- User Card Footer -->
  <div class="p-3 border-t border-white/5 flex-shrink-0">
    <div class="flex items-center justify-between p-2 rounded-lg bg-[#121416] border border-white/5">
      <div class="flex items-center gap-2.5 overflow-hidden">
        <img src="<%= user.avatar %>" alt="User avatar" class="w-7 h-7 rounded-full border border-[#1873d3]/40 object-cover flex-shrink-0">
        <div class="truncate">
          <p class="text-xs font-semibold text-white truncate"><%= user.username %></p>
          <span class="text-[10px] <%= user.role === 'superadmin' ? 'text-purple-400' : user.role === 'admin' ? 'text-[#1873d3]' : 'text-neutral-400' %> font-semibold capitalize">
            <%= user.role === 'superadmin' ? 'Super Admin' : user.role === 'admin' ? 'Administrator' : 'User' %>
          </span>
        </div>
      </div>
      <a href="/logout" title="Sign Out" class="text-neutral-400 hover:text-red-400 transition-colors p-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
      </a>
    </div>
  </div>
</aside>

<!-- Mobile Top Header -->
<div class="lg:hidden fixed top-0 left-0 right-0 h-14 bg-[#0a0b0c]/95 border-b border-white/5 z-30 px-4 flex items-center justify-between">
  <a href="/dashboard" class="flex items-center gap-2">
    <img src="/images/logo.svg" alt="KineticGP Logo" class="h-6 w-auto">
    <span class="text-base font-bold text-white tracking-tight">Kinetic<span class="text-[#1873d3]">GP</span></span>
  </a>
  <div class="flex items-center gap-3">
    <% if (user && (user.role === 'admin' || user.role === 'superadmin')) { %>
      <a href="/admin" class="text-xs px-2.5 py-1 rounded-full bg-[#1873d3]/10 text-[#1873d3] font-semibold border border-[#1873d3]/30">Admin</a>
    <% } %>
    <img src="<%= user.avatar %>" alt="User avatar" class="w-7 h-7 rounded-full border border-[#1873d3]/40 object-cover">
    <a href="/logout" class="text-xs text-neutral-400 hover:text-red-400">Exit</a>
  </div>
</div>

<!-- Mobile Bottom Navigation Rail -->
<div class="lg:hidden fixed bottom-0 left-0 right-0 h-14 bg-[#0a0b0c]/95 border-t border-white/5 z-30 px-4 flex items-center justify-around">
  <a href="/dashboard" class="flex flex-col items-center gap-0.5 text-[11px] font-medium <%= path === '/dashboard' ? 'text-[#1873d3]' : 'text-neutral-400' %>">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
    Dashboard
  </a>
  <% if (user && (user.role === 'admin' || user.role === 'superadmin')) { %>
    <a href="/admin" class="flex flex-col items-center gap-0.5 text-[11px] font-medium <%= path.startsWith('/admin') ? 'text-[#1873d3]' : 'text-neutral-400' %>">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
      Admin
    </a>
  <% } %>
  <a href="/dashboard/profile" class="flex flex-col items-center gap-0.5 text-[11px] font-medium <%= path === '/dashboard/profile' ? 'text-[#1873d3]' : 'text-neutral-400' %>">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
    Profile
  </a>
</div>
