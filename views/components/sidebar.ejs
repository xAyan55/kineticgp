<!-- Desktop Sidebar (224px / w-56 Airlink Panel Layout) -->
<aside class="hidden lg:flex flex-col fixed top-0 left-0 bottom-0 w-56 bg-[#111111] border-r border-white/10 z-40">
  <!-- Brand Logo Header -->
  <div class="px-5 py-4 flex items-center gap-3 border-b border-white/10 flex-shrink-0">
    <a href="/dashboard" class="flex items-center gap-3 min-w-0">
      <img src="/images/logo.svg" alt="KineticGP Logo" class="h-8 w-auto flex-shrink-0">
      <span class="text-base font-semibold text-white tracking-tight truncate">Kinetic<span class="text-neutral-400">GP</span></span>
    </a>
  </div>

  <!-- User Account Block -->
  <% if (user) { %>
    <a href="/dashboard/profile" class="flex items-center space-x-3 py-3.5 px-4 border-b border-white/10 shrink-0 hover:bg-white/5 transition-colors group">
      <img loading="lazy" class="h-8 w-8 rounded-xl object-cover shrink-0 border border-white/10" src="<%= user.avatar || '/images/avatar.png' %>" alt="<%= user.username %>">
      <div class="min-w-0 flex-1">
        <p class="text-sm font-medium truncate text-white group-hover:text-white transition-colors">
          <span><%= user.username %></span>
          <span class="text-neutral-500 text-xs font-mono ml-0.5">#<%= String(user.id || 1).padStart(4, '0') %></span>
        </p>
        <p class="text-xs truncate text-neutral-400 capitalize"><%= user.role === 'superadmin' ? 'Super Admin' : user.role === 'admin' ? 'Administrator' : 'User' %></p>
      </div>
    </a>
  <% } %>

  <!-- Navigation Menu -->
  <nav class="flex-1 py-3 overflow-y-auto space-y-5">
    <!-- Main View Section -->
    <div class="space-y-1">
      <p class="px-5 text-xs font-semibold uppercase tracking-wider text-neutral-500 mb-2">Navigation</p>
      
      <a href="/dashboard" class="flex items-center gap-3 px-3.5 py-2 mx-2 rounded-xl text-sm font-medium transition-colors <%= path === '/dashboard' ? 'bg-white/10 text-white font-semibold' : 'text-neutral-400 hover:text-white hover:bg-white/5' %>">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
        <span>Dashboard</span>
      </a>

      <a href="/dashboard/profile" class="flex items-center gap-3 px-3.5 py-2 mx-2 rounded-xl text-sm font-medium transition-colors <%= path === '/dashboard/profile' ? 'bg-white/10 text-white font-semibold' : 'text-neutral-400 hover:text-white hover:bg-white/5' %>">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        <span>Account</span>
      </a>

      <a href="/" class="flex items-center gap-3 px-3.5 py-2 mx-2 rounded-xl text-sm font-medium text-neutral-400 hover:text-white hover:bg-white/5 transition-colors">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
        <span>Landing Page</span>
      </a>
    </div>

    <!-- Active Server Controls (If inside /dashboard/server/:uuid) -->
    <% if (typeof server !== 'undefined' && server && server.uuid) { %>
      <div class="space-y-1 pt-3 border-t border-white/10">
        <p class="px-5 text-xs font-semibold uppercase tracking-wider text-emerald-400 mb-2 flex items-center justify-between">
          <span>Server Controls</span>
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        </p>

        <a href="/dashboard/server/<%= server.uuid %>/console" class="flex items-center gap-3 px-3.5 py-2 mx-2 rounded-xl text-sm font-medium transition-colors <%= path.endsWith('/console') ? 'bg-white/10 text-white font-semibold' : 'text-neutral-400 hover:text-white hover:bg-white/5' %>">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          <span>Console</span>
        </a>

        <a href="/dashboard/server/<%= server.uuid %>/files" class="flex items-center gap-3 px-3.5 py-2 mx-2 rounded-xl text-sm font-medium transition-colors <%= path.includes('/files') ? 'bg-white/10 text-white font-semibold' : 'text-neutral-400 hover:text-white hover:bg-white/5' %>">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
          <span>Files</span>
        </a>

        <a href="/dashboard/server/<%= server.uuid %>/plugins" class="flex items-center gap-3 px-3.5 py-2 mx-2 rounded-xl text-sm font-medium transition-colors <%= path.endsWith('/plugins') ? 'bg-white/10 text-white font-semibold' : 'text-neutral-400 hover:text-white hover:bg-white/5' %>">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M11 4a2 2 0 00-2 2v2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v2a2 2 0 002 2h6a2 2 0 002-2v-2h2a2 2 0 002-2V10a2 2 0 00-2-2h-2V6a2 2 0 00-2-2h-6z"/></svg>
          <span>Plugins</span>
        </a>

        <a href="/dashboard/server/<%= server.uuid %>/settings" class="flex items-center gap-3 px-3.5 py-2 mx-2 rounded-xl text-sm font-medium transition-colors <%= path.endsWith('/settings') ? 'bg-white/10 text-white font-semibold' : 'text-neutral-400 hover:text-white hover:bg-white/5' %>">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          <span>Settings</span>
        </a>
      </div>
    <% } %>

    <!-- Admin Section -->
    <% if (user && (user.role === 'admin' || user.role === 'superadmin')) { %>
      <div class="space-y-1 pt-3 border-t border-white/10">
        <p class="px-5 text-xs font-semibold uppercase tracking-wider text-neutral-500 mb-2">Admin Panel</p>

        <a href="/admin" class="flex items-center gap-3 px-3.5 py-2 mx-2 rounded-xl text-sm font-medium transition-colors <%= path === '/admin' ? 'bg-white/10 text-white font-semibold' : 'text-neutral-400 hover:text-white hover:bg-white/5' %>">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
          <span>Overview</span>
        </a>

        <a href="/admin/servers" class="flex items-center gap-3 px-3.5 py-2 mx-2 rounded-xl text-sm font-medium transition-colors <%= path.startsWith('/admin/servers') ? 'bg-white/10 text-white font-semibold' : 'text-neutral-400 hover:text-white hover:bg-white/5' %>">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2"/></svg>
          <span>Servers</span>
        </a>

        <a href="/admin/nodes" class="flex items-center gap-3 px-3.5 py-2 mx-2 rounded-xl text-sm font-medium transition-colors <%= path === '/admin/nodes' ? 'bg-white/10 text-white font-semibold' : 'text-neutral-400 hover:text-white hover:bg-white/5' %>">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
          <span>Nodes</span>
        </a>

        <a href="/admin/users" class="flex items-center gap-3 px-3.5 py-2 mx-2 rounded-xl text-sm font-medium transition-colors <%= path === '/admin/users' ? 'bg-white/10 text-white font-semibold' : 'text-neutral-400 hover:text-white hover:bg-white/5' %>">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          <span>Users</span>
        </a>

        <a href="/admin/plans" class="flex items-center gap-3 px-3.5 py-2 mx-2 rounded-xl text-sm font-medium transition-colors <%= path === '/admin/plans' ? 'bg-white/10 text-white font-semibold' : 'text-neutral-400 hover:text-white hover:bg-white/5' %>">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l4-2 4 2 4-2 4 2z"/></svg>
          <span>Plans</span>
        </a>

        <a href="/admin/settings" class="flex items-center gap-3 px-3.5 py-2 mx-2 rounded-xl text-sm font-medium transition-colors <%= path === '/admin/settings' ? 'bg-white/10 text-white font-semibold' : 'text-neutral-400 hover:text-white hover:bg-white/5' %>">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          <span>Settings</span>
        </a>

        <a href="/admin/logs" class="flex items-center gap-3 px-3.5 py-2 mx-2 rounded-xl text-sm font-medium transition-colors <%= path === '/admin/logs' ? 'bg-white/10 text-white font-semibold' : 'text-neutral-400 hover:text-white hover:bg-white/5' %>">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          <span>Audit Logs</span>
        </a>
      </div>
    <% } %>
  </nav>

  <!-- Logout Footer -->
  <div class="p-3 border-t border-white/10 flex-shrink-0">
    <a href="/logout" class="flex items-center justify-between px-3.5 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 transition-all text-xs font-medium text-neutral-300 hover:text-white group">
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4 text-neutral-400 group-hover:text-red-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
        <span>Sign Out</span>
      </span>
      <span class="text-[10px] text-neutral-500 font-mono">⌘Q</span>
    </a>
  </div>
</aside>

<!-- Mobile Frosted Top Bar -->
<div class="lg:hidden fixed top-0 left-0 right-0 h-16 bg-[#141414]/80 backdrop-blur-xl border-b border-white/10 z-30 px-4 flex items-center justify-between">
  <a href="/dashboard" class="flex items-center gap-2.5">
    <img src="/images/logo.svg" alt="KineticGP Logo" class="h-7 w-auto">
    <span class="text-base font-semibold text-white tracking-tight">Kinetic<span class="text-neutral-400">GP</span></span>
  </a>
  <div class="flex items-center gap-3">
    <% if (user && (user.role === 'admin' || user.role === 'superadmin')) { %>
      <a href="/admin" class="text-xs px-2.5 py-1 rounded-full bg-white/10 text-white font-medium border border-white/10">Admin</a>
    <% } %>
    <a href="/dashboard/profile">
      <img src="<%= user ? user.avatar : '/images/avatar.png' %>" alt="Avatar" class="w-7 h-7 rounded-xl border border-white/10 object-cover">
    </a>
  </div>
</div>

<!-- Mobile Bottom Navigation Rail -->
<div class="lg:hidden fixed bottom-0 left-0 right-0 h-16 bg-[#141414]/90 backdrop-blur-xl border-t border-white/10 z-30 px-4 flex items-center justify-around">
  <a href="/dashboard" class="flex flex-col items-center gap-1 text-[11px] font-medium <%= path === '/dashboard' ? 'text-white' : 'text-neutral-400' %>">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
    <span>Dashboard</span>
  </a>
  <% if (user && (user.role === 'admin' || user.role === 'superadmin')) { %>
    <a href="/admin" class="flex flex-col items-center gap-1 text-[11px] font-medium <%= path.startsWith('/admin') ? 'text-white' : 'text-neutral-400' %>">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
      <span>Admin</span>
    </a>
  <% } %>
  <a href="/dashboard/profile" class="flex flex-col items-center gap-1 text-[11px] font-medium <%= path === '/dashboard/profile' ? 'text-white' : 'text-neutral-400' %>">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
    <span>Account</span>
  </a>
</div>
