<!-- Desktop Sidebar (224px width) -->
<aside class="hidden lg:flex flex-col fixed top-0 left-0 bottom-0 w-56 bg-[#101213]/90 backdrop-blur-xl border-r border-white/5 z-30">
  <!-- Brand Header -->
  <div class="h-16 px-6 flex items-center gap-3 border-b border-white/5">
    <img src="/images/logo.svg" alt="KineticGP Logo" class="h-7 w-auto">
    <span class="text-lg font-bold text-white tracking-tight">Kinetic<span class="text-[#1873d3]">GP</span></span>
  </div>

  <!-- Navigation Items -->
  <nav class="flex-1 px-4 py-6 space-y-1.5 overflow-y-auto">
    <a href="/dashboard" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all duration-150 <%= path === '/dashboard' ? 'bg-[#1873d3] text-white shadow-soft-md' : 'text-neutral-400 hover:text-white hover:bg-white/5' %>">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
      Dashboard
    </a>

    <a href="/dashboard/profile" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all duration-150 <%= path === '/dashboard/profile' ? 'bg-[#1873d3] text-white shadow-soft-md' : 'text-neutral-400 hover:text-white hover:bg-white/5' %>">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
      Profile Settings
    </a>

    <a href="/" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-neutral-400 hover:text-white hover:bg-white/5 transition-all duration-150">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
      Landing Page
    </a>
  </nav>

  <!-- User Card Footer -->
  <div class="p-4 border-t border-white/5">
    <div class="flex items-center justify-between p-2.5 rounded-xl bg-[#1a1c1e] border border-white/5">
      <div class="flex items-center gap-3 overflow-hidden">
        <img src="<%= user.avatar %>" alt="User avatar" class="w-8 h-8 rounded-full border border-[#1873d3]/40 object-cover flex-shrink-0">
        <div class="truncate">
          <p class="text-xs font-semibold text-white truncate"><%= user.username %></p>
          <span class="text-[10px] text-emerald-400 font-medium">Administrator</span>
        </div>
      </div>
      <a href="/logout" title="Sign Out" class="text-neutral-400 hover:text-red-400 transition-colors p-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
      </a>
    </div>
  </div>
</aside>

<!-- Mobile Top Header -->
<div class="lg:hidden fixed top-0 left-0 right-0 h-14 bg-[#101213]/90 backdrop-blur-xl border-b border-white/5 z-30 px-4 flex items-center justify-between">
  <a href="/dashboard" class="flex items-center gap-2">
    <img src="/images/logo.svg" alt="KineticGP Logo" class="h-6 w-auto">
    <span class="text-base font-bold text-white tracking-tight">Kinetic<span class="text-[#1873d3]">GP</span></span>
  </a>
  <div class="flex items-center gap-3">
    <img src="<%= user.avatar %>" alt="User avatar" class="w-7 h-7 rounded-full border border-[#1873d3]/40 object-cover">
    <a href="/logout" class="text-xs text-neutral-400 hover:text-red-400">Exit</a>
  </div>
</div>

<!-- Mobile Bottom Navigation Rail -->
<div class="lg:hidden fixed bottom-0 left-0 right-0 h-16 bg-[#101213]/95 backdrop-blur-xl border-t border-white/5 z-30 px-6 flex items-center justify-around">
  <a href="/dashboard" class="flex flex-col items-center gap-1 text-xs font-medium <%= path === '/dashboard' ? 'text-[#1873d3]' : 'text-neutral-400' %>">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
    Dashboard
  </a>
  <a href="/dashboard/profile" class="flex flex-col items-center gap-1 text-xs font-medium <%= path === '/dashboard/profile' ? 'text-[#1873d3]' : 'text-neutral-400' %>">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
    Profile
  </a>
  <a href="/" class="flex flex-col items-center gap-1 text-xs font-medium text-neutral-400">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
    Home
  </a>
</div>
