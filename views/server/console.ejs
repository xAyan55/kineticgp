<%- include('../layouts/header', { title: title }) %>

<div class="min-h-screen bg-[#101213] flex flex-col lg:flex-row">
  <%- include('../components/sidebar') %>

  <main class="flex-1 lg:pl-56 pt-16 lg:pt-0 pb-20 lg:pb-10 min-h-screen flex flex-col">
    <!-- Top Bar / Breadcrumb Navigation -->
    <header class="h-16 px-6 lg:px-10 border-b border-white/5 flex items-center justify-between bg-[#101213]/80 backdrop-blur-xl sticky top-0 z-20">
      <div class="flex items-center gap-2 text-sm text-neutral-400">
        <span class="text-white font-medium">Servers</span>
        <span>/</span>
        <span class="text-[#1873d3] font-medium"><%= server.name %></span>
        <span>/</span>
        <span class="text-neutral-300">Console</span>
      </div>

      <!-- ENTERPRISE SERVER CONTROLS TOOLBAR -->
      <div class="flex items-center gap-2">
        <% if (server.status === 'failed') { %>
          <form method="POST" action="/admin/servers/<%= server.id %>/retry" class="inline">
            <input type="hidden" name="_csrf" value="<%= _csrf %>">
            <button type="submit" class="py-1.5 px-3 rounded-xl bg-purple-500/20 hover:bg-purple-500/30 text-purple-300 border border-purple-500/40 text-xs font-semibold transition flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
              Retry Installation
            </button>
          </form>
        <% } else if (['installing', 'downloading', 'configuring', 'queued'].includes(server.status)) { %>
          <button disabled class="py-1.5 px-4 rounded-xl bg-purple-500/10 text-purple-400 border border-purple-500/30 text-xs font-semibold cursor-not-allowed opacity-80 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-purple-400 animate-pulse"></span>
            Installing Engine...
          </button>
        <% } else { %>
          <button id="startBtn" onclick="sendPowerAction(event, 'start')" <%= server.status === 'online' ? 'disabled' : '' %> class="py-1.5 px-3.5 rounded-xl <%= server.status === 'online' ? 'bg-neutral-800 text-neutral-500 border border-neutral-700 cursor-not-allowed' : 'bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 font-semibold' %> text-xs transition flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/></svg>
            Start
          </button>

          <button id="restartBtn" onclick="sendPowerAction(event, 'restart')" <%= server.status !== 'online' ? 'disabled' : '' %> class="py-1.5 px-3.5 rounded-xl <%= server.status !== 'online' ? 'bg-neutral-800 text-neutral-500 border border-neutral-700 cursor-not-allowed' : 'bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 border border-amber-500/30 font-semibold' %> text-xs transition flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
            Restart
          </button>

          <button id="stopBtn" onclick="sendPowerAction(event, 'stop')" <%= server.status !== 'online' ? 'disabled' : '' %> class="py-1.5 px-3.5 rounded-xl <%= server.status !== 'online' ? 'bg-neutral-800 text-neutral-500 border border-neutral-700 cursor-not-allowed' : 'bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/30 font-semibold' %> text-xs transition flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0zM9 10a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"/></svg>
            Stop
          </button>

          <button id="killBtn" onclick="sendPowerAction(event, 'kill')" title="Force Kill Process" <%= server.status !== 'online' ? 'disabled' : '' %> class="py-1.5 px-3 rounded-xl <%= server.status !== 'online' ? 'bg-neutral-800 text-neutral-500 border border-neutral-700 cursor-not-allowed' : 'bg-red-600/20 hover:bg-red-600/40 text-red-300 border border-red-500/40 font-semibold' %> text-xs transition">
            Kill
          </button>

          <a href="/dashboard/server/<%= server.uuid %>/settings" title="Server Settings" class="py-1.5 px-3 rounded-xl bg-white/5 hover:bg-white/10 text-neutral-300 border border-white/10 text-xs font-semibold transition">
            Settings
          </a>
        <% } %>
      </div>
    </header>

    <div class="p-6 lg:p-10 max-w-[1400px] w-full mx-auto space-y-6 flex-1">
      <!-- ENTERPRISE SERVER HEADER CARD -->
      <div class="kgp-card p-6 border-white/10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 bg-gradient-to-r from-[#141618] to-[#101213]">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-2xl bg-[#1873d3]/10 border border-[#1873d3]/30 flex items-center justify-center text-[#1873d3] font-bold text-xl flex-shrink-0">
            MC
          </div>
          <div>
            <div class="flex items-center gap-3">
              <h1 class="text-2xl font-extrabold text-white"><%= server.name %></h1>
              <% 
                let badgeStyle = 'bg-neutral-800 text-neutral-400 border-neutral-700';
                if (server.status === 'online') badgeStyle = 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30';
                else if (['installing', 'downloading', 'configuring', 'queued'].includes(server.status)) badgeStyle = 'bg-purple-500/10 text-purple-400 border-purple-500/30';
                else if (server.status === 'failed') badgeStyle = 'bg-red-500/10 text-red-400 border-red-500/30';
              %>
              <span id="headerStatusBadge" class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border <%= badgeStyle %>">
                <%= server.status %>
              </span>
            </div>
            <p class="text-xs text-neutral-400 font-mono mt-1">
              UUID: <%= server.uuid %> &bull; Owner: <%= server.owner_name || 'Administrator' %> &bull; Engine: <%= server.software %> <%= server.version %> (Java <%= server.java_version %>)
            </p>
          </div>
        </div>
      </div>

      <!-- LIVE INSTALLER PROGRESS & TIMELINE CARD (Only if Installing) -->
      <div id="installerSection" class="kgp-card p-6 border-purple-500/20 bg-purple-500/[0.02] <%= ['installing', 'downloading', 'configuring', 'queued'].includes(server.status) ? '' : 'hidden' %>">
        <div class="flex items-center justify-between border-b border-white/5 pb-4 mb-4">
          <div class="flex items-center gap-3">
            <span class="w-3 h-3 rounded-full bg-purple-400 animate-pulse"></span>
            <h3 class="text-base font-bold text-white">Background Provisioning Pipeline</h3>
          </div>
          <span id="installProgressSpeed" class="text-xs font-mono text-purple-400 font-bold">Downloading...</span>
        </div>

        <div class="space-y-4">
          <div>
            <div class="flex justify-between text-xs text-neutral-300 font-mono mb-1.5">
              <span id="installStepText">Downloading <%= server.software %> <%= server.version %> server.jar</span>
              <span id="installBytesText">Receiving jar...</span>
            </div>
            <div class="w-full h-2 rounded-full bg-neutral-900 overflow-hidden border border-white/5">
              <div id="installProgressBar" class="h-full bg-purple-500 rounded-full transition-all duration-300" style="width: 10%"></div>
            </div>
          </div>

          <!-- VERTICAL TIMELINE -->
          <div class="pt-2 grid grid-cols-2 md:grid-cols-4 gap-3 text-xs font-mono">
            <div class="p-2.5 rounded-xl bg-white/[0.02] border border-white/5 flex items-center gap-2 text-emerald-400">
              <span>✔</span> Server Record Created
            </div>
            <div class="p-2.5 rounded-xl bg-white/[0.02] border border-white/5 flex items-center gap-2 text-emerald-400">
              <span>✔</span> Directory & EULA
            </div>
            <div id="tlStep3" class="p-2.5 rounded-xl bg-white/[0.02] border border-white/5 flex items-center gap-2 text-purple-400">
              <span class="animate-spin">🌀</span> Downloading JAR
            </div>
            <div id="tlStep4" class="p-2.5 rounded-xl bg-white/[0.02] border border-white/5 flex items-center gap-2 text-neutral-500">
              <span>○</span> Java Engine Ready
            </div>
          </div>
        </div>
      </div>

      <!-- HONEST REAL-TIME METRICS CARDS -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Status -->
        <div class="kgp-card p-4">
          <span class="text-[10px] font-bold text-neutral-400 uppercase tracking-wider block">Status</span>
          <div class="flex items-center gap-2 mt-1">
            <% 
              let indicatorClass = 'bg-neutral-600';
              if (server.status === 'online') indicatorClass = 'bg-emerald-400 animate-pulse';
              else if (['installing', 'downloading', 'configuring', 'queued'].includes(server.status)) indicatorClass = 'bg-purple-400 animate-pulse';
              else if (server.status === 'failed') indicatorClass = 'bg-red-500';
            %>
            <span id="statusIndicator" class="w-2.5 h-2.5 rounded-full <%= indicatorClass %>"></span>
            <span id="statusText" class="text-lg font-bold text-white uppercase"><%= server.status %></span>
          </div>
        </div>

        <!-- CPU Load -->
        <div class="kgp-card p-4">
          <span class="text-[10px] font-bold text-neutral-400 uppercase tracking-wider block">CPU Load</span>
          <p id="cpuVal" class="text-sm font-bold text-white mt-1"><%= metrics.cpuText %></p>
          <div class="w-full h-1 bg-neutral-800 rounded-full mt-2 overflow-hidden">
            <div id="cpuBar" class="h-full bg-[#1873d3] rounded-full transition-all" style="width: <%= metrics.cpuVal %>%"></div>
          </div>
        </div>

        <!-- RAM Memory -->
        <div class="kgp-card p-4">
          <span class="text-[10px] font-bold text-neutral-400 uppercase tracking-wider block">RAM Memory</span>
          <p id="ramVal" class="text-sm font-bold text-white mt-1"><%= metrics.ramText %></p>
          <div class="w-full h-1 bg-neutral-800 rounded-full mt-2 overflow-hidden">
            <div id="ramBar" class="h-full bg-emerald-400 rounded-full transition-all" style="width: <%= metrics.isRunning ? Math.round((metrics.ramValMb / server.ram_limit) * 100) : 0 %>%"></div>
          </div>
        </div>

        <!-- Connection Address -->
        <div class="kgp-card p-4">
          <span class="text-[10px] font-bold text-neutral-400 uppercase tracking-wider block">Connection Address</span>
          <p class="text-sm font-bold font-mono text-emerald-400 mt-1 truncate">127.0.0.1:<%= server.port %></p>
          <span id="playersText" class="text-[10px] text-neutral-500 font-mono mt-1 block"><%= metrics.playersText %></span>
        </div>
      </div>

      <!-- LIVE REAL CONSOLE TERMINAL -->
      <div class="kgp-card p-4 sm:p-6 flex flex-col space-y-4 border-white/10 bg-[#0d0e0f]">
        <div class="flex items-center justify-between border-b border-white/5 pb-3">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-red-500"></span>
            <span class="w-3 h-3 rounded-full bg-amber-500"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
            <span class="text-xs font-mono text-neutral-400 ml-2">server@kineticgp:~ (UUID: <%= server.uuid %>)</span>
          </div>

          <div class="flex items-center gap-2">
            <button onclick="copyConsole()" class="text-xs text-neutral-400 hover:text-white px-2.5 py-1 rounded-md bg-white/5">Copy Console</button>
            <button onclick="clearConsole()" class="text-xs text-neutral-400 hover:text-white px-2.5 py-1 rounded-md bg-white/5">Clear</button>
            <button onclick="toggleAutoscroll()" id="scrollBtn" class="text-xs text-emerald-400 px-2.5 py-1 rounded-md bg-emerald-500/10">Autoscroll ON</button>
          </div>
        </div>

        <!-- TERMINAL OUTPUT STREAM -->
        <div id="consoleTerminal" class="h-[480px] overflow-y-auto font-mono text-xs text-neutral-200 bg-[#0a0b0c] p-4 rounded-xl border border-white/5 space-y-1 custom-scrollbar">
          <% if (logs.length === 0) { %>
            <p class="text-neutral-500">[System] Real-time log stream initialized. Waiting for process output...</p>
          <% } else { %>
            <% logs.forEach(function(line) { %>
              <div class="leading-relaxed hover:bg-white/[0.02] px-1 rounded"><%= line %></div>
            <% }); %>
          <% } %>
        </div>

        <!-- STDIN COMMAND INPUT -->
        <form id="commandForm" class="flex items-center gap-2 pt-2">
          <span class="text-neutral-500 font-mono text-sm pl-2">&gt;</span>
          <input type="text" id="cmdInput" <%= server.status !== 'online' ? 'disabled' : '' %> placeholder="<%= server.status === 'online' ? 'Type a server command (e.g. op username, list, say Hello)...' : 'Console input will become available once the server Java process is running.' %>" class="flex-1 px-3.5 py-2.5 rounded-xl bg-[#101213] border border-white/5 text-xs text-white font-mono focus:outline-none focus:border-[#1873d3] <%= server.status !== 'online' ? 'opacity-50 cursor-not-allowed' : '' %>">
          <button type="submit" <%= server.status !== 'online' ? 'disabled' : '' %> class="btn-primary text-xs px-5 py-2.5 <%= server.status !== 'online' ? 'opacity-50 cursor-not-allowed' : '' %>">Send</button>
        </form>
      </div>
    </div>
  </main>
</div>

<script>
  let autoscroll = true;
  const terminal = document.getElementById('consoleTerminal');

  function scrollToBottom() {
    if (autoscroll && terminal) {
      terminal.scrollTop = terminal.scrollHeight;
    }
  }

  function clearConsole() {
    terminal.innerHTML = '<p class="text-neutral-500">[Console cleared]</p>';
  }

  function copyConsole() {
    const text = terminal.innerText;
    navigator.clipboard.writeText(text).then(() => {
      alert('Console logs copied to clipboard!');
    });
  }

  function toggleAutoscroll() {
    autoscroll = !autoscroll;
    const btn = document.getElementById('scrollBtn');
    if (autoscroll) {
      btn.innerText = 'Autoscroll ON';
      btn.className = 'text-xs text-emerald-400 px-2.5 py-1 rounded-md bg-emerald-500/10';
      scrollToBottom();
    } else {
      btn.innerText = 'Autoscroll OFF';
      btn.className = 'text-xs text-neutral-400 px-2.5 py-1 rounded-md bg-white/5';
    }
  }

  scrollToBottom();

  // Dynamic Power Buttons UI State Synchronizer
  function updatePowerButtonsState(status) {
    const startBtn = document.getElementById('startBtn');
    const restartBtn = document.getElementById('restartBtn');
    const stopBtn = document.getElementById('stopBtn');
    const killBtn = document.getElementById('killBtn');

    if (!startBtn || !restartBtn || !stopBtn || !killBtn) return;

    if (status === 'online') {
      startBtn.disabled = true;
      startBtn.className = 'py-1.5 px-3.5 rounded-xl bg-neutral-800 text-neutral-500 border border-neutral-700 cursor-not-allowed text-xs transition flex items-center gap-1.5';

      restartBtn.disabled = false;
      restartBtn.className = 'py-1.5 px-3.5 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 border border-amber-500/30 font-semibold text-xs transition flex items-center gap-1.5';

      stopBtn.disabled = false;
      stopBtn.className = 'py-1.5 px-3.5 rounded-xl bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/30 font-semibold text-xs transition flex items-center gap-1.5';

      killBtn.disabled = false;
      killBtn.className = 'py-1.5 px-3 rounded-xl bg-red-600/20 hover:bg-red-600/40 text-red-300 border border-red-500/40 font-semibold text-xs transition';
    } else if (status === 'starting' || status === 'stopping') {
      startBtn.disabled = true;
      startBtn.className = 'py-1.5 px-3.5 rounded-xl bg-neutral-800 text-neutral-500 border border-neutral-700 cursor-not-allowed text-xs transition flex items-center gap-1.5';

      restartBtn.disabled = true;
      restartBtn.className = 'py-1.5 px-3.5 rounded-xl bg-neutral-800 text-neutral-500 border border-neutral-700 cursor-not-allowed text-xs transition flex items-center gap-1.5';

      stopBtn.disabled = true;
      stopBtn.className = 'py-1.5 px-3.5 rounded-xl bg-neutral-800 text-neutral-500 border border-neutral-700 cursor-not-allowed text-xs transition flex items-center gap-1.5';

      killBtn.disabled = false;
      killBtn.className = 'py-1.5 px-3 rounded-xl bg-red-600/20 hover:bg-red-600/40 text-red-300 border border-red-500/40 font-semibold text-xs transition';
    } else { // offline / failed
      startBtn.disabled = false;
      startBtn.className = 'py-1.5 px-3.5 rounded-xl bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 font-semibold text-xs transition flex items-center gap-1.5';

      restartBtn.disabled = true;
      restartBtn.className = 'py-1.5 px-3.5 rounded-xl bg-neutral-800 text-neutral-500 border border-neutral-700 cursor-not-allowed text-xs transition flex items-center gap-1.5';

      stopBtn.disabled = true;
      stopBtn.className = 'py-1.5 px-3.5 rounded-xl bg-neutral-800 text-neutral-500 border border-neutral-700 cursor-not-allowed text-xs transition flex items-center gap-1.5';

      killBtn.disabled = true;
      killBtn.className = 'py-1.5 px-3 rounded-xl bg-neutral-800 text-neutral-500 border border-neutral-700 cursor-not-allowed text-xs transition';
    }
  }

  // Async Power Action Handler
  async function sendPowerAction(e, action) {
    if (e) e.preventDefault();

    if (action === 'start') updatePowerButtonsState('starting');
    else if (action === 'stop') updatePowerButtonsState('stopping');

    try {
      const res = await fetch('/dashboard/server/<%= server.uuid %>/power', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-CSRF-Token': '<%= _csrf %>'
        },
        body: JSON.stringify({ action: action, _csrf: '<%= _csrf %>' })
      });
      const data = await res.json();
      if (data.status) {
        updatePowerButtonsState(data.status);
      }
      if (!data.success) {
        const line = document.createElement('div');
        line.className = 'leading-relaxed text-amber-400 font-bold px-1 rounded';
        line.innerText = '[System] ' + (data.message || 'Power action failed.');
        if (terminal) {
          terminal.appendChild(line);
          scrollToBottom();
        }
      }
    } catch (err) {
      console.error('Power action network error:', err);
    }
  }

  // STDIN Form
  document.getElementById('commandForm').addEventListener('submit', function(e) {
    e.preventDefault();
    const input = document.getElementById('cmdInput');
    const cmd = input.value.trim();
    if (!cmd) return;

    fetch('/dashboard/server/<%= server.uuid %>/command', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': '<%= _csrf %>'
      },
      body: JSON.stringify({ command: cmd, _csrf: '<%= _csrf %>' })
    }).then(() => {
      input.value = '';
    });
  });

  // Connect Real-Time SSE Stream
  const eventSource = new EventSource('/dashboard/server/<%= server.uuid %>/sse');

  eventSource.addEventListener('log', function(e) {
    const data = JSON.parse(e.data);
    if (data.message) {
      const line = document.createElement('div');
      line.className = 'leading-relaxed hover:bg-white/[0.02] px-1 rounded';
      line.innerText = data.message;
      terminal.appendChild(line);
      scrollToBottom();
    }
  });

  eventSource.addEventListener('progress', function(e) {
    const p = JSON.parse(e.data);
    const installerSec = document.getElementById('installerSection');

    if (p.step === 'ready') {
      if (installerSec) installerSec.classList.add('hidden');
      location.reload();
      return;
    }

    if (installerSec) installerSec.classList.remove('hidden');

    if (p.percent !== undefined) {
      document.getElementById('installProgressBar').style.width = p.percent + '%';
    }
    if (p.downloaded && p.total) {
      document.getElementById('installBytesText').innerText = p.downloaded + ' / ' + p.total;
    }
    if (p.speed) {
      document.getElementById('installProgressSpeed').innerText = p.speed;
    }
  });

  eventSource.addEventListener('metrics', function(e) {
    const m = JSON.parse(e.data);
    if (m) {
      document.getElementById('cpuVal').innerText = m.cpuText;
      document.getElementById('cpuBar').style.width = m.cpuVal + '%';
      document.getElementById('ramVal').innerText = m.ramText;
      document.getElementById('playersText').innerText = m.playersText;
      
      const statusText = document.getElementById('statusText');
      const statusInd = document.getElementById('statusIndicator');
      const badge = document.getElementById('headerStatusBadge');

      statusText.innerText = m.status;
      if (badge) badge.innerText = m.status;

      updatePowerButtonsState(m.status);

      if (m.status === 'online') {
        statusInd.className = 'w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse';
        if (badge) badge.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border bg-emerald-500/10 text-emerald-400 border-emerald-500/30';
      } else if (['installing', 'downloading', 'configuring', 'queued'].includes(m.status)) {
        statusInd.className = 'w-2.5 h-2.5 rounded-full bg-purple-400 animate-pulse';
        if (badge) badge.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border bg-purple-500/10 text-purple-400 border-purple-500/30';
      } else if (m.status === 'failed') {
        statusInd.className = 'w-2.5 h-2.5 rounded-full bg-red-500';
        if (badge) badge.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border bg-red-500/10 text-red-400 border-red-500/30';
      } else {
        statusInd.className = 'w-2.5 h-2.5 rounded-full bg-neutral-600';
        if (badge) badge.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border bg-neutral-800 text-neutral-400 border-neutral-700';
      }
    }
  });
</script>

<%- include('../layouts/footer', { script: null }) %>
