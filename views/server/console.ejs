<%- include('../layouts/header', { title: title }) %>

<div class="min-h-screen bg-[#101213] flex flex-col lg:flex-row">
  <%- include('../components/sidebar') %>

  <main class="flex-1 lg:pl-56 pt-16 lg:pt-0 pb-20 lg:pb-10 min-h-screen flex flex-col">
    <!-- Top Bar / Breadcrumb Navigation -->
    <header class="h-16 px-6 lg:px-10 border-b border-white/5 flex items-center justify-between bg-[#101213]/80 backdrop-blur-xl sticky top-0 z-20">
      <div class="flex items-center gap-2 text-sm text-neutral-400">
        <span class="text-white font-medium">Servers</span>
        <span>/</span>
        <span class="text-[#1873d3] font-medium"><%= server.name %></span>
        <span>/</span>
        <span class="text-neutral-300">Console</span>
      </div>

      <!-- POWER CONTROL BUTTONS & RETRY INSTALL -->
      <div class="flex items-center gap-2">
        <% if (server.status === 'failed') { %>
          <form method="POST" action="/admin/servers/<%= server.id %>/retry" class="inline">
            <input type="hidden" name="_csrf" value="<%= _csrf %>">
            <button type="submit" class="py-1.5 px-3 rounded-xl bg-purple-500/20 hover:bg-purple-500/30 text-purple-300 border border-purple-500/40 text-xs font-semibold transition flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
              Retry Installation
            </button>
          </form>
        <% } else if (['installing', 'downloading', 'configuring'].includes(server.status)) { %>
          <button disabled class="py-1.5 px-4 rounded-xl bg-purple-500/10 text-purple-400 border border-purple-500/30 text-xs font-semibold cursor-not-allowed opacity-80 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-purple-400 animate-pulse"></span>
            Installing Engine...
          </button>
        <% } else { %>
          <form method="POST" action="/dashboard/server/<%= server.uuid %>/power" class="inline">
            <input type="hidden" name="_csrf" value="<%= _csrf %>">
            <input type="hidden" name="action" value="start">
            <button id="startBtn" type="submit" class="py-1.5 px-3 rounded-xl bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 text-xs font-semibold transition flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/></svg>
              Start
            </button>
          </form>

          <form method="POST" action="/dashboard/server/<%= server.uuid %>/power" class="inline">
            <input type="hidden" name="_csrf" value="<%= _csrf %>">
            <input type="hidden" name="action" value="restart">
            <button type="submit" class="py-1.5 px-3 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 border border-amber-500/30 text-xs font-semibold transition flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
              Restart
            </button>
          </form>

          <form method="POST" action="/dashboard/server/<%= server.uuid %>/power" class="inline">
            <input type="hidden" name="_csrf" value="<%= _csrf %>">
            <input type="hidden" name="action" value="stop">
            <button type="submit" class="py-1.5 px-3 rounded-xl bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/30 text-xs font-semibold transition flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0zM9 10a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"/></svg>
              Stop
            </button>
          </form>

          <form method="POST" action="/dashboard/server/<%= server.uuid %>/power" class="inline">
            <input type="hidden" name="_csrf" value="<%= _csrf %>">
            <input type="hidden" name="action" value="kill">
            <button type="submit" title="Force Kill Process" class="py-1.5 px-3 rounded-xl bg-red-600/20 hover:bg-red-600/40 text-red-300 border border-red-500/40 text-xs font-semibold transition">
              Kill
            </button>
          </form>
        <% } %>
      </div>
    </header>

    <div class="p-6 lg:p-10 max-w-[1400px] w-full mx-auto space-y-6 flex-1">
      <!-- LIVE TELEMETRY CARDS -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Status Card -->
        <div class="kgp-card p-4">
          <span class="text-[10px] font-bold text-neutral-400 uppercase tracking-wider block">Status</span>
          <div class="flex items-center gap-2 mt-1">
            <% 
              let indicatorClass = 'bg-neutral-600';
              if (server.status === 'online') indicatorClass = 'bg-emerald-400 animate-pulse';
              else if (['installing', 'downloading', 'configuring'].includes(server.status)) indicatorClass = 'bg-purple-400 animate-pulse';
              else if (server.status === 'failed') indicatorClass = 'bg-red-500';
            %>
            <span id="statusIndicator" class="w-2.5 h-2.5 rounded-full <%= indicatorClass %>"></span>
            <span id="statusText" class="text-lg font-bold text-white uppercase"><%= server.status %></span>
          </div>
        </div>

        <!-- CPU Card -->
        <div class="kgp-card p-4">
          <span class="text-[10px] font-bold text-neutral-400 uppercase tracking-wider block">CPU Load</span>
          <p id="cpuVal" class="text-lg font-bold text-white mt-1"><%= metrics.cpu %>%</p>
          <div class="w-full h-1 bg-neutral-800 rounded-full mt-2 overflow-hidden">
            <div id="cpuBar" class="h-full bg-[#1873d3] rounded-full transition-all" style="width: <%= metrics.cpu %>%"></div>
          </div>
        </div>

        <!-- Memory Card -->
        <div class="kgp-card p-4">
          <span class="text-[10px] font-bold text-neutral-400 uppercase tracking-wider block">RAM Memory</span>
          <p id="ramVal" class="text-lg font-bold text-white mt-1"><%= (metrics.ram / 1024).toFixed(1) %> <span class="text-xs text-neutral-400 font-normal">/ <%= (server.ram_limit / 1024).toFixed(1) %> GB</span></p>
          <div class="w-full h-1 bg-neutral-800 rounded-full mt-2 overflow-hidden">
            <div id="ramBar" class="h-full bg-emerald-400 rounded-full transition-all" style="width: <%= Math.round((metrics.ram / server.ram_limit) * 100) %>%"></div>
          </div>
        </div>

        <!-- Address Card -->
        <div class="kgp-card p-4">
          <span class="text-[10px] font-bold text-neutral-400 uppercase tracking-wider block">Connection Address</span>
          <p class="text-sm font-bold font-mono text-emerald-400 mt-1 truncate">127.0.0.1:<%= server.port %></p>
          <span class="text-[10px] text-neutral-500 font-mono mt-1 block"><%= server.software %> <%= server.version %></span>
        </div>
      </div>

      <!-- LIVE CONSOLE TERMINAL -->
      <div class="kgp-card p-4 sm:p-6 flex flex-col space-y-4 border-white/10 bg-[#0d0e0f]">
        <div class="flex items-center justify-between border-b border-white/5 pb-3">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-red-500"></span>
            <span class="w-3 h-3 rounded-full bg-amber-500"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
            <span class="text-xs font-mono text-neutral-400 ml-2">server@kineticgp:~ (UUID: <%= server.uuid %>)</span>
          </div>

          <div class="flex items-center gap-2">
            <button onclick="clearConsole()" class="text-xs text-neutral-400 hover:text-white px-2.5 py-1 rounded-md bg-white/5">Clear</button>
            <button onclick="toggleAutoscroll()" id="scrollBtn" class="text-xs text-emerald-400 px-2.5 py-1 rounded-md bg-emerald-500/10">Autoscroll ON</button>
          </div>
        </div>

        <!-- TERMINAL OUTPUT -->
        <div id="consoleTerminal" class="h-[480px] overflow-y-auto font-mono text-xs text-neutral-200 bg-[#0a0b0c] p-4 rounded-xl border border-white/5 space-y-1 custom-scrollbar">
          <% if (logs.length === 0) { %>
            <p class="text-neutral-500">[KineticGP Console] Real-time log stream initialized. Waiting for process output...</p>
          <% } else { %>
            <% logs.forEach(function(line) { %>
              <div class="leading-relaxed hover:bg-white/[0.02] px-1 rounded"><%= line %></div>
            <% }); %>
          <% } %>
        </div>

        <!-- STDIN COMMAND INPUT -->
        <form id="commandForm" class="flex items-center gap-2 pt-2">
          <span class="text-neutral-500 font-mono text-sm pl-2">&gt;</span>
          <input type="text" id="cmdInput" placeholder="Type a server command (e.g. op username, list, say Hello)..." class="flex-1 px-3.5 py-2.5 rounded-xl bg-[#101213] border border-white/5 text-xs text-white font-mono focus:outline-none focus:border-[#1873d3]">
          <button type="submit" class="btn-primary text-xs px-5 py-2.5">Send</button>
        </form>
      </div>
    </div>
  </main>
</div>

<script>
  let autoscroll = true;
  const terminal = document.getElementById('consoleTerminal');

  function scrollToBottom() {
    if (autoscroll && terminal) {
      terminal.scrollTop = terminal.scrollHeight;
    }
  }

  function clearConsole() {
    terminal.innerHTML = '<p class="text-neutral-500">[Console cleared]</p>';
  }

  function toggleAutoscroll() {
    autoscroll = !autoscroll;
    const btn = document.getElementById('scrollBtn');
    if (autoscroll) {
      btn.innerText = 'Autoscroll ON';
      btn.className = 'text-xs text-emerald-400 px-2.5 py-1 rounded-md bg-emerald-500/10';
      scrollToBottom();
    } else {
      btn.innerText = 'Autoscroll OFF';
      btn.className = 'text-xs text-neutral-400 px-2.5 py-1 rounded-md bg-white/5';
    }
  }

  // Initial scroll
  scrollToBottom();

  // Send Command via AJAX
  document.getElementById('commandForm').addEventListener('submit', function(e) {
    e.preventDefault();
    const input = document.getElementById('cmdInput');
    const cmd = input.value.trim();
    if (!cmd) return;

    fetch('/dashboard/server/<%= server.uuid %>/command', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': '<%= _csrf %>'
      },
      body: JSON.stringify({ command: cmd, _csrf: '<%= _csrf %>' })
    }).then(() => {
      input.value = '';
    });
  });

  // Connect SSE for Live Console Logs & Telemetry
  const eventSource = new EventSource('/dashboard/server/<%= server.uuid %>/sse');

  eventSource.addEventListener('log', function(e) {
    const data = JSON.parse(e.data);
    if (data.message) {
      const line = document.createElement('div');
      line.className = 'leading-relaxed hover:bg-white/[0.02] px-1 rounded';
      line.innerText = data.message;
      terminal.appendChild(line);
      scrollToBottom();
    }
  });

  eventSource.addEventListener('metrics', function(e) {
    const m = JSON.parse(e.data);
    if (m) {
      document.getElementById('cpuVal').innerText = m.cpu + '%';
      document.getElementById('cpuBar').style.width = m.cpu + '%';
      document.getElementById('ramVal').innerHTML = (m.ram / 1024).toFixed(1) + ' <span class="text-xs text-neutral-400 font-normal">/ <%= (server.ram_limit / 1024).toFixed(1) %> GB</span>';
      document.getElementById('ramBar').style.width = Math.round((m.ram / <%= server.ram_limit %>) * 100) + '%';
      
      const statusText = document.getElementById('statusText');
      const statusInd = document.getElementById('statusIndicator');
      statusText.innerText = m.status;

      if (m.status === 'online') {
        statusInd.className = 'w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse';
      } else if (['installing', 'downloading', 'configuring'].includes(m.status)) {
        statusInd.className = 'w-2.5 h-2.5 rounded-full bg-purple-400 animate-pulse';
      } else if (m.status === 'failed') {
        statusInd.className = 'w-2.5 h-2.5 rounded-full bg-red-500';
      } else {
        statusInd.className = 'w-2.5 h-2.5 rounded-full bg-neutral-600';
      }
    }
  });
</script>

<%- include('../layouts/footer', { script: null }) %>
