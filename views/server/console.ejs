<%- include('../layouts/header', { title: title }) %>

<div class="min-h-screen lg:h-screen bg-[#141414] flex flex-col lg:flex-row overflow-x-hidden lg:overflow-hidden">
  <%- include('../components/sidebar') %>

  <main class="flex-1 lg:pl-56 pt-16 lg:pt-0 flex flex-col min-w-0 overflow-y-auto lg:overflow-hidden">
    <!-- Top Bar / Breadcrumb Navigation & Power Toolbar -->
    <header class="h-16 px-4 lg:px-8 border-b border-white/10 flex items-center justify-between bg-[#141414]/80 backdrop-blur-xl sticky top-0 z-20 flex-shrink-0">
      <div class="flex items-center gap-2 text-xs sm:text-sm text-neutral-400 truncate">
        <span class="text-white font-medium">Servers</span>
        <span>/</span>
        <span class="text-white font-semibold truncate"><%= server.name %></span>
        <span>/</span>
        <span class="text-neutral-400">Console</span>
      </div>

      <!-- POWER CONTROLS TOOLBAR -->
      <div class="flex items-center gap-1.5">
        <% if (server.status === 'failed') { %>
          <form method="POST" action="/admin/servers/<%= server.id %>/retry" class="inline">
            <input type="hidden" name="_csrf" value="<%= _csrf %>">
            <button type="submit" class="py-1.5 px-3 rounded-lg bg-purple-500/20 hover:bg-purple-500/30 text-purple-300 border border-purple-500/40 text-xs font-semibold transition flex items-center gap-1.5">
              Retry
            </button>
          </form>
        <% } else if (['installing', 'downloading', 'configuring', 'queued'].includes(server.status)) { %>
          <button disabled class="py-1.5 px-3 rounded-lg bg-purple-500/10 text-purple-400 border border-purple-500/30 text-xs font-semibold cursor-not-allowed opacity-80 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-purple-400 animate-pulse"></span>
            Installing...
          </button>
        <% } else { %>
          <button id="startBtn" onclick="sendPowerAction(event, 'start')" <%= server.status === 'online' ? 'disabled' : '' %> class="py-1.5 px-3 rounded-lg <%= server.status === 'online' ? 'bg-neutral-800 text-neutral-500 border border-neutral-700 cursor-not-allowed' : 'bg-[#3FB950]/10 hover:bg-[#3FB950]/20 text-[#3FB950] border border-[#3FB950]/30 font-semibold' %> text-xs transition flex items-center gap-1">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/></svg>
            Start
          </button>

          <button id="restartBtn" onclick="sendPowerAction(event, 'restart')" <%= server.status !== 'online' ? 'disabled' : '' %> class="py-1.5 px-3 rounded-lg <%= server.status !== 'online' ? 'bg-neutral-800 text-neutral-500 border border-neutral-700 cursor-not-allowed' : 'bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 border border-amber-500/30 font-semibold' %> text-xs transition flex items-center gap-1">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
            Restart
          </button>

          <button id="stopBtn" onclick="sendPowerAction(event, 'stop')" <%= server.status !== 'online' ? 'disabled' : '' %> class="py-1.5 px-3 rounded-lg <%= server.status !== 'online' ? 'bg-neutral-800 text-neutral-500 border border-neutral-700 cursor-not-allowed' : 'bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/30 font-semibold' %> text-xs transition flex items-center gap-1">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0zM9 10a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"/></svg>
            Stop
          </button>

          <button id="killBtn" onclick="sendPowerAction(event, 'kill')" title="Force Kill" <%= server.status !== 'online' ? 'disabled' : '' %> class="py-1.5 px-2.5 rounded-lg <%= server.status !== 'online' ? 'bg-neutral-800 text-neutral-500 border border-neutral-700 cursor-not-allowed' : 'bg-red-600/20 hover:bg-red-600/40 text-red-300 border border-red-500/40 font-semibold' %> text-xs transition">
            Kill
          </button>

          <a href="/dashboard/server/<%= server.uuid %>/settings" title="Settings" class="py-1.5 px-2.5 rounded-lg bg-white/5 hover:bg-white/10 text-neutral-300 border border-white/10 text-xs font-semibold transition">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </a>
        <% } %>
      </div>
    </header>

    <div class="px-4 lg:px-6 py-4 max-w-[1700px] w-full mx-auto flex-1 flex flex-col min-h-0 overflow-y-auto lg:overflow-hidden gap-4">

      <!-- LIVE INSTALLER PROGRESS (Only if Installing) -->
      <div id="installerSection" class="kgp-card p-4 border-purple-500/20 bg-purple-500/[0.02] flex-shrink-0 <%= ['installing', 'downloading', 'configuring', 'queued'].includes(server.status) ? '' : 'hidden' %>">
        <div class="flex items-center justify-between border-b border-white/5 pb-2 mb-2">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-purple-400 animate-pulse"></span>
            <h3 class="text-xs font-bold text-white uppercase tracking-wider">Provisioning Server Engine</h3>
          </div>
          <span id="installProgressSpeed" class="text-xs font-mono text-purple-400 font-bold">Downloading...</span>
        </div>
        <div>
          <div class="flex justify-between text-xs text-neutral-300 font-mono mb-1">
            <span id="installStepText">Downloading <%= server.software %> <%= server.version %> server.jar</span>
            <span id="installBytesText">Receiving jar...</span>
          </div>
          <div class="w-full h-1.5 rounded-full bg-neutral-900 overflow-hidden border border-white/5">
            <div id="installProgressBar" class="h-full bg-purple-500 rounded-full transition-all duration-300" style="width: 10%"></div>
          </div>
        </div>
      </div>

      <!-- MAIN LAYOUT GRID (75% Left Terminal, 25% Right Metrics Stack) -->
      <div class="flex-1 grid grid-cols-1 lg:grid-cols-12 gap-4 min-h-0 overflow-hidden">
        
        <!-- LEFT COLUMN: CONSOLE TERMINAL CARD (75% / col-span-8 or 9) -->
        <div class="lg:col-span-8 xl:col-span-9 flex flex-col bg-[#0d0e0f] rounded-xl border border-white/[0.06] overflow-hidden min-h-[480px] lg:min-h-0">
          
          <!-- Terminal Top Header -->
          <div class="flex items-center justify-between px-4 py-2.5 border-b border-white/5 flex-shrink-0 bg-[#141618]/50">
            <div class="flex items-center gap-2">
              <span class="text-xs font-medium text-neutral-400 tracking-wide">console</span>
              <span id="connectionDot" class="w-2 h-2 rounded-full bg-emerald-400 ml-2"></span>
              <span id="connectionText" class="text-[11px] text-emerald-400/80 font-mono">Connected</span>
            </div>

            <div class="flex items-center gap-2">
              <button onclick="loadRecentLogs()" id="loadLogsBtn" class="text-xs text-neutral-400 hover:text-white px-2.5 py-1 rounded bg-white/5 hover:bg-white/10 border border-white/5 transition flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                <span>Load recent logs</span>
              </button>
              <button onclick="clearConsole()" class="text-xs text-neutral-400 hover:text-white px-2 py-1 rounded hover:bg-white/5 transition">Clear</button>
              <button onclick="copyConsole()" class="text-xs text-neutral-400 hover:text-white px-2 py-1 rounded hover:bg-white/5 transition">Copy</button>
              <button onclick="toggleAutoscroll()" id="scrollBtn" class="text-xs text-emerald-400 px-2 py-1 rounded bg-emerald-500/10 hover:bg-emerald-500/15 transition">⇊ Auto</button>
            </div>
          </div>

          <!-- Terminal Output Viewport -->
          <div id="consoleTerminal" class="flex-1 overflow-y-auto px-4 py-3 min-h-0 relative" style="font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', 'Consolas', monospace; font-size: 12px; line-height: 1.65;">
            <% if (logs.length === 0) { %>
              <div id="emptyLogPrompt" class="text-neutral-600 font-mono">[System] Real-time console stream initialized. Waiting for process output...</div>
            <% } else { %>
              <% logs.forEach(function(line) { %>
                <div class="console-line hover:bg-white/[0.015] rounded-sm px-1 -mx-1"><%= line %></div>
              <% }); %>
            <% } %>
          </div>

          <!-- Jump to Latest Button -->
          <div id="jumpToLatest" class="hidden absolute bottom-20 left-1/2 -translate-x-1/2 z-10">
            <button onclick="jumpToBottom()" class="px-3 py-1.5 rounded-full bg-[#2F81F7] text-white text-[11px] font-semibold shadow-lg shadow-black/40 hover:bg-[#58A6FF] transition flex items-center gap-1">
              ↓ Jump to latest
            </button>
          </div>

          <!-- Command Input Bar -->
          <div class="border-t border-[#30363D] flex-shrink-0 bg-[#21262D]">
            <form id="commandForm" class="flex items-center">
              <span class="text-neutral-600 pl-4 text-sm font-mono">&gt;</span>
              <input type="text" id="cmdInput" <%= server.status !== 'online' ? 'disabled' : '' %> placeholder="<%= server.status === 'online' ? 'Type a command...' : 'Server is offline' %>" class="flex-1 px-3 py-3 bg-transparent text-neutral-200 text-xs focus:outline-none placeholder-neutral-600 disabled:opacity-40 disabled:cursor-not-allowed font-mono">
              <button type="submit" id="cmdSendBtn" <%= server.status !== 'online' ? 'disabled' : '' %> class="px-4 py-3 text-xs font-semibold text-[#2F81F7] hover:text-white hover:bg-[#2F81F7]/20 transition disabled:opacity-30 disabled:cursor-not-allowed font-mono">Send</button>
            </form>
          </div>
        </div>

        <!-- RIGHT COLUMN: 5 STACKED METRIC CARDS (25% / col-span-4 or 3) -->
        <div class="lg:col-span-4 xl:col-span-3 flex flex-col gap-3 overflow-y-auto pr-0.5">

          <!-- CARD 1: IP ADDRESS -->
          <div class="bg-[#161B22] rounded-xl border border-[#30363D] p-4 flex flex-col justify-between relative">
            <div class="flex items-center justify-between">
              <span class="text-xs text-[#8B949E] font-medium">IP Address:</span>
              <button onclick="copyIpAddress()" title="Copy Address" class="p-1 rounded hover:bg-white/5 text-[#8B949E] hover:text-white transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
              </button>
            </div>
            <div class="mt-2">
              <span id="cardAddressText" class="text-base font-bold font-mono text-white tracking-tight"><%= metrics.address %></span>
            </div>
          </div>

          <!-- CARD 2: STATUS -->
          <div class="bg-[#161B22] rounded-xl border border-[#30363D] p-4 flex flex-col justify-between">
            <div class="flex items-center justify-between">
              <span class="text-xs text-[#8B949E] font-medium">Status:</span>
              <button onclick="loadRecentLogs()" class="text-xs text-[#2F81F7] hover:underline font-medium">Open logs</button>
            </div>
            <div class="mt-2 flex items-center gap-2">
              <%
                let statusColor = 'text-[#8B949E]';
                if (server.status === 'online') statusColor = 'text-[#3FB950]';
                else if (server.status === 'offline') statusColor = 'text-[#F85149]';
                else if (['installing', 'downloading', 'configuring'].includes(server.status)) statusColor = 'text-purple-400';
                else if (['starting', 'stopping'].includes(server.status)) statusColor = 'text-amber-400';
              %>
              <span id="cardStatusBadge" class="text-lg font-bold uppercase tracking-wide <%= statusColor %>"><%= server.status %></span>
            </div>
          </div>

          <!-- CARD 3: RAM USAGE -->
          <div class="bg-[#161B22] rounded-xl border border-[#30363D] p-4 flex flex-col justify-between">
            <span class="text-xs text-[#8B949E] font-medium">RAM Usage:</span>
            <div class="mt-2">
              <p id="cardRamText" class="text-sm font-bold text-white font-mono">
                <% if (metrics.memory && metrics.memory.usedBytes !== null) { %>
                  <%= metrics.memory.percent %>% (<%= (metrics.memory.usedBytes / (1024*1024)).toFixed(0) %> MB / <%= (metrics.memory.limitBytes / (1024*1024*1024)).toFixed(1) %> GB)
                <% } else { %>
                  Unavailable
                <% } %>
              </p>
              <div class="w-full h-1.5 bg-[#0D1117] rounded-full mt-2 overflow-hidden border border-[#30363D]">
                <div id="cardRamBar" class="h-full bg-[#2F81F7] rounded-full transition-all duration-300" style="width: <%= (metrics.memory && metrics.memory.percent) || 0 %>%"></div>
              </div>
            </div>
          </div>

          <!-- CARD 4: CPU USAGE -->
          <div class="bg-[#161B22] rounded-xl border border-[#30363D] p-4 flex flex-col justify-between">
            <span class="text-xs text-[#8B949E] font-medium">CPU Usage:</span>
            <div class="mt-2">
              <p id="cardCpuText" class="text-sm font-bold text-white font-mono">
                <% if (metrics.cpu && metrics.cpu.percent !== null) { %>
                  <%= metrics.cpu.percent %>% of <%= metrics.cpu.cores.toFixed(1) %> cores
                <% } else { %>
                  Unavailable
                <% } %>
              </p>
              <div class="w-full h-1.5 bg-[#0D1117] rounded-full mt-2 overflow-hidden border border-[#30363D]">
                <div id="cardCpuBar" class="h-full bg-[#3FB950] rounded-full transition-all duration-300" style="width: <%= (metrics.cpu && metrics.cpu.percent) || 0 %>%"></div>
              </div>
            </div>
          </div>

          <!-- CARD 5: DISK USAGE -->
          <div class="bg-[#161B22] rounded-xl border border-[#30363D] p-4 flex flex-col justify-between">
            <span class="text-xs text-[#8B949E] font-medium">Disk Usage:</span>
            <div class="mt-2">
              <p id="cardDiskText" class="text-sm font-bold text-white font-mono">
                <% if (metrics.disk && metrics.disk.usedBytes !== null) { %>
                  <%= metrics.disk.percent !== null ? metrics.disk.percent + '%' : '' %> (<%= (metrics.disk.usedBytes / (1024*1024)).toFixed(1) %> MB / <%= metrics.disk.limitBytes ? (metrics.disk.limitBytes / (1024*1024*1024)).toFixed(0) + ' GB' : 'No Limit' %>)
                <% } else { %>
                  Unavailable
                <% } %>
              </p>
              <div class="w-full h-1.5 bg-[#0D1117] rounded-full mt-2 overflow-hidden border border-[#30363D]">
                <div id="cardDiskBar" class="h-full bg-purple-400 rounded-full transition-all duration-300" style="width: <%= (metrics.disk && metrics.disk.percent) || 0 %>%"></div>
              </div>
            </div>
          </div>

        </div>

      </div>
    </div>
  </main>
</div>

<!-- Toast Notification -->
<div id="toast" class="fixed bottom-6 right-6 z-50 hidden">
  <div class="bg-[#1a1c1e] border border-white/10 rounded-lg px-4 py-2.5 text-xs text-neutral-300 shadow-xl shadow-black/40 flex items-center gap-2">
    <span id="toastText"></span>
  </div>
</div>

<style>
  #consoleTerminal::-webkit-scrollbar { width: 6px; }
  #consoleTerminal::-webkit-scrollbar-track { background: transparent; }
  #consoleTerminal::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.08); border-radius: 3px; }
  #consoleTerminal::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.15); }
</style>

<script>
  const SERVER_UUID = '<%= server.uuid %>';
  const CSRF_TOKEN = '<%= _csrf %>';
  const MAX_DOM_LINES = 3000;

  let autoscroll = true;
  let seenEventIds = new Set();
  const terminal = document.getElementById('consoleTerminal');
  const jumpBtn = document.getElementById('jumpToLatest');

  // ── Byte Formatter Helper ──
  function formatBytes(bytes) {
    if (bytes === null || bytes === undefined || isNaN(bytes)) return 'Unavailable';
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB', 'GB', 'TB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return (bytes / Math.pow(k, i)).toFixed(i >= 3 ? 1 : 0) + ' ' + sizes[i];
  }

  // ── Auto-scroll detection ──
  function isNearBottom() {
    if (!terminal) return true;
    return (terminal.scrollHeight - terminal.scrollTop - terminal.clientHeight) < 60;
  }

  function scrollToBottom() {
    if (autoscroll && terminal) {
      terminal.scrollTop = terminal.scrollHeight;
    }
  }

  terminal.addEventListener('scroll', () => {
    if (isNearBottom()) {
      autoscroll = true;
      jumpBtn.classList.add('hidden');
    } else {
      autoscroll = false;
      jumpBtn.classList.remove('hidden');
    }
  });

  function jumpToBottom() {
    autoscroll = true;
    terminal.scrollTop = terminal.scrollHeight;
    jumpBtn.classList.add('hidden');
    updateScrollBtn();
  }

  function toggleAutoscroll() {
    autoscroll = !autoscroll;
    updateScrollBtn();
    if (autoscroll) {
      terminal.scrollTop = terminal.scrollHeight;
      jumpBtn.classList.add('hidden');
    }
  }

  function updateScrollBtn() {
    const btn = document.getElementById('scrollBtn');
    if (autoscroll) {
      btn.innerText = '⇊ Auto';
      btn.className = 'text-xs text-emerald-400 px-2 py-1 rounded bg-emerald-500/10 hover:bg-emerald-500/15 transition';
    } else {
      btn.innerText = '⇊ Off';
      btn.className = 'text-xs text-neutral-500 px-2 py-1 rounded bg-white/5 hover:bg-white/10 transition';
    }
  }

  // ── Console line rendering ──
  function getLineClass(line, type) {
    if (type === 'command') return 'text-cyan-400';
    if (type === 'system') return 'text-[#2F81F7]';
    if (type === 'stderr') return 'text-amber-400';
    if (/\bERROR\b/i.test(line)) return 'text-[#F85149]';
    if (/\bWARN/i.test(line)) return 'text-amber-400/90';
    if (/\[System\]/i.test(line)) return 'text-[#2F81F7]';
    return 'text-neutral-300';
  }

  function appendConsoleLine(line, type) {
    const emptyPrompt = document.getElementById('emptyLogPrompt');
    if (emptyPrompt) emptyPrompt.remove();

    const div = document.createElement('div');
    div.className = 'console-line hover:bg-white/[0.015] rounded-sm px-1 -mx-1 ' + getLineClass(line, type);
    div.textContent = line;
    terminal.appendChild(div);

    while (terminal.children.length > MAX_DOM_LINES) {
      terminal.removeChild(terminal.firstChild);
    }

    scrollToBottom();
  }

  // ── Load Recent Logs Action ──
  async function loadRecentLogs() {
    const loadLogsBtn = document.getElementById('loadLogsBtn');
    try {
      if (loadLogsBtn) loadLogsBtn.disabled = true;
      const res = await fetch(`/dashboard/server/${SERVER_UUID}/recent-logs`);
      const data = await res.json();
      if (data.success && data.logs) {
        terminal.innerHTML = '';
        data.logs.forEach(evt => {
          appendConsoleLine(evt.line, evt.type);
        });
        showToast('Recent logs reloaded.');
      } else {
        showToast('No logs available.');
      }
    } catch {
      showToast('Failed to load recent logs.');
    } finally {
      if (loadLogsBtn) loadLogsBtn.disabled = false;
    }
  }

  // ── Copy Helpers ──
  function clearConsole() {
    terminal.innerHTML = '<div class="text-neutral-600 font-mono">[Console view cleared]</div>';
    showToast('Console view cleared');
  }

  function copyConsole() {
    const text = terminal.innerText;
    navigator.clipboard.writeText(text).then(() => {
      showToast('Console copied to clipboard');
    }).catch(() => {
      showToast('Failed to copy');
    });
  }

  function copyIpAddress() {
    const addr = document.getElementById('cardAddressText').innerText;
    navigator.clipboard.writeText(addr).then(() => {
      showToast('IP address copied to clipboard');
    }).catch(() => {
      showToast('Failed to copy IP');
    });
  }

  function showToast(msg) {
    const toast = document.getElementById('toast');
    const toastText = document.getElementById('toastText');
    toastText.textContent = msg;
    toast.classList.remove('hidden');
    setTimeout(() => toast.classList.add('hidden'), 2500);
  }

  scrollToBottom();

  // ── Power Buttons State ──
  function updatePowerButtonsState(status) {
    const startBtn = document.getElementById('startBtn');
    const restartBtn = document.getElementById('restartBtn');
    const stopBtn = document.getElementById('stopBtn');
    const killBtn = document.getElementById('killBtn');
    const cmdInput = document.getElementById('cmdInput');
    const cmdSendBtn = document.getElementById('cmdSendBtn');

    if (!startBtn || !restartBtn || !stopBtn || !killBtn) return;

    const disabledCls = 'py-1.5 px-3 rounded-lg bg-neutral-800 text-neutral-500 border border-neutral-700 cursor-not-allowed text-xs transition flex items-center gap-1';
    const killDisabledCls = 'py-1.5 px-2.5 rounded-lg bg-neutral-800 text-neutral-500 border border-neutral-700 cursor-not-allowed text-xs transition';

    if (status === 'online') {
      startBtn.disabled = true; startBtn.className = disabledCls;
      restartBtn.disabled = false; restartBtn.className = 'py-1.5 px-3 rounded-lg bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 border border-amber-500/30 font-semibold text-xs transition flex items-center gap-1';
      stopBtn.disabled = false; stopBtn.className = 'py-1.5 px-3 rounded-lg bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/30 font-semibold text-xs transition flex items-center gap-1';
      killBtn.disabled = false; killBtn.className = 'py-1.5 px-2.5 rounded-lg bg-red-600/20 hover:bg-red-600/40 text-red-300 border border-red-500/40 font-semibold text-xs transition';
      if (cmdInput) { cmdInput.disabled = false; cmdInput.placeholder = 'Type a command...'; }
      if (cmdSendBtn) cmdSendBtn.disabled = false;
    } else if (status === 'starting' || status === 'stopping') {
      startBtn.disabled = true; startBtn.className = disabledCls;
      restartBtn.disabled = true; restartBtn.className = disabledCls;
      stopBtn.disabled = status === 'stopping'; stopBtn.className = status === 'stopping' ? disabledCls : 'py-1.5 px-3 rounded-lg bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/30 font-semibold text-xs transition flex items-center gap-1';
      killBtn.disabled = false; killBtn.className = 'py-1.5 px-2.5 rounded-lg bg-red-600/20 hover:bg-red-600/40 text-red-300 border border-red-500/40 font-semibold text-xs transition';
      if (cmdInput) { cmdInput.disabled = true; cmdInput.placeholder = status === 'starting' ? 'Server is starting...' : 'Server is stopping...'; }
      if (cmdSendBtn) cmdSendBtn.disabled = true;
    } else {
      startBtn.disabled = false; startBtn.className = 'py-1.5 px-3 rounded-lg bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 font-semibold text-xs transition flex items-center gap-1';
      restartBtn.disabled = true; restartBtn.className = disabledCls;
      stopBtn.disabled = true; stopBtn.className = disabledCls;
      killBtn.disabled = true; killBtn.className = killDisabledCls;
      if (cmdInput) { cmdInput.disabled = true; cmdInput.placeholder = 'Server is offline'; }
      if (cmdSendBtn) cmdSendBtn.disabled = true;
    }
  }

  // ── Power Actions ──
  async function sendPowerAction(e, action) {
    if (e) e.preventDefault();
    if (action === 'start') updatePowerButtonsState('starting');
    else if (action === 'stop') updatePowerButtonsState('stopping');

    try {
      const res = await fetch(`/dashboard/server/${SERVER_UUID}/power`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
        body: JSON.stringify({ action, _csrf: CSRF_TOKEN })
      });
      const data = await res.json();
      if (data.status) updatePowerButtonsState(data.status);
      if (!data.success) {
        appendConsoleLine('[System] ' + (data.message || 'Power action failed.'), 'system');
      }
    } catch (err) {
      appendConsoleLine('[System] Network error during power action.', 'system');
    }
  }

  // ── Command Form ──
  let cmdHistory = JSON.parse(sessionStorage.getItem('kgp_cmd_history') || '[]');
  let cmdHistoryIdx = -1;

  document.getElementById('commandForm').addEventListener('submit', function(e) {
    e.preventDefault();
    const input = document.getElementById('cmdInput');
    const cmd = input.value.trim();
    if (!cmd) return;

    cmdHistory.unshift(cmd);
    if (cmdHistory.length > 30) cmdHistory.pop();
    sessionStorage.setItem('kgp_cmd_history', JSON.stringify(cmdHistory));
    cmdHistoryIdx = -1;

    fetch(`/dashboard/server/${SERVER_UUID}/command`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'X-CSRF-Token': CSRF_TOKEN },
      body: JSON.stringify({ command: cmd, _csrf: CSRF_TOKEN })
    }).then(res => {
      if (!res.ok) return res.json().catch(() => ({ success: false, message: 'Request failed (HTTP ' + res.status + ').' }));
      return res.json();
    }).then(data => {
      if (!data.success) {
        appendConsoleLine('[System] Failed to send command: ' + (data.message || 'Server may be offline.'), 'system');
        showToast(data.message || 'Failed to send command');
      }
    }).catch(() => {
      appendConsoleLine('[System] Network error sending command.', 'system');
      showToast('Network error sending command');
    });

    input.value = '';
  });

  document.getElementById('cmdInput').addEventListener('keydown', function(e) {
    if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (cmdHistory.length > 0 && cmdHistoryIdx < cmdHistory.length - 1) {
        cmdHistoryIdx++;
        this.value = cmdHistory[cmdHistoryIdx];
      }
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (cmdHistoryIdx > 0) {
        cmdHistoryIdx--;
        this.value = cmdHistory[cmdHistoryIdx];
      } else {
        cmdHistoryIdx = -1;
        this.value = '';
      }
    }
  });

  // ── Metrics Renderer (Update 5 Sidebar Cards dynamically) ──
  function renderMetrics(m) {
    if (!m) return;

    // Address
    if (m.address) {
      document.getElementById('cardAddressText').innerText = m.address;
    }

    // Status
    if (m.status) {
      const statusBadge = document.getElementById('cardStatusBadge');
      statusBadge.innerText = m.status;
      if (m.status === 'online') statusBadge.className = 'text-lg font-bold uppercase tracking-wide text-emerald-400';
      else if (m.status === 'offline') statusBadge.className = 'text-lg font-bold uppercase tracking-wide text-red-400';
      else if (['installing', 'downloading', 'configuring'].includes(m.status)) statusBadge.className = 'text-lg font-bold uppercase tracking-wide text-purple-400';
      else statusBadge.className = 'text-lg font-bold uppercase tracking-wide text-amber-400';
      
      updatePowerButtonsState(m.status);
    }

    // RAM
    const ramText = document.getElementById('cardRamText');
    const ramBar = document.getElementById('cardRamBar');
    if (m.memory && m.memory.usedBytes !== null) {
      const pctStr = m.memory.percent !== null ? m.memory.percent + '%' : '0%';
      ramText.innerText = `${pctStr} (${formatBytes(m.memory.usedBytes)} / ${formatBytes(m.memory.limitBytes)})`;
      if (ramBar) ramBar.style.width = (m.memory.percent || 0) + '%';
    } else {
      ramText.innerText = 'Unavailable';
      if (ramBar) ramBar.style.width = '0%';
    }

    // CPU
    const cpuText = document.getElementById('cardCpuText');
    const cpuBar = document.getElementById('cardCpuBar');
    if (m.cpu && m.cpu.percent !== null) {
      cpuText.innerText = `${m.cpu.percent}% of ${m.cpu.cores.toFixed(1)} cores`;
      if (cpuBar) cpuBar.style.width = Math.min(100, m.cpu.percent) + '%';
    } else {
      cpuText.innerText = 'Unavailable';
      if (cpuBar) cpuBar.style.width = '0%';
    }

    // Disk
    const diskText = document.getElementById('cardDiskText');
    const diskBar = document.getElementById('cardDiskBar');
    if (m.disk && m.disk.usedBytes !== null) {
      const limitStr = m.disk.limitBytes ? formatBytes(m.disk.limitBytes) : 'No Limit';
      const pctStr = m.disk.percent !== null ? m.disk.percent + '%' : '';
      diskText.innerText = `${pctStr} (${formatBytes(m.disk.usedBytes)} / ${limitStr})`;
      if (diskBar) diskBar.style.width = (m.disk.percent || 0) + '%';
    } else {
      diskText.innerText = 'Unavailable';
      if (diskBar) diskBar.style.width = '0%';
    }
  }

  // ── SSE Connection ──
  let eventSource = null;

  function connectSSE() {
    if (eventSource) {
      eventSource.close();
    }

    eventSource = new EventSource(`/dashboard/server/${SERVER_UUID}/sse`);

    eventSource.addEventListener('open', () => {
      setConnectionStatus('connected');
    });

    eventSource.addEventListener('log', function(e) {
      const data = JSON.parse(e.data);
      if (data.message) {
        const eventId = data.id || 0;
        if (eventId > 0) {
          if (seenEventIds.has(eventId)) return;
          seenEventIds.add(eventId);
          if (seenEventIds.size > 5000) {
            const arr = Array.from(seenEventIds);
            seenEventIds = new Set(arr.slice(-3000));
          }
        }
        appendConsoleLine(data.message, data.type || 'stdout');
      }
    });

    eventSource.addEventListener('status', function(e) {
      const data = JSON.parse(e.data);
      if (data && data.status) {
        updatePowerButtonsState(data.status);
      }
    });

    eventSource.addEventListener('progress', function(e) {
      const p = JSON.parse(e.data);
      const installerSec = document.getElementById('installerSection');

      if (p.step === 'ready') {
        if (installerSec) installerSec.classList.add('hidden');
        location.reload();
        return;
      }

      if (installerSec) installerSec.classList.remove('hidden');

      if (p.percent !== undefined) {
        document.getElementById('installProgressBar').style.width = p.percent + '%';
      }
      if (p.downloaded && p.total) {
        document.getElementById('installBytesText').innerText = p.downloaded + ' / ' + p.total;
      }
      if (p.speed) {
        document.getElementById('installProgressSpeed').innerText = p.speed;
      }
    });

    eventSource.addEventListener('metrics', function(e) {
      const m = JSON.parse(e.data);
      renderMetrics(m);
    });

    eventSource.addEventListener('error', () => {
      if (eventSource.readyState === EventSource.CONNECTING) {
        setConnectionStatus('reconnecting');
      } else if (eventSource.readyState === EventSource.CLOSED) {
        setConnectionStatus('disconnected');
        setTimeout(connectSSE, 5000);
      }
    });
  }

  function setConnectionStatus(state) {
    const dot = document.getElementById('connectionDot');
    const text = document.getElementById('connectionText');
    if (state === 'connected') {
      dot.className = 'w-2 h-2 rounded-full bg-emerald-400 ml-2';
      text.className = 'text-[11px] text-emerald-400/80 font-mono';
      text.innerText = 'Connected';
    } else if (state === 'reconnecting') {
      dot.className = 'w-2 h-2 rounded-full bg-amber-400 animate-pulse ml-2';
      text.className = 'text-[11px] text-amber-400/80 font-mono';
      text.innerText = 'Reconnecting...';
    } else {
      dot.className = 'w-2 h-2 rounded-full bg-red-500 ml-2';
      text.className = 'text-[11px] text-red-400/80 font-mono';
      text.innerText = 'Disconnected';
    }
  }

  // Initialize SSE connection
  connectSSE();
</script>

