<%- include('../layouts/header', { title: title }) %>

<div class="min-h-screen bg-[#0a0b0c] flex flex-col lg:flex-row">
  <%- include('../components/sidebar') %>

  <main class="flex-1 lg:pl-60 pt-14 lg:pt-0 pb-20 lg:pb-10 min-h-screen flex flex-col">
    <!-- Top Bar / Breadcrumb Navigation -->
    <header class="h-14 px-6 lg:px-8 border-b border-white/5 flex items-center justify-between bg-[#0a0b0c]/90 sticky top-0 z-20">
      <div class="flex items-center gap-2 text-xs sm:text-sm text-neutral-400">
        <span class="text-white font-medium"><%= server.name %></span>
        <span>/</span>
        <span class="text-[#1873d3] font-medium">Plugins</span>
      </div>

      <div class="flex items-center gap-3">
        <span class="px-3 py-1 rounded-full bg-[#1873d3]/10 border border-[#1873d3]/20 text-[#1873d3] text-xs font-semibold">
          <%= server.software %> <%= server.version || '' %>
        </span>
        <a href="https://modrinth.com" target="_blank" rel="noopener noreferrer" class="text-xs text-neutral-400 hover:text-white transition-colors">
          Powered by Modrinth
        </a>
      </div>
    </header>

    <div class="p-6 lg:p-8 max-w-[1400px] w-full mx-auto space-y-6 flex-1">
      <!-- HEADER BANNER & TAB NAVIGATION -->
      <div class="kgp-card p-6 bg-[#121416] space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-[#1873d3]/10 border border-[#1873d3]/20 text-[#1873d3] flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 00-2 2v2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v2a2 2 0 002 2h6a2 2 0 002-2v-2h2a2 2 0 002-2V10a2 2 0 00-2-2h-2V6a2 2 0 00-2-2h-6z"/></svg>
            </div>
            <div>
              <h1 class="text-xl sm:text-2xl font-bold text-white tracking-tight">Plugin Management</h1>
              <p class="text-xs text-neutral-400">Discover popular plugins and manage installed Bukkit/Paper server extensions.</p>
            </div>
          </div>

          <% if (isSupported) { %>
            <div class="flex items-center gap-2">
              <span class="px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                <span>Plugins Enabled</span>
              </span>
            </div>
          <% } %>
        </div>

        <% if (isSupported) { %>
          <!-- 2 TABS NAVIGATION BAR -->
          <div class="flex border-b border-white/5 pt-2 gap-6 text-sm font-medium">
            <button id="tabExploreBtn" onclick="switchTab('explore')" class="pb-3 border-b-2 border-[#1873d3] text-white flex items-center gap-2 transition-all">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              <span>Explore Plugins</span>
            </button>
            <button id="tabInstalledBtn" onclick="switchTab('installed')" class="pb-3 border-b-2 border-transparent text-neutral-400 hover:text-white flex items-center gap-2 transition-all">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Installed Plugins</span>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-white/10 text-white" id="tabInstalledCount">
                <%= installedPlugins.length %>
              </span>
            </button>
          </div>
        <% } %>
      </div>

      <% if (!isSupported) { %>
        <!-- UNSUPPORTED SOFTWARE NOTICE -->
        <div class="kgp-card p-8 text-center space-y-4">
          <div class="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center mx-auto">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          </div>
          <div class="max-w-md mx-auto space-y-1">
            <h3 class="text-base font-bold text-white">Plugin Installation Unavailable</h3>
            <p class="text-xs text-neutral-400">
              Plugin installation is disabled because this server software (<strong class="text-white"><%= server.software %></strong>) does not support Bukkit-family plugins.
            </p>
          </div>
          <p class="text-xs text-neutral-500">
            Bukkit-compatible software includes: <span class="text-neutral-300">Paper, Purpur, Spigot, and Bukkit</span>.
          </p>
        </div>
      <% } else { %>

        <!-- TAB 1: EXPLORE PLUGINS -->
        <div id="exploreTabContent" class="space-y-6">
          <!-- SEARCH & SORT CONTROLS -->
          <div class="kgp-card p-5 space-y-4">
            <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
              <!-- Search Bar -->
              <div class="relative flex-1 w-full">
                <input type="text" id="searchInput" placeholder="Search Bukkit/Paper plugins (e.g. WorldEdit, Vault, LuckPerms)..." class="kgp-input w-full pl-9 pr-4 py-2 text-xs">
                <svg class="w-4 h-4 text-neutral-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              </div>

              <!-- Sort & Filter Dropdown -->
              <div class="flex items-center gap-3 w-full sm:w-auto">
                <span class="text-xs text-neutral-400 flex-shrink-0">Sort By:</span>
                <select id="sortSelect" onchange="triggerSearch(0)" class="kgp-input text-xs py-2 px-3 rounded-lg bg-[#0d0e0f]">
                  <option value="downloads" selected>Popular (Most Downloads)</option>
                  <option value="relevance">Relevance</option>
                  <option value="updated">Recently Updated</option>
                  <option value="newest">Newest Released</option>
                </select>
              </div>
            </div>

            <!-- Loading Spinner -->
            <div id="searchStatus" class="text-xs text-neutral-400 hidden flex items-center gap-2 py-1">
              <span class="w-3 h-3 rounded-full border-2 border-[#1873d3] border-t-transparent animate-spin"></span>
              <span>Fetching Modrinth plugins...</span>
            </div>
          </div>

          <!-- PLUGINS GRID (12 per page) -->
          <div id="exploreGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 min-h-[400px]">
            <!-- Dynamic JS Cards -->
          </div>

          <!-- PAGINATION FOOTER -->
          <div id="paginationBar" class="kgp-card p-4 flex items-center justify-between text-xs text-neutral-400 hidden">
            <button id="prevPageBtn" onclick="changePage(-1)" class="btn-secondary text-xs px-3 py-1.5 disabled:opacity-40" disabled>&larr; Previous</button>
            <span id="pageIndicator" class="font-mono text-neutral-300">Page 1</span>
            <button id="nextPageBtn" onclick="changePage(1)" class="btn-secondary text-xs px-3 py-1.5">Next &rarr;</button>
          </div>
        </div>

        <!-- TAB 2: INSTALLED PLUGINS -->
        <div id="installedTabContent" class="space-y-6 hidden">
          <div class="kgp-card p-6 space-y-4">
            <div class="flex items-center justify-between border-b border-white/5 pb-3">
              <div>
                <h2 class="text-base font-bold text-white">Installed Plugin Files</h2>
                <p class="text-xs text-neutral-400 mt-0.5">Files active on disk in <code class="text-neutral-300 font-mono">/plugins/</code>.</p>
              </div>
              <button onclick="refreshInstalledList()" class="btn-secondary text-xs px-3 py-1.5 flex items-center gap-2">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                <span>Refresh Disk</span>
              </button>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="installedList">
              <% if (installedPlugins.length === 0) { %>
                <div class="col-span-full py-12 text-center text-neutral-500 text-xs" id="noPluginsMsg">
                  No plugin JAR files installed on disk yet. Switch to the <strong class="text-neutral-300">Explore Plugins</strong> tab to discover and install plugins.
                </div>
              <% } else { %>
                <% installedPlugins.forEach(function(plugin) { %>
                  <div class="p-4 rounded-xl bg-[#0d0e0f] border border-white/5 flex items-center justify-between gap-4 group" id="item-<%= plugin.filename %>">
                    <div class="flex items-center gap-3 min-w-0">
                      <div class="w-10 h-10 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center flex-shrink-0">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                      </div>
                      <div class="truncate">
                        <p class="font-bold text-white truncate font-mono text-sm"><%= plugin.filename %></p>
                        <p class="text-xs text-neutral-400 mt-0.5"><%= plugin.formattedSize %> • Modified <%= plugin.modified %></p>
                      </div>
                    </div>
                    <button onclick="confirmDelete('<%= plugin.filename %>')" title="Delete plugin JAR" class="btn-danger text-xs px-3 py-1.5 flex-shrink-0">
                      Delete
                    </button>
                  </div>
                <% }); %>
              <% } %>
            </div>
          </div>
        </div>

      <% } %>

    </div>
  </main>
</div>

<!-- CSRF Token Hidden Holder -->
<input type="hidden" id="csrfToken" value="<%= csrfToken %>">
<input type="hidden" id="serverUuid" value="<%= server.uuid %>">

<%- include('../layouts/footer', { script: null }) %>

<script>
const serverUuid = document.getElementById('serverUuid').value;
const csrfToken = document.getElementById('csrfToken').value;

let currentPage = 0;
const PAGE_SIZE = 12;
let totalHits = 0;
let searchTimeout = null;

// Tab Switcher Logic
function switchTab(tab) {
  const exploreTab = document.getElementById('exploreTabContent');
  const installedTab = document.getElementById('installedTabContent');
  const exploreBtn = document.getElementById('tabExploreBtn');
  const installedBtn = document.getElementById('tabInstalledBtn');

  if (tab === 'explore') {
    exploreTab.classList.remove('hidden');
    installedTab.classList.add('hidden');
    exploreBtn.className = 'pb-3 border-b-2 border-[#1873d3] text-white flex items-center gap-2 transition-all';
    installedBtn.className = 'pb-3 border-b-2 border-transparent text-neutral-400 hover:text-white flex items-center gap-2 transition-all';
  } else {
    exploreTab.classList.add('hidden');
    installedTab.classList.remove('hidden');
    exploreBtn.className = 'pb-3 border-b-2 border-transparent text-neutral-400 hover:text-white flex items-center gap-2 transition-all';
    installedBtn.className = 'pb-3 border-b-2 border-[#1873d3] text-white flex items-center gap-2 transition-all';
    refreshInstalledList();
  }
}

document.getElementById('searchInput')?.addEventListener('input', () => {
  clearTimeout(searchTimeout);
  searchTimeout = setTimeout(() => {
    triggerSearch(0);
  }, 400);
});

async function triggerSearch(page = 0) {
  currentPage = page;
  const query = document.getElementById('searchInput').value.trim();
  const sort = document.getElementById('sortSelect').value;
  const statusEl = document.getElementById('searchStatus');
  const gridEl = document.getElementById('exploreGrid');
  const paginationBar = document.getElementById('paginationBar');

  statusEl.classList.remove('hidden');
  const offset = currentPage * PAGE_SIZE;

  try {
    const res = await fetch(`/dashboard/server/${serverUuid}/plugins/api/search?q=${encodeURIComponent(query)}&offset=${offset}&limit=${PAGE_SIZE}&index=${sort}`);
    const data = await res.json();
    statusEl.classList.add('hidden');

    if (!data.success) {
      gridEl.innerHTML = `<div class="col-span-full py-12 text-center text-xs text-red-400">${data.message || 'Failed to fetch plugins.'}</div>`;
      paginationBar.classList.add('hidden');
      return;
    }

    totalHits = data.total_hits || 0;

    if (!data.hits || data.hits.length === 0) {
      gridEl.innerHTML = '<div class="col-span-full py-12 text-center text-xs text-neutral-500">No compatible Bukkit/Paper plugins found matching query.</div>';
      paginationBar.classList.add('hidden');
      return;
    }

    renderExploreGrid(data.hits);
    updatePaginationControls();
  } catch (err) {
    statusEl.classList.add('hidden');
    gridEl.innerHTML = '<div class="col-span-full py-12 text-center text-xs text-red-400">Failed to connect to Modrinth API.</div>';
    paginationBar.classList.add('hidden');
  }
}

function renderExploreGrid(hits) {
  const gridEl = document.getElementById('exploreGrid');
  gridEl.innerHTML = hits.map(hit => {
    const iconUrl = hit.icon_url || '/images/products_img/mc.webp';
    const downloadsStr = hit.downloads ? hit.downloads.toLocaleString() : '0';
    const categories = (hit.categories || []).slice(0, 3).join(', ');
    
    return `
      <div class="kgp-card p-5 flex flex-col justify-between space-y-4">
        <div class="space-y-3">
          <div class="flex items-start justify-between gap-3">
            <div class="flex items-center gap-3 min-w-0">
              <img src="${iconUrl}" onerror="this.onerror=null; this.src='/images/products_img/mc.webp'" class="w-10 h-10 rounded-lg border border-white/10 object-cover flex-shrink-0">
              <div class="min-w-0">
                <h3 class="text-sm font-bold text-white truncate leading-tight">${hit.title}</h3>
                <p class="text-[11px] text-neutral-400 mt-0.5 truncate">by ${hit.author}</p>
              </div>
            </div>
          </div>

          <p class="text-xs text-neutral-400 leading-relaxed line-clamp-2 min-h-[32px]">${hit.description || 'No description available.'}</p>
        </div>

        <div class="pt-3 border-t border-white/5 space-y-3">
          <div class="flex items-center justify-between text-[11px] text-neutral-400">
            <span>📥 ${downloadsStr} downloads</span>
            <span class="px-2 py-0.5 rounded bg-white/5 text-neutral-300 font-mono">${categories || 'Bukkit'}</span>
          </div>

          <button onclick="installPlugin('${hit.project_id}', '${hit.title.replace(/'/g, "\\'")}', this)" class="w-full btn-kinetic text-xs justify-center py-2">
            Install Plugin
          </button>
        </div>
      </div>
    `;
  }).join('');
}

function updatePaginationControls() {
  const paginationBar = document.getElementById('paginationBar');
  const prevBtn = document.getElementById('prevPageBtn');
  const nextBtn = document.getElementById('nextPageBtn');
  const indicator = document.getElementById('pageIndicator');

  const maxPages = Math.ceil(totalHits / PAGE_SIZE) || 1;
  indicator.innerText = `Page ${currentPage + 1} of ${maxPages}`;

  prevBtn.disabled = currentPage === 0;
  nextBtn.disabled = (currentPage + 1) >= maxPages;

  paginationBar.classList.remove('hidden');
}

function changePage(delta) {
  triggerSearch(currentPage + delta);
}

async function installPlugin(projectId, title, btnEl) {
  const originalText = btnEl.innerText;
  btnEl.disabled = true;
  btnEl.innerText = 'Downloading...';

  try {
    const res = await fetch(`/dashboard/server/${serverUuid}/plugins/api/install`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': csrfToken
      },
      body: JSON.stringify({ projectId, _csrf: csrfToken })
    });

    const data = await res.json();

    if (!data.success) {
      alert(`Installation Failed: ${data.message}`);
      btnEl.disabled = false;
      btnEl.innerText = originalText;
      return;
    }

    btnEl.innerText = 'Installed!';
    btnEl.classList.remove('btn-kinetic');
    btnEl.classList.add('bg-emerald-500/20', 'text-emerald-400', 'border', 'border-emerald-500/40');

    if (data.requiresRestart) {
      alert(`Plugin "${data.filename}" (${data.version}) installed successfully to disk!\n\nNote: Server is currently online. Restart the server to load the new plugin into Minecraft.`);
    } else {
      alert(`Plugin "${data.filename}" (${data.version}) installed successfully!`);
    }

    refreshInstalledList();
  } catch (err) {
    alert('Installation request failed. Please check network connection.');
    btnEl.disabled = false;
    btnEl.innerText = originalText;
  }
}

async function confirmDelete(filename) {
  if (!confirm(`Are you sure you want to delete plugin file "${filename}" from disk?`)) {
    return;
  }

  try {
    const res = await fetch(`/dashboard/server/${serverUuid}/plugins/api/delete`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': csrfToken
      },
      body: JSON.stringify({ filename, _csrf: csrfToken })
    });

    const data = await res.json();

    if (!data.success) {
      alert(`Delete Failed: ${data.message}`);
      return;
    }

    refreshInstalledList();
  } catch (err) {
    alert('Failed to delete plugin file.');
  }
}

async function refreshInstalledList() {
  try {
    const res = await fetch(`/dashboard/server/${serverUuid}/plugins/api/installed`);
    const data = await res.json();

    if (data.success && data.installedPlugins) {
      const countEl = document.getElementById('tabInstalledCount');
      const listEl = document.getElementById('installedList');

      if (countEl) countEl.innerText = data.installedPlugins.length;

      if (data.installedPlugins.length === 0) {
        listEl.innerHTML = '<div class="col-span-full py-12 text-center text-neutral-500 text-xs">No plugin JAR files installed on disk yet. Switch to the <strong class="text-neutral-300">Explore Plugins</strong> tab to discover and install plugins.</div>';
      } else {
        listEl.innerHTML = data.installedPlugins.map(p => `
          <div class="p-4 rounded-xl bg-[#0d0e0f] border border-white/5 flex items-center justify-between gap-4 group" id="item-${p.filename}">
            <div class="flex items-center gap-3 min-w-0">
              <div class="w-10 h-10 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div class="truncate">
                <p class="font-bold text-white truncate font-mono text-sm">${p.filename}</p>
                <p class="text-xs text-neutral-400 mt-0.5">${p.formattedSize} • Modified ${p.modified}</p>
              </div>
            </div>
            <button onclick="confirmDelete('${p.filename}')" title="Delete plugin JAR" class="btn-danger text-xs px-3.5 py-1.5 flex-shrink-0">
              Delete
            </button>
          </div>
        `).join('');
      }
    }
  } catch (e) {
    // Ignore refresh errors
  }
}

// Initial Load: Fetch Popular Plugins on Page Load
document.addEventListener('DOMContentLoaded', () => {
  triggerSearch(0);
});
</script>
