<%- include('../layouts/header', { title: title }) %>

<div class="min-h-screen bg-[#0D1117] flex flex-col lg:flex-row">
  <%- include('../components/sidebar') %>

  <main class="flex-1 lg:pl-60 pt-14 lg:pt-0 pb-20 lg:pb-10 min-h-screen flex flex-col">
    <!-- Top Bar / Breadcrumb Navigation -->
    <header class="h-14 px-6 lg:px-8 border-b border-[#30363D] flex items-center justify-between bg-[#0D1117]/90 sticky top-0 z-20">
      <div class="flex items-center gap-2 text-xs sm:text-sm text-[#8B949E]">
        <span class="text-white font-medium">Servers</span>
        <span>/</span>
        <span class="text-[#2F81F7] font-medium"><%= server.name %></span>
        <span>/</span>
        <span class="text-neutral-300">Settings</span>
      </div>

      <div class="flex items-center gap-2">
        <button form="serverSettingsForm" type="submit" class="btn-kinetic text-xs flex items-center gap-1.5 py-1.5 px-3">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          Save Settings
        </button>
      </div>
    </header>

    <div class="p-6 lg:p-10 max-w-[1400px] w-full mx-auto space-y-8 flex-1">
      <!-- ALERT MESSAGES -->
      <% if (typeof msg !== 'undefined' && msg) { %>
        <div class="p-4 rounded-xl bg-[#3FB950]/10 border border-[#3FB950]/30 text-[#3FB950] text-sm flex items-center justify-between">
          <span>
            <% if (msg === 'settings_saved') { %> Server configuration saved successfully. <% } %>
            <% if (msg === 'reinstalling') { %> Server Jar reinstallation started in background! <% } %>
          </span>
          <button onclick="this.parentElement.remove()" class="text-[#3FB950] hover:text-white">&times;</button>
        </div>
      <% } %>

      <!-- HEADER TITLE -->
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white">Server Settings & Startup</h1>
        <p class="text-[#8B949E] text-sm mt-1">Configure startup parameters, memory allocation, command lines, and server jar reinstallation.</p>
      </div>

      <!-- SETTINGS FORM -->
      <form id="serverSettingsForm" method="POST" action="/dashboard/server/<%= server.uuid %>/settings/save" class="space-y-8">
        <input type="hidden" name="_csrf" value="<%= _csrf %>">

        <!-- GENERAL SETTINGS -->
        <div class="kgp-card p-6 sm:p-8 space-y-6">
          <h2 class="text-lg font-bold text-white border-b border-[#30363D] pb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-[#2F81F7]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            General Details
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs">
            <div>
              <label class="block font-semibold text-[#8B949E] mb-1">Server Name</label>
              <input type="text" name="name" value="<%= server.name %>" required class="w-full px-3.5 py-2.5 rounded-xl bg-[#21262D] border border-[#30363D] text-sm text-white focus:outline-none focus:border-[#2F81F7]">
            </div>

            <div>
              <label class="block font-semibold text-[#8B949E] mb-1">RAM Memory Limit (MB)</label>
              <input type="number" name="ram_limit" value="<%= server.ram_limit %>" required class="w-full px-3.5 py-2.5 rounded-xl bg-[#21262D] border border-[#30363D] text-sm text-white focus:outline-none focus:border-[#2F81F7]">
            </div>

            <div class="md:col-span-2">
              <label class="block font-semibold text-[#8B949E] mb-1">Description</label>
              <input type="text" name="description" value="<%= server.description %>" class="w-full px-3.5 py-2.5 rounded-xl bg-[#21262D] border border-[#30363D] text-sm text-white focus:outline-none focus:border-[#2F81F7]">
            </div>
          </div>
        </div>

        <!-- STARTUP COMMAND & JVM -->
        <div class="kgp-card p-6 sm:p-8 space-y-6">
          <h2 class="text-lg font-bold text-white border-b border-[#30363D] pb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-[#3FB950]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            Startup Command & Arguments
          </h2>

          <div class="space-y-4 text-xs">
            <div>
              <label class="block font-semibold text-[#8B949E] mb-1">JVM Startup Command</label>
              <input type="text" name="startup_command" value="<%= server.startup_command %>" class="w-full px-3.5 py-2.5 rounded-xl bg-[#21262D] border border-[#30363D] text-sm font-mono text-[#3FB950] focus:outline-none focus:border-[#2F81F7]">
              <p class="text-[11px] text-[#8B949E] mt-1">Variables `{ram}` and `{jar_file}` will be substituted dynamically at runtime.</p>
            </div>
          </div>
        </div>
      </form>

      <!-- REINSTALL SERVER JAR SECTION -->
      <div class="kgp-card p-6 sm:p-8 space-y-6">
        <h2 class="text-lg font-bold text-white border-b border-[#30363D] pb-4 flex items-center gap-2">
          <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
          Reinstall Server Engine & Version
        </h2>

        <form method="POST" action="/dashboard/server/<%= server.uuid %>/settings/save" class="space-y-4 text-xs">
          <input type="hidden" name="_csrf" value="<%= _csrf %>">
          <input type="hidden" name="action" value="reinstall">

          <p class="text-xs text-[#8B949E]">Reinstalling will download the selected server Jar while preserving your world, configs, and plugins.</p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block font-semibold text-[#8B949E] mb-1">Server Software</label>
              <select id="reinstallSoftware" name="software" class="w-full px-3.5 py-2.5 rounded-xl bg-[#21262D] border border-[#30363D] text-sm text-white">
                <optgroup label="Server Software">
                  <option value="Paper" <%= server.software === 'Paper' ? 'selected' : '' %>>Paper (Recommended)</option>
                  <option value="Purpur" <%= server.software === 'Purpur' ? 'selected' : '' %>>Purpur</option>
                  <option value="Spigot" <%= server.software === 'Spigot' ? 'selected' : '' %>>Spigot</option>
                  <option value="Folia" <%= server.software === 'Folia' ? 'selected' : '' %>>Folia</option>
                  <option value="Vanilla" <%= server.software === 'Vanilla' ? 'selected' : '' %>>Vanilla</option>
                  <option value="Pufferfish" <%= server.software === 'Pufferfish' ? 'selected' : '' %>>Pufferfish</option>
                  <option value="Leaves" <%= server.software === 'Leaves' ? 'selected' : '' %>>Leaves</option>
                  <option value="Canvas" <%= server.software === 'Canvas' ? 'selected' : '' %>>Canvas</option>
                </optgroup>
                <optgroup label="Modded Software">
                  <option value="Fabric" <%= server.software === 'Fabric' ? 'selected' : '' %>>Fabric</option>
                  <option value="Forge" <%= server.software === 'Forge' ? 'selected' : '' %>>Forge</option>
                  <option value="NeoForge" <%= server.software === 'NeoForge' ? 'selected' : '' %>>NeoForge</option>
                  <option value="Quilt" <%= server.software === 'Quilt' ? 'selected' : '' %>>Quilt</option>
                  <option value="Mohist" <%= server.software === 'Mohist' ? 'selected' : '' %>>Mohist</option>
                  <option value="Arclight" <%= server.software === 'Arclight' ? 'selected' : '' %>>Arclight</option>
                  <option value="Sponge" <%= server.software === 'Sponge' ? 'selected' : '' %>>Sponge</option>
                </optgroup>
                <optgroup label="Proxy Software">
                  <option value="Velocity" <%= server.software === 'Velocity' ? 'selected' : '' %>>Velocity</option>
                  <option value="BungeeCord" <%= server.software === 'BungeeCord' ? 'selected' : '' %>>BungeeCord</option>
                  <option value="Waterfall" <%= server.software === 'Waterfall' ? 'selected' : '' %>>Waterfall</option>
                </optgroup>
              </select>
            </div>

            <div>
              <label class="block font-semibold text-[#8B949E] mb-1">Minecraft Version</label>
              <input type="text" id="reinstallVersion" name="version" list="reinstallVersionSuggestions" autocomplete="off"
                value="<%= server.version %>" placeholder="Type a version (e.g. 1.21.4)" required
                class="w-full px-3.5 py-2.5 rounded-xl bg-[#21262D] border border-[#30363D] text-sm text-white focus:outline-none focus:border-[#2F81F7]">
              <datalist id="reinstallVersionSuggestions"></datalist>
              <p id="reinstallHint" class="text-[11px] text-[#8B949E] mt-1">Type or pick a Minecraft version</p>
            </div>
          </div>

          <div class="pt-2 flex justify-end">
            <button type="submit" onclick="return confirm('Reinstall server jar now?')" class="py-2.5 px-6 rounded-xl bg-purple-500 hover:bg-purple-600 text-white font-semibold text-xs shadow-soft-md transition">
              Reinstall Server Engine
            </button>
          </div>
        </form>
      </div>
    </div>
  </main>
</div>

<%- include('../layouts/footer', { script: null }) %>

<script>
(function() {
  const softwareSelect = document.getElementById('reinstallSoftware');
  const versionInput = document.getElementById('reinstallVersion');
  const datalist = document.getElementById('reinstallVersionSuggestions');
  const hint = document.getElementById('reinstallHint');

  let cachedVersions = {};
  let currentVersions = [];
  const initialVersion = '<%= server.version %>';

  async function loadVersions(software, preserveValue) {
    datalist.innerHTML = '';

    if (cachedVersions[software]) {
      applyVersions(cachedVersions[software], preserveValue);
      return;
    }

    try {
      const res = await fetch('/dashboard/server/api/versions/' + encodeURIComponent(software));
      const data = await res.json();
      if (data.success && data.versions.length > 0) {
        cachedVersions[software] = data.versions;
        applyVersions(data.versions, preserveValue);
      } else {
        hint.textContent = 'No versions found. You can still type any version.';
        currentVersions = [];
      }
    } catch (e) {
      hint.textContent = 'Could not reach MCJars API.';
      currentVersions = [];
    }
  }

  function applyVersions(versions, preserveValue) {
    currentVersions = versions;
    datalist.innerHTML = '';

    versions.forEach(function(v) {
      const opt = document.createElement('option');
      const label = v.supported ? ' (Supported)' : '';
      opt.value = v.id;
      opt.textContent = v.id + label + ' — Java ' + v.java;
      datalist.appendChild(opt);
    });

    if (!preserveValue) {
      const latestSupported = versions.find(function(v) { return v.supported; }) || versions[0];
      if (latestSupported) {
        versionInput.value = latestSupported.id;
      }
    }
    hint.textContent = versions.length + ' versions available.';
  }

  versionInput.addEventListener('input', function() {
    const typed = versionInput.value.trim();
    const match = currentVersions.find(function(v) { return v.id === typed; });
    if (match) {
      hint.textContent = match.id + ' — ' + (match.supported ? 'Supported' : 'Unsupported') + ' — Java ' + match.java;
    }
  });

  versionInput.addEventListener('change', function() {
    const typed = versionInput.value.trim();
    const match = currentVersions.find(function(v) { return v.id === typed; });
    if (match) {
      hint.textContent = match.id + ' — ' + (match.supported ? 'Supported' : 'Unsupported') + ' — Java ' + match.java;
    }
  });

  softwareSelect.addEventListener('change', function() {
    loadVersions(softwareSelect.value, false);
  });

  // Initial load — preserve the server's current version
  loadVersions(softwareSelect.value, true);
})();
</script>
