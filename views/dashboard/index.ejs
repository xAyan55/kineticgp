<%- include('../layouts/header', { title: 'Dashboard' }) %>

<div class="min-h-screen bg-[#141414] flex flex-col lg:flex-row">
  <!-- Sidebar Component -->
  <%- include('../components/sidebar') %>

  <!-- Main Content Area -->
  <main class="flex-1 lg:pl-56 pt-16 lg:pt-0 pb-20 lg:pb-12 min-h-screen flex flex-col">
    <!-- Top Bar / Breadcrumb Navigation -->
    <header class="h-16 px-6 lg:px-8 border-b border-white/10 flex items-center justify-between bg-[#141414]/80 backdrop-blur-xl sticky top-0 z-20">
      <div class="flex items-center gap-2 text-xs sm:text-sm text-neutral-400">
        <span class="text-white font-medium">Panel</span>
        <span>/</span>
        <span class="text-white font-semibold">Dashboard</span>
      </div>

      <div class="flex items-center gap-4">
        <div class="al-badge-online">
          <span class="al-dot-online"></span>
          <span>Node Online</span>
        </div>
      </div>
    </header>

    <div class="p-6 lg:p-8 max-w-[1400px] w-full mx-auto space-y-6 flex-1">
      <!-- WELCOME BANNER -->
      <div class="al-card p-6 relative overflow-hidden bg-white/5 border border-white/10">
        <div class="relative z-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div class="flex items-center gap-4">
            <img src="<%= user.avatar || '/images/avatar.png' %>" alt="<%= user.username %> avatar" class="w-12 h-12 rounded-xl border border-white/10 object-cover flex-shrink-0">
            <div>
              <h1 class="al-page-title">Welcome back, <%= user.username %> 👋</h1>
              <p class="al-page-desc">Manage your server instances, telemetry, and system activities.</p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <a href="/dashboard/profile" class="al-btn-secondary">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <span>Account Settings</span>
            </a>
          </div>
        </div>
      </div>

      <!-- QUICK STATS CARDS -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Stat 1: Servers -->
        <div class="al-card p-5">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-medium text-neutral-400">Server Instances</span>
            <div class="w-8 h-8 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-white">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2"/></svg>
            </div>
          </div>
          <div class="text-2xl font-semibold text-white tracking-tight mb-1"><%= stats.onlineServers %> / <%= stats.totalServers %></div>
          <p class="text-[11px] text-emerald-400 font-medium">Active Instances</p>
        </div>

        <!-- Stat 2: Active Players -->
        <div class="al-card p-5">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-medium text-neutral-400">Total Players</span>
            <div class="w-8 h-8 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-purple-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
            </div>
          </div>
          <div class="text-2xl font-semibold text-white tracking-tight mb-1"><%= stats.totalPlayers %></div>
          <p class="text-[11px] text-purple-400 font-medium">Connected Across Worlds</p>
        </div>

        <!-- Stat 3: Memory -->
        <div class="al-card p-5">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-medium text-neutral-400">RAM Allocated</span>
            <div class="w-8 h-8 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-emerald-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/></svg>
            </div>
          </div>
          <div class="text-2xl font-semibold text-white tracking-tight mb-1"><%= stats.totalMemoryUsed %> <span class="text-sm text-neutral-400 font-normal">/ <%= stats.totalMemoryAllocated %> GB</span></div>
          <p class="text-[11px] text-emerald-400 font-medium">Memory Allocation</p>
        </div>

        <!-- Stat 4: CPU -->
        <div class="al-card p-5">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-medium text-neutral-400">Avg CPU Load</span>
            <div class="w-8 h-8 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-blue-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
          </div>
          <div class="text-2xl font-semibold text-white tracking-tight mb-1"><%= stats.avgCpu %>%</div>
          <p class="text-[11px] text-blue-400 font-medium">Processor Load</p>
        </div>
      </div>

      <!-- SERVER OVERVIEW CARDS -->
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="al-section-title">Your Server Instances</h2>
            <p class="text-xs text-neutral-400 mt-0.5"><%= servers.length %> instance<%= servers.length === 1 ? '' : 's' %> assigned</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <% if (servers.length === 0) { %>
            <div class="al-card p-8 col-span-full flex flex-col items-center justify-center text-center space-y-3">
              <div class="w-12 h-12 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-white">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
              </div>
              <div>
                <h3 class="text-base font-semibold text-white">No Servers Assigned</h3>
                <p class="text-xs text-neutral-400 mt-1">An administrator can provision a server for your account in the Admin Panel.</p>
              </div>
            </div>
          <% } else { %>
          <% servers.forEach(function(server) { %>
            <div class="al-card overflow-hidden flex flex-col justify-between hover:border-white/20 transition-all duration-150 group">
              <!-- Server Card Header -->
              <div class="p-5 bg-white/5 border-b border-white/10 flex items-center justify-between gap-3">
                <div class="flex items-center gap-3 min-w-0">
                  <div class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-white flex-shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2"/></svg>
                  </div>
                  <div class="min-w-0">
                    <a href="/dashboard/server/<%= server.uuid %>/console" class="text-sm font-semibold text-white hover:underline truncate block">
                      <%= server.name %>
                    </a>
                    <p class="text-xs text-neutral-400 mt-0.5 truncate"><%= server.software %> <%= server.version %></p>
                  </div>
                </div>
                <% if (server.status === 'online') { %>
                  <span class="al-badge-online flex-shrink-0">
                    <span class="al-dot-online"></span> Online
                  </span>
                <% } else { %>
                  <span class="al-badge-offline flex-shrink-0">
                    <span class="al-dot-offline"></span> Offline
                  </span>
                <% } %>
              </div>

              <!-- Card Details Content -->
              <div class="p-5 space-y-4 flex-1 flex flex-col justify-between">
                <div class="p-3 rounded-xl bg-white/5 border border-white/10 text-xs space-y-2">
                  <div class="flex justify-between items-center">
                    <span class="text-neutral-400">Address:</span>
                    <span class="font-mono text-white font-medium"><%= server.ip_address || '127.0.0.1' %>:<%= server.port %></span>
                  </div>
                  <div class="flex justify-between items-center">
                    <span class="text-neutral-400">RAM Allocation:</span>
                    <span class="text-white font-medium"><%= (server.ram_limit / 1024).toFixed(1) %> GB</span>
                  </div>
                </div>

                <div class="pt-2 border-t border-white/10">
                  <a href="/dashboard/server/<%= server.uuid %>/console" class="w-full al-btn-primary text-xs justify-center py-2.5">
                    <span>Manage Server</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                  </a>
                </div>
              </div>
            </div>
          <% }); %>
          <% } %>
        </div>
      </div>

      <!-- RECENT ACTIVITY LOGS -->
      <div class="al-card p-6 space-y-4">
        <div class="flex items-center justify-between border-b border-white/10 pb-3">
          <h2 class="al-section-title">Recent Activity Feed</h2>
          <span class="text-xs text-neutral-400">Live Audit Trail</span>
        </div>

        <div class="space-y-2.5">
          <% if (activityLogs.length === 0) { %>
            <div class="flex items-center justify-center p-4 text-xs text-neutral-400">
              <p>No activity recorded yet.</p>
            </div>
          <% } else { %>
          <% activityLogs.forEach(function(log) { %>
            <div class="flex items-start gap-3 p-3.5 rounded-xl bg-white/5 border border-white/10 text-xs">
              <div class="w-7 h-7 rounded-lg bg-white/5 border border-white/10 text-white flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between gap-2">
                  <span class="font-semibold text-white truncate"><%= log.action %></span>
                  <span class="text-[10px] text-neutral-400 flex-shrink-0 font-mono"><%= log.created_at %></span>
                </div>
                <p class="text-xs text-neutral-400 mt-0.5 truncate"><%= log.details %></p>
              </div>
            </div>
          <% }); %>
          <% } %>
        </div>
      </div>

    </div>
  </main>
</div>

<%- include('../layouts/footer', { script: null }) %>
