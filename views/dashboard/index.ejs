<%- include('../layouts/header', { title: 'Dashboard' }) %>

<div class="min-h-screen bg-[#101213] flex flex-col lg:flex-row">
  <!-- Sidebar Component -->
  <%- include('../components/sidebar') %>

  <!-- Main Content Area -->
  <main class="flex-1 lg:pl-56 pt-16 lg:pt-0 pb-20 lg:pb-10 min-h-screen flex flex-col">
    <!-- Top Bar / Breadcrumb Navigation -->
    <header class="h-16 px-6 lg:px-10 border-b border-white/5 flex items-center justify-between bg-[#101213]/80 backdrop-blur-xl sticky top-0 z-20">
      <div class="flex items-center gap-2 text-sm text-neutral-400">
        <span class="text-white font-medium">Panel</span>
        <span>/</span>
        <span class="text-[#1873d3] font-medium">Dashboard</span>
      </div>

      <div class="flex items-center gap-4">
        <div class="flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Node Online</span>
        </div>
      </div>
    </header>

    <div class="p-6 lg:p-10 max-w-[1400px] w-full mx-auto space-y-8 flex-1">
      <!-- WELCOME BANNER -->
      <div class="kgp-card p-6 sm:p-8 relative overflow-hidden bg-gradient-to-r from-[#1a1c1e] to-[#101213]">
        <div class="relative z-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
          <div class="flex items-center gap-5">
            <img src="<%= user.avatar %>" alt="<%= user.username %> avatar" class="w-16 h-16 rounded-2xl border-2 border-[#1873d3] object-cover shadow-soft-md">
            <div>
              <h1 class="text-2xl sm:text-3xl font-extrabold text-white">Welcome back, <%= user.username %> 👋</h1>
              <p class="text-neutral-400 text-sm mt-1">Manage your Minecraft server nodes, telemetry, and system activities.</p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <a href="/dashboard/profile" class="btn-secondary text-xs sm:text-sm">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              Account Settings
            </a>
          </div>
        </div>
      </div>

      <!-- QUICK STATS CARDS -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Stat 1: Servers -->
        <div class="kgp-card p-6">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-semibold uppercase tracking-wider text-neutral-400">Server Instances</span>
            <div class="w-9 h-9 rounded-xl bg-[#1873d3]/10 border border-[#1873d3]/30 flex items-center justify-center text-[#1873d3]">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2"/></svg>
            </div>
          </div>
          <div class="text-3xl font-extrabold text-white mb-1"><%= stats.onlineServers %> / <%= stats.totalServers %></div>
          <p class="text-xs text-emerald-400 font-medium">Active Minecraft Instances</p>
        </div>

        <!-- Stat 2: Active Players -->
        <div class="kgp-card p-6">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-semibold uppercase tracking-wider text-neutral-400">Total Players</span>
            <div class="w-9 h-9 rounded-xl bg-purple-500/10 border border-purple-500/30 flex items-center justify-center text-purple-400">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
            </div>
          </div>
          <div class="text-3xl font-extrabold text-white mb-1"><%= stats.totalPlayers %></div>
          <p class="text-xs text-purple-400 font-medium">Connected Across Worlds</p>
        </div>

        <!-- Stat 3: Memory -->
        <div class="kgp-card p-6">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-semibold uppercase tracking-wider text-neutral-400">RAM Allocated</span>
            <div class="w-9 h-9 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/></svg>
            </div>
          </div>
          <div class="text-3xl font-extrabold text-white mb-1"><%= stats.totalMemoryUsed %> <span class="text-lg text-neutral-400 font-normal">/ <%= stats.totalMemoryAllocated %> GB</span></div>
          <p class="text-xs text-emerald-400 font-medium">Memory Usage</p>
        </div>

        <!-- Stat 4: CPU -->
        <div class="kgp-card p-6">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-semibold uppercase tracking-wider text-neutral-400">Avg CPU Load</span>
            <div class="w-9 h-9 rounded-xl bg-blue-500/10 border border-blue-500/30 flex items-center justify-center text-blue-400">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
          </div>
          <div class="text-3xl font-extrabold text-white mb-1"><%= stats.avgCpu %>%</div>
          <p class="text-xs text-blue-400 font-medium">Processor Load</p>
        </div>
      </div>

      <!-- SERVER OVERVIEW CARDS -->
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-xl font-bold text-white tracking-tight">Your Server Nodes</h2>
          <span class="text-xs text-neutral-400"><%= servers.length %> instances loaded from SQLite</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% if (servers.length === 0) { %>
            <div class="kgp-card p-8 col-span-full flex flex-col items-center justify-center text-center space-y-4">
              <div class="w-16 h-16 rounded-2xl bg-[#1873d3]/10 border border-[#1873d3]/30 flex items-center justify-center text-[#1873d3]">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
              </div>
              <div>
                <h3 class="text-lg font-bold text-white">No Servers Yet</h3>
                <p class="text-sm text-neutral-400 mt-1">Add your first Minecraft server to get started.</p>
              </div>
            </div>
          <% } else { %>
          <% servers.forEach(function(server) { %>
            <div class="kgp-card p-6 flex flex-col justify-between space-y-6">
              <div>
                <!-- Server Header -->
                <div class="flex items-start justify-between mb-4">
                  <div class="flex items-center gap-3">
                    <div class="w-3 h-3 rounded-full <%= server.status === 'online' ? 'bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.6)] animate-pulse' : 'bg-neutral-600' %> flex-shrink-0"></div>
                    <div>
                      <h3 class="text-lg font-bold text-white leading-tight"><%= server.name %></h3>
                      <p class="text-xs text-neutral-400 mt-0.5"><%= server.game %></p>
                    </div>
                  </div>
                  <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold uppercase tracking-wider <%= server.status === 'online' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/30' : 'bg-neutral-800 text-neutral-400 border border-neutral-700' %>">
                    <%= server.status %>
                  </span>
                </div>

                <!-- Connection details -->
                <div class="p-3 rounded-xl bg-[#101213] border border-white/5 text-xs space-y-1 mb-5">
                  <div class="flex justify-between">
                    <span class="text-neutral-500">Address:</span>
                    <span class="font-mono text-white font-medium"><%= server.ip_address %>:<%= server.port %></span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-neutral-500">Players:</span>
                    <span class="text-neutral-300 font-medium"><%= server.players_online %> / <%= server.max_players %></span>
                  </div>
                </div>

                <!-- Resource Gauges -->
                <div class="space-y-3 text-xs">
                  <div>
                    <div class="flex justify-between text-neutral-400 mb-1">
                      <span>CPU Load</span>
                      <span class="font-semibold text-white"><%= server.status === 'online' ? server.cpu_usage + '%' : '0%' %></span>
                    </div>
                    <div class="w-full h-2 rounded-full bg-[#101213] overflow-hidden">
                      <div class="h-full bg-[#1873d3] rounded-full transition-all duration-300" style="width: <%= server.status === 'online' ? server.cpu_usage : 0 %>%"></div>
                    </div>
                  </div>

                  <div>
                    <div class="flex justify-between text-neutral-400 mb-1">
                      <span>Memory (RAM)</span>
                      <span class="font-semibold text-white"><%= server.status === 'online' ? (server.memory_usage / 1024).toFixed(1) : 0 %> / <%= (server.max_memory / 1024).toFixed(0) %> GB</span>
                    </div>
                    <div class="w-full h-2 rounded-full bg-[#101213] overflow-hidden">
                      <div class="h-full bg-emerald-500 rounded-full transition-all duration-300" style="width: <%= server.status === 'online' ? Math.round((server.memory_usage / server.max_memory) * 100) : 0 %>%"></div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Quick Action Buttons -->
              <div class="pt-4 border-t border-white/5 flex items-center gap-2">
                <% if (server.status === 'online') { %>
                  <button class="btn-server-action flex-1 py-2 px-3 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 border border-amber-500/30 text-xs font-semibold transition" data-server-id="<%= server.id %>" data-action="restart">
                    Restart
                  </button>
                  <button class="btn-server-action flex-1 py-2 px-3 rounded-xl bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/30 text-xs font-semibold transition" data-server-id="<%= server.id %>" data-action="stop">
                    Stop
                  </button>
                <% } else { %>
                  <button class="btn-server-action w-full py-2.5 px-3 rounded-xl bg-[#1873d3] hover:bg-[#1462b8] text-white text-xs font-semibold transition shadow-soft-md" data-server-id="<%= server.id %>" data-action="start">
                    Start Server
                  </button>
                <% } %>
              </div>
            </div>
          <% }); %>
          <% } %>
        </div>
      </div>

      <!-- RECENT ACTIVITY LOGS -->
      <div class="kgp-card p-6 sm:p-8 space-y-6">
        <div class="flex items-center justify-between border-b border-white/5 pb-4">
          <h2 class="text-xl font-bold text-white tracking-tight">Recent Activity Feed</h2>
          <span class="text-xs text-neutral-400">Live Audit Logs</span>
        </div>

        <div class="space-y-4">
          <% if (activityLogs.length === 0) { %>
            <div class="flex items-center justify-center p-6 text-sm text-neutral-500">
              <p>No activity recorded yet. Actions like logins, server starts, and config changes will appear here.</p>
            </div>
          <% } else { %>
          <% activityLogs.forEach(function(log) { %>
            <div class="flex items-start gap-4 p-3.5 rounded-xl bg-[#101213] border border-white/5 text-sm">
              <div class="w-8 h-8 rounded-full bg-[#1873d3]/10 border border-[#1873d3]/30 text-[#1873d3] flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between gap-2">
                  <span class="font-semibold text-white truncate"><%= log.action %></span>
                  <span class="text-[11px] text-neutral-500 flex-shrink-0"><%= log.created_at %></span>
                </div>
                <p class="text-xs text-neutral-400 mt-0.5 truncate"><%= log.details %></p>
              </div>
            </div>
          <% }); %>
          <% } %>
        </div>
      </div>

    </div>
  </main>
</div>

<%- include('../layouts/footer', { script: 'dashboard' }) %>
