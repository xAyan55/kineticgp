<!DOCTYPE html>
<html lang="en" class="dark h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#0D1117">
  <% if (typeof csrfToken !== 'undefined') { %>
    <meta name="csrf-token" content="<%= csrfToken %>">
  <% } %>
  <title>KineticGP - <%= typeof title !== 'undefined' ? title : 'Minecraft Server Management' %></title>
  
  <link rel="icon" href="/images/favicon.png" type="image/png">
  <link rel="stylesheet" href="/css/styles.css?v=1.0">
</head>
<body class="bg-[#0D1117] text-[#F0F6FC] font-poppins min-h-full flex flex-col antialiased selection:bg-[#2F81F7] selection:text-white">

  <%- body %>

  <%- include('../components/toast') %>

  <% if (typeof script !== 'undefined') { %>
    <script src="/js/<%= script %>.js?v=1.0" defer></script>
  <% } %>
</body>
</html>
